# Faraday static site — Apache / LiteSpeed (cPanel)

Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Force HTTPS and the bare domain
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://faradayiq.com%{REQUEST_URI} [L,R=301]

  # Folders that hold product pages but are not pages themselves
  RewriteRule ^((?:ar|ku)/)?products/inverters/?$ /$1products/ [L,R=301]
  RewriteRule ^((?:ar|ku)/)?products/storage/?$ /$1products/hybrid/ [L,R=301]

  # Add the trailing slash to directory-style URLs (/about -> /about/)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_URI} !\.[a-zA-Z0-9]{1,5}$
  RewriteCond %{REQUEST_URI} !/$
  RewriteRule ^(.*)$ /$1/ [L,R=301]

  # Old WordPress URLs
  RewriteRule ^about-us/?$ /about/ [L,R=301]
  RewriteRule ^contact-us/?$ /contact/ [L,R=301]
  RewriteRule ^(12kwp-for-apartments|3-6-kwp-for-a-house|1-8-kwp-for-advertising-board|30-kwp-for-a-big-company|50-kwp-for-agriculture-land|3-kwp-for-emergency-power-water-station)/?$ /projects/ [L,R=301]
  RewriteRule ^(blog|category/.*|author/.*|richard-swanson|who-was-michael-faraday|20[0-9]{2}/.*)/?$ / [L,R=301]
  RewriteRule ^wp-(admin|login\.php|content|includes)(/.*)?$ - [G,L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  Header always set Strict-Transport-Security "max-age=31536000"

  <FilesMatch "\.(html|xml|txt|webmanifest)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(png|jpe?g|webp|avif|svg|hdr)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  # Hashed build assets (/_astro/name.HASH.ext) never change
  <FilesMatch "\.[A-Za-z0-9_-]{8}\.(js|css|woff2?|png|jpe?g|webp|avif|svg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml application/xml text/plain image/vnd.radiance
</IfModule>

<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
  AddType font/woff2 .woff2
  # 3D studio reflections (Radiance HDR, /hdr/)
  AddType image/vnd.radiance .hdr
</IfModule>
