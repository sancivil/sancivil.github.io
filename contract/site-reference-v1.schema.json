              "type": "array"
            },
            "instagram": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "linkedin": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "telegram": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "tiktok": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "x": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "youtube": {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          },
          "required": [
            "facebook",
            "instagram",
            "tiktok",
            "youtube",
            "linkedin",
            "telegram",
            "x"
          ],
          "type": "object"
        }
      },
      "required": [
        "linkHosts",
        "mapsHosts",
        "socialHosts"
      ],
      "type": "object"
    },
    "publishId": {
      "anyOf": [
        {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ]
    },
    "routes": {
      "properties": {
        "accessories": {
          "type": "string"
        },
        "battery": {
          "type": "string"
        },
        "family": {
          "type": "string"
        },
        "item": {
          "type": "string"
        },
        "line": {
          "properties": {
            "accessories": {
              "type": "string"
            },
            "hybrid": {
              "type": "string"
            },
            "micro": {
              "type": "string"
            },
            "modules": {
              "type": "string"
            },
            "onGrid": {
              "type": "string"
            }
          },
          "required": [
            "modules",
            "hybrid",
            "onGrid",
            "micro",
            "accessories"
          ],
          "type": "object"
        },
        "localePrefix": {
          "properties": {
            "ar": {
              "type": "string"
            },
            "ckb": {
              "type": "string"
