            "type": "string"
          },
          "pnomAc": {
            "type": "number"
          },
          "type": {
            "enum": [
              "hybrid",
              "on-grid",
              "micro"
            ],
            "type": "string"
          }
        },
        "required": [
          "id",
          "model",
          "type",
          "phase",
          "pnomAc"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "panels": {
      "items": {
        "properties": {
          "bifacial": {
