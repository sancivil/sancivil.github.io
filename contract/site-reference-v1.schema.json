      "type": "string"
    },
    "sitePaths": {
      "items": {
        "properties": {
          "height": {
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991,
            "type": "integer"
          },
          "path": {
            "type": "string"
          },
          "width": {
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991,
            "type": "integer"
          }
        },
        "required": [
          "path",
          "width",
          "height"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "version": {
      "const": 1,
      "type": "number"
    },
    "vocab": {
      "properties": {
        "capacityKeys": {
          "items": {
            "type": "string"
          },
          "type": "array"
