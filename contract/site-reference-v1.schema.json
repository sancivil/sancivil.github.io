            "en": {
              "type": "string"
            }
          },
          "required": [
            "en",
            "ckb",
            "ar"
          ],
          "type": "object"
        },
        "projects": {
          "type": "string"
        },
        "series": {
          "type": "string"
        }
      },
      "required": [
        "localePrefix",
        "series",
        "family",
        "battery",
        "item",
        "accessories",
        "projects",
        "line"
      ],
      "type": "object"
    },
    "schema": {
