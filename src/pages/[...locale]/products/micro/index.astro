---
import Base from '../../../../layouts/Base.astro';
import PageIntro from '../../../../components/products/PageIntro.astro';
import Stats from '../../../../components/products/Stats.astro';
import SectionHead from '../../../../components/products/SectionHead.astro';
import PhaseGroups from '../../../../components/products/PhaseGroups.astro';
import ItemList from '../../../../components/products/ItemList.astro';
import {
  categoryImage,
  extent,
  families,
  groupInverters,
  groupModels,
  groupPower,
  powerParts,
} from '../../../../components/products/data.ts';
import { categoryText, itemsByLine } from '../../../../content/index.ts';
import { localeFromParam, localeParams, localizePath } from '../../../../i18n/config.ts';
import { common } from '../../../../i18n/common.ts';
import { products } from '../../../../i18n/products.ts';

export const getStaticPaths = () => localeParams();
const locale = localeFromParam(Astro.params.locale);
const t = products[locale];
const p = t.microPage;
const nav = common[locale];
const inverters = groupInverters('micro');
const power = groupPower('micro');
const mppt = inverters.length ? (extent(inverters.map((m) => m.numMppt)).map(String) as [string, string]) : null;
const protection = [...new Set(inverters.map((m) => m.protectionClass))].join(' · ');
const modelNames = families.micro.flatMap((f) => f.models).join(', ');
const shown = families.micro.length > 0;
const empty = !shown && itemsByLine('micro').length === 0;
---

<Base title={p.title} description={p.description(modelNames)}>
  <PageIntro
    locale={locale}
    crumbs={[{ label: nav.nav.products, href: '/products/' }, { label: nav.productNav.micro }]}
    eyebrow={p.eyebrow}
    title={nav.productNav.micro}
    lead={categoryText(locale, 'micro')}
    display
  >
    <Stats
      items={[
        ...(power ? [{ label: p.stat.power, ...powerParts(power) }] : []),
        ...(mppt ? [{ label: p.stat.mppt, value: mppt, count: true }] : []),
        ...(protection ? [{ label: p.stat.protection, value: protection }] : []),
      ]}
    />
  </PageIntro>

  {
    shown && (
      <section class="section" aria-labelledby="models-title">
        <div class="container">
          <SectionHead
            id="models-title"
            title={t.inverterPage.modelsTitle}
            meta={t.count.models(groupModels('micro'))}
            image={{ ...categoryImage.micro, alt: t.categoryAlt.micro }}
          />
          <PhaseGroups locale={locale} group="micro" />
        </div>
      </section>
    )
  }

  <ItemList locale={locale} items={itemsByLine('micro')} />

  {
    empty && (
      <section class="section">
        <div class="container prose">
          <p class="lead measure">{t.emptyLine.text}</p>
          <p><a class="btn btn--sun" href={localizePath('/contact/', locale)}>{t.emptyLine.action}</a></p>
        </div>
      </section>
    )
  }
</Base>
