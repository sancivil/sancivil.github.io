---
import Base from '../../../../layouts/Base.astro';
import PageIntro from '../../../../components/products/PageIntro.astro';
import Stats from '../../../../components/products/Stats.astro';
import SectionHead from '../../../../components/products/SectionHead.astro';
import PhaseGroups from '../../../../components/products/PhaseGroups.astro';
import {
  categoryImage,
  extent,
  families,
  groupInverters,
  groupModels,
  groupPower,
  powerParts,
} from '../../../../components/products/data.ts';
import { localeFromParam, localeParams } from '../../../../i18n/config.ts';
import { common } from '../../../../i18n/common.ts';
import { products } from '../../../../i18n/products.ts';
import { catalogText } from '../../../../i18n/catalog-text.ts';

export const getStaticPaths = () => localeParams();
const locale = localeFromParam(Astro.params.locale);
const t = products[locale];
const p = t.microPage;
const nav = common[locale];
const inverters = groupInverters('micro');
const power = powerParts(groupPower('micro'));
const mppt = extent(inverters.map((m) => m.numMppt)).map(String) as [string, string];
const protection = [...new Set(inverters.map((m) => m.protectionClass))].join(' · ');
const modelNames = families.micro.flatMap((f) => f.models).join(', ');
---

<Base title={p.title} description={p.description(modelNames)}>
  <PageIntro
    locale={locale}
    crumbs={[{ label: nav.nav.products, href: '/products/' }, { label: nav.productNav.micro }]}
    eyebrow={p.eyebrow}
    title={nav.productNav.micro}
    lead={catalogText[locale].categories.micro}
    display
  >
    <Stats
      items={[
        { label: p.stat.power, value: power.value, unit: power.unit },
        { label: p.stat.mppt, value: mppt, count: true },
        { label: p.stat.protection, value: protection },
      ]}
    />
  </PageIntro>

  <section class="section" aria-labelledby="models-title">
    <div class="container">
      <SectionHead
        id="models-title"
        title={t.inverterPage.modelsTitle}
        meta={t.count.models(groupModels('micro'))}
        image={{ ...categoryImage.micro, alt: t.categoryAlt.micro }}
      />
      <PhaseGroups locale={locale} group="micro" />
    </div>
  </section>
</Base>
