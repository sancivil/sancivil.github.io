---
import Base from '../../../../layouts/Base.astro';
import PageIntro from '../../../../components/products/PageIntro.astro';
import Stats from '../../../../components/products/Stats.astro';
import ProductWell from '../../../../components/products/ProductWell.astro';
import ItemList from '../../../../components/products/ItemList.astro';
import { accessories, categoryImage, displayName, docInfo, productImage } from '../../../../components/products/data.ts';
import { accessoryGroups, categoryText, itemsByLine } from '../../../../content/index.ts';
import { localeFromParam, localeParams, localizePath } from '../../../../i18n/config.ts';
import { common } from '../../../../i18n/common.ts';
import { products } from '../../../../i18n/products.ts';
import { accessoryText } from '../../../../i18n/catalog-text.ts';

export const getStaticPaths = () => localeParams();
const locale = localeFromParam(Astro.params.locale);
const t = products[locale];
const p = t.accessoriesPage;
const nav = common[locale];

/* Groups in the owner's order; a group with nothing in it is left out. */
const groups = accessoryGroups
  .map((group) => ({ group, list: accessories.filter((a) => a.group === group.key) }))
  .filter(({ list }) => list.length > 0)
  .map(({ group, list }, i) => ({
    id: `group-${i + 1}`,
    name: group.name[locale],
    items: list.map((a) => ({
      a,
      name: displayName(a.name),
      text: accessoryText(locale, a.slug),
      sheet: a.datasheets[0] ? { url: a.datasheets[0].url, ...docInfo(a.datasheets[0]) } : null,
    })),
  }));
const productCount = accessories.length + itemsByLine('accessories').length;
/* Thumbnails come with the owner's photos; their styles are written only then, so pages without photos stay as they were. */
const thumbs = accessories.some((a) => a.photos.length > 0);
const thumbCss =
  '.item__thumb{display:block;width:72px;aspect-ratio:1;margin-bottom:var(--s-2);object-fit:contain;border-radius:var(--r-2);background:var(--paper-2)}';
---

<Base title={p.title} description={p.description}>
  <PageIntro
    locale={locale}
    crumbs={[{ label: nav.nav.products, href: '/products/' }, { label: nav.productNav.accessories }]}
    eyebrow={p.eyebrow}
    title={nav.productNav.accessories}
    lead={categoryText(locale, 'accessories')}
    display
  >
    <Stats
      items={[
        { label: p.stat.products, value: String(productCount), count: true },
        ...(groups.length ? [{ label: p.stat.groups, value: String(groups.length), count: true }] : []),
      ]}
    />
  </PageIntro>

  {
    accessories.length > 0 && (
      <section class="section acc">
        {thumbs && <style is:inline set:html={thumbCss} />}
        <div class="container acc__grid">
          <div class="acc__aside">
            <ProductWell
              image={productImage(categoryImage.accessories.src, categoryImage.accessories.size)}
              alt={t.categoryAlt.accessories}
              label={nav.productNav.accessories}
              sizes="(max-width: 720px) 55vw, (max-width: 900px) 38vw, (max-width: 1440px) 26vw, 364px"
              eager
              priority
              class="acc__well"
            />
            <ul role="list" class="acc__index">
              {
                groups.map((g, i) => (
                  <li>
                    <a href={`#${g.id}`}>
                      <span class="mono">{String(i + 1).padStart(2, '0')}</span>
                      {g.name}
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>

          <div class="acc__groups">
            {
              groups.map((g, i) => (
                <section class="group" aria-labelledby={g.id}>
                  <h2 id={g.id} class="group__title">
                    <span class="group__index mono">{String(i + 1).padStart(2, '0')}</span>
                    {g.name}
                  </h2>
                  <ul role="list" class="group__list">
                    {g.items.map((item) => (
                      <li class="item">
                        <p class="item__code" dir="ltr">
                          {item.a.photos[0] && (
                            <img
                              class="item__thumb"
                              src={item.a.photos[0].src}
                              srcset={item.a.photos[0].srcset ?? undefined}
                              sizes="72px"
                              width={item.a.photos[0].width}
                              height={item.a.photos[0].height}
                              alt={item.a.photos[0].alt[locale] ?? item.name}
                              loading="lazy"
                              decoding="async"
                            />
                          )}
                          {item.name}
                        </p>
                        <div class="item__text">
                          {item.text && <p>{item.text}</p>}
                          {item.a.variants && (
                            <p class="item__variants">
                              <span class="item__label">{p.variants}</span>
                              <span class="mono" dir="ltr">
                                {item.a.variants.join(' · ')}
                              </span>
                            </p>
                          )}
                        </div>
                        {item.sheet && (
                          <a class="item__sheet" href={item.sheet.url} target="_blank" rel="noopener">
                            <span>{t.label.datasheet}</span>
                            <span class="item__meta">
                              PDF{item.sheet.lang && ` · ${t.docLang[item.sheet.lang]}`}
                            </span>
                            <span class="item__arrow" aria-hidden="true">
                              ↗
                            </span>
                            <span class="sr-only">
                              {item.name} {t.newTab}
                            </span>
                          </a>
                        )}
                      </li>
                    ))}
                  </ul>
                </section>
              ))
            }
          </div>
        </div>
      </section>
    )
  }

  <ItemList locale={locale} items={itemsByLine('accessories')} />

  {
    productCount === 0 && (
      <section class="section">
        <div class="container prose">
          <p class="lead measure">{t.emptyLine.text}</p>
          <p><a class="btn btn--sun" href={localizePath('/contact/', locale)}>{t.emptyLine.action}</a></p>
        </div>
      </section>
    )
  }
</Base>

<style>
  .acc__grid {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
    gap: var(--s-8) var(--gap);
    align-items: start;
  }
  .acc__aside {
    position: sticky;
    top: calc(var(--header-h) + var(--s-5));
    display: grid;
    gap: var(--s-5);
  }
  .acc :global(.acc__well) {
    padding: 8%;
  }
  .acc__index {
    border-top: 1px solid var(--line);
  }
  .acc__index a {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    min-height: 44px;
    border-bottom: 1px solid var(--line);
    font-size: 0.9375rem;
    transition: color var(--dur-1) var(--ease);
  }
  .acc__index a:hover {
    color: var(--muted);
  }
  .acc__index .mono {
    font-size: 0.6875rem;
    color: var(--muted);
  }
  .acc__groups {
    display: grid;
    gap: var(--s-9);
  }
  .group {
    scroll-margin-top: calc(var(--header-h) + var(--s-5));
  }
  .group__title {
    display: flex;
    align-items: baseline;
    gap: var(--s-4);
    margin-bottom: var(--s-4);
    font-size: clamp(1.5rem, 1rem + 1.4vw, 2.25rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.15;
  }
  :global([dir='rtl']) .group__title {
    letter-spacing: 0;
    line-height: 1.5;
  }
  .group__index {
    font-size: 0.75rem;
    font-weight: 400;
    letter-spacing: 0;
    color: var(--muted);
  }
  .group__list {
    border-top: 1px solid var(--line-strong);
  }
  .item {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 5fr) minmax(0, 3fr);
    align-items: baseline;
    gap: var(--s-2) var(--gap);
    padding-block: var(--s-4);
    border-bottom: 1px solid var(--line);
  }
  .item__code {
    font-family: var(--font-mono);
    font-size: 0.9375rem;
    font-weight: 500;
    overflow-wrap: anywhere;
    text-align: start;
  }
  :global([dir='rtl']) .item__code {
    text-align: end;
  }
  .item__text {
    display: grid;
    gap: var(--s-1);
    font-size: 0.9375rem;
    color: var(--muted);
  }
  .item__variants {
    display: grid;
    gap: 2px;
  }
  .item__variants .mono {
    font-size: 0.75rem;
    overflow-wrap: anywhere;
  }
  .item__label {
    font-size: 0.8125rem;
  }
  .item__sheet {
    justify-self: end;
    display: inline-flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: flex-end;
    gap: 0 var(--s-2);
    min-height: 44px;
    padding-block: var(--s-2);
    font-size: 0.875rem;
    font-weight: 600;
  }
  .item__meta {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 400;
    color: var(--muted);
  }
  .item__arrow {
    font-family: var(--font-mono);
    transition: transform var(--dur-2) var(--ease);
  }
  .item__sheet:hover .item__arrow {
    transform: translate(3px, -3px);
  }
  :global([dir='rtl']) .item__arrow {
    transform: scaleX(-1);
  }
  :global([dir='rtl']) .item__sheet:hover .item__arrow {
    transform: scaleX(-1) translate(3px, -3px);
  }
  .item__sheet:hover span:first-child {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  @media (max-width: 900px) {
    .acc__grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .acc__aside {
      position: static;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: start;
    }
  }
  @media (max-width: 720px) {
    .acc__aside {
      grid-template-columns: minmax(0, 1fr);
    }
    .acc :global(.acc__well) {
      aspect-ratio: 4 / 3;
    }
    .item {
      grid-template-columns: minmax(0, 1fr) auto;
    }
    .item__text {
      grid-column: 1 / -1;
      grid-row: 2;
    }
    .item__sheet {
      grid-column: 2;
      grid-row: 1;
      align-self: start;
      margin-top: -12px;
      padding-block: 0;
    }
  }
</style>
