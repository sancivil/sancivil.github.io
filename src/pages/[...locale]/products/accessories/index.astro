---
import Base from '../../../../layouts/Base.astro';
import PageIntro from '../../../../components/products/PageIntro.astro';
import Stats from '../../../../components/products/Stats.astro';
import ProductWell from '../../../../components/products/ProductWell.astro';
import { accessories, categoryImage, docInfo } from '../../../../components/products/data.ts';
import { localeFromParam, localeParams } from '../../../../i18n/config.ts';
import { common } from '../../../../i18n/common.ts';
import { products } from '../../../../i18n/products.ts';
import { accessoryGroup, accessoryText, catalogText } from '../../../../i18n/catalog-text.ts';

export const getStaticPaths = () => localeParams();
const locale = localeFromParam(Astro.params.locale);
const t = products[locale];
const p = t.accessoriesPage;
const nav = common[locale];

const groups = [...new Set(accessories.map((a) => a.group))].map((group, i) => ({
  id: `group-${i + 1}`,
  name: accessoryGroup(locale, group),
  items: accessories
    .filter((a) => a.group === group)
    .map((a) => ({
      a,
      text: accessoryText(locale, a.slug),
      variants: a.description?.includes(' | ') ? a.description.split(' | ') : null,
      sheet: a.datasheets[0] ? { url: a.datasheets[0].url, ...docInfo(a.datasheets[0]) } : null,
    })),
}));
---

<Base title={p.title} description={p.description}>
  <PageIntro
    locale={locale}
    crumbs={[{ label: nav.nav.products, href: '/products/' }, { label: nav.productNav.accessories }]}
    eyebrow={p.eyebrow}
    title={nav.productNav.accessories}
    lead={catalogText[locale].categories.accessories}
    display
  >
    <Stats
      items={[
        { label: p.stat.products, value: String(accessories.length), count: true },
        { label: p.stat.groups, value: String(groups.length), count: true },
      ]}
    />
  </PageIntro>

  <section class="section acc">
    <div class="container acc__grid">
      <div class="acc__aside">
        <ProductWell
          src={categoryImage.accessories.src}
          size={categoryImage.accessories.size}
          alt={t.categoryAlt.accessories}
          label={nav.productNav.accessories}
          sizes="(max-width: 900px) 100vw, 30vw"
          eager
          class="acc__well"
        />
        <ul role="list" class="acc__index">
          {
            groups.map((g, i) => (
              <li>
                <a href={`#${g.id}`}>
                  <span class="mono">{String(i + 1).padStart(2, '0')}</span>
                  {g.name}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="acc__groups">
        {
          groups.map((g, i) => (
            <section class="group" aria-labelledby={g.id}>
              <h2 id={g.id} class="group__title">
                <span class="group__index mono">{String(i + 1).padStart(2, '0')}</span>
                {g.name}
              </h2>
              <ul role="list" class="group__list">
                {g.items.map((item) => (
                  <li class="item">
                    <p class="item__code" dir="ltr">
                      {item.a.name}
                    </p>
                    <div class="item__text">
                      {item.text && <p>{item.text}</p>}
                      {item.variants && (
                        <p class="item__variants">
                          <span class="item__label">{p.variants}</span>
                          <span class="mono" dir="ltr">
                            {item.variants.join(' · ')}
                          </span>
                        </p>
                      )}
                    </div>
                    {item.sheet && (
                      <a class="item__sheet" href={item.sheet.url} target="_blank" rel="noopener">
                        <span>{t.label.datasheet}</span>
                        <span class="item__meta">
                          PDF{item.sheet.lang && ` · ${t.docLang[item.sheet.lang]}`}
                        </span>
                        <span class="item__arrow" aria-hidden="true">
                          ↗
                        </span>
                        <span class="sr-only">
                          {item.a.name} {t.newTab}
                        </span>
                      </a>
                    )}
                  </li>
                ))}
              </ul>
            </section>
          ))
        }
      </div>
    </div>
  </section>
</Base>

<style>
  .acc__grid {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
    gap: var(--s-8) var(--gap);
    align-items: start;
  }
  .acc__aside {
    position: sticky;
    top: calc(var(--header-h) + var(--s-5));
    display: grid;
    gap: var(--s-5);
  }
  .acc :global(.acc__well) {
    padding: 8%;
  }
  .acc__index {
    border-top: 1px solid var(--line);
  }
  .acc__index a {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    min-height: 44px;
    border-bottom: 1px solid var(--line);
    font-size: 0.9375rem;
    transition: color var(--dur-1) var(--ease);
  }
  .acc__index a:hover {
    color: var(--muted);
  }
  .acc__index .mono {
    font-size: 0.6875rem;
    color: var(--muted);
  }
  .acc__groups {
    display: grid;
    gap: var(--s-9);
  }
  .group {
    scroll-margin-top: calc(var(--header-h) + var(--s-5));
  }
  .group__title {
    display: flex;
    align-items: baseline;
    gap: var(--s-4);
    margin-bottom: var(--s-4);
    font-size: clamp(1.5rem, 1rem + 1.4vw, 2.25rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.15;
  }
  :global([dir='rtl']) .group__title {
    letter-spacing: 0;
    line-height: 1.5;
  }
  .group__index {
    font-size: 0.75rem;
    font-weight: 400;
    letter-spacing: 0;
    color: var(--muted);
  }
  .group__list {
    border-top: 1px solid var(--line-strong);
  }
  .item {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 5fr) minmax(0, 3fr);
    align-items: baseline;
    gap: var(--s-2) var(--gap);
    padding-block: var(--s-4);
    border-bottom: 1px solid var(--line);
  }
  .item__code {
    font-family: var(--font-mono);
    font-size: 0.9375rem;
    font-weight: 500;
    overflow-wrap: anywhere;
    text-align: start;
  }
  :global([dir='rtl']) .item__code {
    text-align: end;
  }
  .item__text {
    display: grid;
    gap: var(--s-1);
    font-size: 0.9375rem;
    color: var(--muted);
  }
  .item__variants {
    display: grid;
    gap: 2px;
  }
  .item__variants .mono {
    font-size: 0.75rem;
    overflow-wrap: anywhere;
  }
  .item__label {
    font-size: 0.8125rem;
  }
  .item__sheet {
    justify-self: end;
    display: inline-flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: flex-end;
    gap: 0 var(--s-2);
    min-height: 44px;
    padding-block: var(--s-2);
    font-size: 0.875rem;
    font-weight: 600;
  }
  .item__meta {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 400;
    color: var(--muted);
  }
  .item__arrow {
    font-family: var(--font-mono);
    transition: transform var(--dur-2) var(--ease);
  }
  .item__sheet:hover .item__arrow {
    transform: translate(3px, -3px);
  }
  :global([dir='rtl']) .item__arrow {
    transform: scaleX(-1);
  }
  :global([dir='rtl']) .item__sheet:hover .item__arrow {
    transform: scaleX(-1) translate(3px, -3px);
  }
  .item__sheet:hover span:first-child {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  @media (max-width: 900px) {
    .acc__grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .acc__aside {
      position: static;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: start;
    }
  }
  @media (max-width: 720px) {
    .acc__aside {
      grid-template-columns: minmax(0, 1fr);
    }
    .acc :global(.acc__well) {
      aspect-ratio: 4 / 3;
    }
    .item {
      grid-template-columns: minmax(0, 1fr) auto;
    }
    .item__text {
      grid-column: 1 / -1;
      grid-row: 2;
    }
    .item__sheet {
      grid-column: 2;
      grid-row: 1;
      align-self: start;
      margin-top: -12px;
      padding-block: 0;
    }
  }
</style>
