---
import Base from '../../../layouts/Base.astro';
import Breadcrumbs from '../../../components/products/Breadcrumbs.astro';
import Figure from '../../../components/products/Figure.astro';
import DocList from '../../../components/products/DocList.astro';
import TechDiagram from '../../../components/products/TechDiagram.astro';
import WarrantyChart from '../../../components/products/WarrantyChart.astro';
import CertStrip from '../../../components/products/CertStrip.astro';
import FinishSwatch from '../../../components/products/FinishSwatch.astro';
import {
  CERTS,
  GLASS_MM,
  GROUPS,
  accessories,
  batteries,
  categoryHref,
  categoryImage,
  docInfo,
  docItem,
  documents,
  extent,
  groupInverters,
  groupModels,
  groupPower,
  moduleCount,
  moduleEfficiency,
  modulePower,
  modules,
  outputTerms,
  pad2,
  pct,
  powerParts,
  seriesBySlug,
  seriesFinishes,
  seriesGlass,
  seriesRender,
  warranty,
  type CategoryKey,
} from '../../../components/products/data.ts';
import { localeFromParam, localeParams, localizePath } from '../../../i18n/config.ts';
import { common } from '../../../i18n/common.ts';
import { products } from '../../../i18n/products.ts';
import { catalogText, seriesText, warrantyDocLabel } from '../../../i18n/catalog-text.ts';

export const getStaticPaths = () => localeParams();
const locale = localeFromParam(Astro.params.locale);
const t = products[locale];
const d = t.detail;
const ct = catalogText[locale];
const nav = common[locale].productNav;

const powerYears = Math.min(...Object.values(warranty.modules).map((w) => w.power));
const inverterPower = powerParts(extent(GROUPS.flatMap(groupPower)));
const hero = seriesRender(seriesBySlug('or-series-or10h')!)!;

type Fact = { label: string; value: string | [string, string]; unit?: string; word?: string };
const onGridEff = Math.max(...groupInverters('onGrid').map((r) => r.efficiencyMax ?? 0));
const lines: { key: CategoryKey; facts: Fact[] }[] = [
  {
    key: 'modules',
    facts: [
      { label: t.label.power, value: [String(modulePower[0]), String(modulePower[1])], unit: 'W' },
      { label: t.label.maxEfficiency, value: pct(moduleEfficiency), unit: '%' },
      { label: t.label.models, value: String(moduleCount), word: t.count.series(modules.length) },
    ],
  },
  {
    key: 'hybrid',
    facts: [
      { label: t.label.acPower, ...powerParts(groupPower('hybrid')) },
      { label: t.label.models, value: String(groupModels('hybrid')) },
      { label: t.storage, value: String(batteries.length) },
    ],
  },
  {
    key: 'onGrid',
    facts: [
      { label: t.label.acPower, ...powerParts(groupPower('onGrid')) },
      { label: t.label.maxEfficiency, value: pct(onGridEff, 1), unit: '%' },
      { label: t.label.models, value: String(groupModels('onGrid')) },
    ],
  },
  {
    key: 'micro',
    facts: [
      { label: t.label.acPower, ...powerParts(groupPower('micro')) },
      { label: t.label.models, value: String(groupModels('micro')) },
    ],
  },
  {
    key: 'accessories',
    facts: [
      { label: t.accessoriesPage.stat.products, value: String(accessories.length) },
      { label: t.accessoriesPage.stat.groups, value: String(new Set(accessories.map((a) => a.group)).size) },
    ],
  },
];

const topcon = outputTerms('monoTopcon');
const halfCells = extent(modules.filter((s) => s.cells.some((n) => n >= 96)).flatMap((s) => s.cells.filter((n) => n >= 96)));
const tech: { key: keyof typeof d.tech; fact: Fact }[] = [
  { key: 'topcon', fact: { label: d.tech.topcon.fact, value: `−${topcon.yearly}`, unit: '%' } },
  { key: 'halfcut', fact: { label: d.tech.halfcut.fact, value: [String(halfCells[0]), String(halfCells[1])] } },
  { key: 'bifacial', fact: { label: d.tech.bifacial.fact, value: GLASS_MM.rear, unit: 'mm' } },
  { key: 'arc', fact: { label: d.tech.arc.fact, value: GLASS_MM.front, unit: 'mm' } },
  { key: 'pid', fact: { label: d.tech.pid.fact, value: 'IEC TS 62804-1' } },
];

const outputKeys = ['monoTopcon', 'monoPerc', 'polycrystalline'] as const;
const outputs = outputKeys.map((key) => ({ key, ...outputTerms(key) }));

/* Warranty terms, grouped where series share the same terms: "OR Series · DR Series". */
const terms = new Map<string, { names: string[]; product: number; power: number }>();
for (const [name, w] of Object.entries(warranty.modules)) {
  const key = `${w.product}/${w.power}`;
  const entry = terms.get(key) ?? { names: [], product: w.product, power: w.power };
  entry.names.push(name);
  terms.set(key, entry);
}

const manuals = [
  docItem({ label: ct.documents.installationManual, url: documents.installationManual }),
  docItem({ label: ct.documents.installationManualAR, url: documents.installationManualAR }),
];
const docs = [
  ...(locale === 'ar' ? manuals.reverse() : manuals),
  docItem({ label: ct.documents.productsFlyer, url: documents.productsFlyer }),
  docItem({ label: ct.documents.companyBrochure, url: documents.companyBrochure }),
  docItem({ label: ct.documents.companyPresentation, url: documents.companyPresentation }),
  ...warranty.documents.map((doc) => docItem(doc, warrantyDocLabel(locale, docInfo(doc).label))),
];
---

<Base title={t.index.title} description={t.index.description}>
  <section class="hero theme-paper">
    <div class="container">
      <Breadcrumbs locale={locale} items={[{ label: common[locale].nav.products }]} />
      <div class="hero__grid">
        <div class="hero__text">
          <p class="eyebrow eyebrow--dot">{t.index.eyebrow}</p>
          <h1 class="display hero__title" data-reveal="lines">{t.index.h1}</h1>
          <p class="lead hero__lead">{t.index.lead}</p>
          <dl class="hero__stats">
            <div>
              <dt>{t.index.stat.modules}</dt>
              <dd><Figure value={[String(modulePower[0]), String(modulePower[1])]} unit="W" /></dd>
            </div>
            <div>
              <dt>{t.index.stat.inverters}</dt>
              <dd><Figure value={inverterPower.value} unit={inverterPower.unit} /></dd>
            </div>
            <div>
              <dt>{t.index.stat.warranty}</dt>
              <dd><Figure value={String(powerYears)} word={t.years(powerYears)} count /></dd>
            </div>
          </dl>
        </div>
        <div class="hero__stage" role="img" aria-label={d.stageAlt}>
          <img
            class="hero__module"
            src={hero.src}
            width={hero.size[0]}
            height={hero.size[1]}
            alt=""
            fetchpriority="high"
            decoding="async"
          />
          <img
            class="hero__system"
            src={categoryImage.hybrid.src}
            width={categoryImage.hybrid.size[0]}
            height={categoryImage.hybrid.size[1]}
            alt=""
            decoding="async"
          />
        </div>
      </div>
    </div>
  </section>

  <section class="section lines" aria-labelledby="lines-title">
    <div class="container">
      <h2 id="lines-title" class="eyebrow lines__title">{d.linesTitle}</h2>
      <ol role="list" class="lines__grid">
        {
          lines.map((row, i) => (
            <li class:list={['line', `line--${row.key}`]}>
              <div class="line__well" data-reveal="clip">
                <img
                  src={categoryImage[row.key].src}
                  width={categoryImage[row.key].size[0]}
                  height={categoryImage[row.key].size[1]}
                  alt={t.categoryAlt[row.key]}
                  loading={i < 2 ? 'eager' : 'lazy'}
                  decoding="async"
                />
              </div>
              <div class="line__body">
                <span class="line__index mono">{pad2(i)}</span>
                <h3 class="h2 line__name">
                  <a class="line__link" href={localizePath(categoryHref(row.key), locale)}>
                    {nav[row.key]}
                  </a>
                </h3>
                <p class="line__desc">{ct.categories[row.key]}</p>
                <dl class="line__facts">
                  {row.facts.map((f) => (
                    <div>
                      <dt>{f.label}</dt>
                      <dd>
                        <Figure value={f.value} unit={f.unit} word={f.word} />
                      </dd>
                    </div>
                  ))}
                </dl>
                <span class="line__arrow" aria-hidden="true" />
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section theme-dark tech" aria-labelledby="tech-title">
    <div class="container">
      <div class="sec-head">
        <p class="eyebrow eyebrow--dot">{d.techEyebrow}</p>
        <h2 id="tech-title" class="h2" data-reveal="lines">{d.techTitle}</h2>
      </div>
      <ul role="list" class="tech__grid">
        {
          tech.map((item) => (
            <li class="tech__item">
              <div class="tech__figure">
                <TechDiagram kind={item.key} />
              </div>
              <h3 class="tech__name">{d.tech[item.key].name}</h3>
              <p class="tech__text">{d.tech[item.key].text}</p>
              <p class="tech__fact">
                <span class="tech__fact-label">{item.fact.label}</span>
                <span class="tech__fact-value">
                  {item.key === 'pid' ? <span class="mono" dir="ltr">{item.fact.value}</span> : <Figure value={item.fact.value} unit={item.fact.unit} />}
                </span>
              </p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section compare" aria-labelledby="compare-title">
    <div class="container">
      <div class="sec-head sec-head--row">
        <div>
          <p class="eyebrow">{d.compareEyebrow}</p>
          <h2 id="compare-title" class="h2">{d.compareTitle}</h2>
        </div>
        <p class="compare__swipe small">{t.inverterPage.swipe}</p>
      </div>
      <div class="compare__scroll" tabindex="0" role="region" aria-labelledby="compare-title">
        <table class="compare__table">
          <caption class="sr-only">{d.compareCaption}</caption>
          <thead>
            <tr>
              <th scope="col">{d.col.series}</th>
              <th scope="col">{d.col.technology}</th>
              <th scope="col">{d.col.power}</th>
              <th scope="col">{d.col.efficiency}</th>
              <th scope="col">{d.col.cells}</th>
              <th scope="col">{d.col.glass}</th>
              <th scope="col">{d.col.finishes}</th>
              <th scope="col">{d.col.warranty}</th>
            </tr>
          </thead>
          <tbody>
            {
              modules.map((s) => {
                const text = seriesText(locale, s.slug);
                const glass = seriesGlass(s);
                const img = seriesRender(s);
                return (
                  <tr>
                    <th scope="row">
                      <a class="compare__series" href={localizePath(`/products/modules/${s.slug}/`, locale)}>
                        {img && <img src={img.src} width={img.size[0]} height={img.size[1]} alt="" loading="lazy" decoding="async" />}
                        <bdi>{s.name}</bdi>
                      </a>
                    </th>
                    <td class="compare__tech">{(text?.technology ?? s.technology).join(' · ') || t.notStated}</td>
                    <td class="compare__num">
                      <Figure value={[String(s.powerRange[0]), String(s.powerRange[1])]} unit="W" />
                    </td>
                    <td class="compare__num">
                      <Figure value={pct(s.efficiencyMax)} unit="%" />
                    </td>
                    <td class="num compare__cells">{s.cells.join(' / ')}</td>
                    <td class="compare__glass">
                      {glass === 'front' && (
                        <>
                          <span>{d.glass.ar}</span>
                          <Figure value={GLASS_MM.front} unit="mm" word={d.glass.front} />
                        </>
                      )}
                      {(glass === 'double' || glass === 'doubleSome') && (
                        <>
                          <span>{glass === 'double' ? d.glass.double : d.glass.doubleSome}</span>
                          <Figure value={GLASS_MM.rear} unit="mm" word={d.glass.rear} />
                        </>
                      )}
                      {glass === null && <span class="muted">{t.notStated}</span>}
                    </td>
                    <td>
                      <span class="compare__swatches">
                        {seriesFinishes(s).map((code) => (
                          <FinishSwatch code={code} />
                        ))}
                      </span>
                    </td>
                    <td class="compare__num">
                      <Figure value={`${s.warranty.product} / ${s.warranty.power}`} word={t.years(s.warranty.power)} />
                    </td>
                  </tr>
                );
              })
            }
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="section theme-dark warranty" aria-labelledby="warranty-title">
    <div class="container">
      <div class="sec-head">
        <p class="eyebrow eyebrow--dot">{t.warranty.eyebrow}</p>
        <h2 id="warranty-title" class="h2" data-reveal="lines">{t.warranty.title(powerYears)}</h2>
      </div>

      <div class="warranty__grid">
        <div class="warranty__chart">
          <h3 class="warranty__sub">{d.chartTitle(powerYears)}</h3>
          <p class="warranty__lead">{d.chartLead}</p>
          <WarrantyChart locale={locale} curves={['monoTopcon', 'monoPerc']} />
        </div>
        <div class="warranty__side">
          <ul role="list" class="output__list">
            {
              outputs.map((row) => (
                <li class="output__item">
                  <p class="output__label">{t.warranty.tech[row.key]}</p>
                  <p class="output__figure">
                    <Figure value={row.end} unit="%" />
                  </p>
                  <p class="output__steps small">
                    <span>{t.warranty.firstYear}</span>
                    <Figure value={`−${row.first}`} unit="%" />
                    <span>{t.warranty.perYear}</span>
                    <Figure value={`−${row.yearly}`} unit="%" />
                  </p>
                </li>
              ))
            }
          </ul>
          <table class="terms">
            <thead>
              <tr>
                <th scope="col">{t.warranty.colRange}</th>
                <th scope="col">{t.warranty.colProduct}</th>
                <th scope="col">{t.warranty.colPower}</th>
              </tr>
            </thead>
            <tbody>
              {
                [...terms.values()].map((row) => (
                  <tr>
                    <th scope="row">
                      <bdi>{row.names.join(' · ')}</bdi>
                    </th>
                    <td>
                      <Figure value={String(row.product)} word={t.years(row.product)} />
                    </td>
                    <td>
                      <Figure value={String(row.power)} word={t.years(row.power)} />
                    </td>
                  </tr>
                ))
              }
              <tr>
                <th scope="row">{t.warranty.storage}</th>
                <td colspan="2">
                  <Figure value={String(warranty.batteries.years)} word={t.years(warranty.batteries.years)} />
                </td>
              </tr>
            </tbody>
          </table>
          <p class="terms__note small">{ct.batteryWarranty(warranty.batteries.years)}</p>
        </div>
      </div>

      <div class="certs-block">
        <div class="certs-block__head">
          <p class="eyebrow">{d.certEyebrow}</p>
          <h3 class="h3">{d.certTitle}</h3>
          <p class="certs-block__note small">{d.certNote}</p>
        </div>
        <CertStrip locale={locale} items={CERTS} />
      </div>

      <div class="insurance">
        <div class="insurance__text">
          <p class="eyebrow">{t.warranty.insurance}</p>
          <h3 class="h3">{ct.insurance.headline}</h3>
          <p class="insurance__body">{ct.insurance.text}</p>
        </div>
        <dl class="insurance__list">
          {
            ct.insurance.coverages.map((c) => (
              <div>
                <dt>{c.name}</dt>
                <dd>{c.text}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </section>

  <section class="section docs" aria-labelledby="docs-title">
    <div class="container docs__grid">
      <div class="docs__head">
        <p class="eyebrow">{t.docs.eyebrow}</p>
        <h2 id="docs-title" class="h2">{t.docs.title}</h2>
      </div>
      <DocList locale={locale} items={docs} />
    </div>
  </section>
</Base>

<style>
  /* ---------- opening ---------- */
  .hero {
    padding-block: var(--s-4) 0;
    overflow: hidden;
  }
  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    align-items: end;
    gap: var(--s-7) var(--gap);
    margin-top: var(--s-6);
  }
  .hero__text {
    display: grid;
    justify-items: start;
    gap: var(--s-5);
    padding-block-end: clamp(48px, 7vw, 112px);
  }
  .hero__title {
    max-width: 11ch;
    text-wrap: balance;
  }
  .hero__lead {
    max-width: 40ch;
    color: var(--muted);
  }
  .hero__stats {
    display: grid;
    grid-template-columns: repeat(3, auto);
    gap: var(--s-5) clamp(20px, 3vw, 48px);
    margin-top: var(--s-3);
    padding-top: var(--s-5);
    border-top: 1px solid var(--line-strong);
  }
  .hero__stats dt,
  .line__facts dt,
  .tech__fact-label {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted-c);
  }
  :global([dir='rtl']) .hero__stats dt,
  :global([dir='rtl']) .line__facts dt,
  :global([dir='rtl']) .tech__fact-label {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    letter-spacing: 0;
    text-transform: none;
  }
  .hero__stats dd {
    margin-top: var(--s-1);
    font-size: clamp(1.375rem, 1rem + 1vw, 2rem);
    font-weight: 500;
    white-space: nowrap;
  }
  .hero__stage {
    position: relative;
    block-size: clamp(420px, 46vw, 680px);
  }
  .hero__stage::after {
    content: '';
    position: absolute;
    inset-inline: 4% 0;
    inset-block-end: 0;
    block-size: 1px;
    background: var(--line);
  }
  .hero__module {
    position: absolute;
    inset-block-end: -2%;
    inset-inline-start: 6%;
    block-size: 100%;
    inline-size: auto;
    max-width: none;
  }
  .hero__system {
    position: absolute;
    inset-block-end: 0;
    inset-inline-end: 0;
    block-size: 64%;
    inline-size: auto;
    max-width: none;
    filter: drop-shadow(0 18px 18px rgb(11 11 12 / 0.12));
  }
  :global([dir='rtl']) .hero__module {
    transform: scaleX(-1);
  }

  /* ---------- product lines ---------- */
  .lines__title {
    margin-bottom: var(--s-6);
  }
  .lines__grid {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: var(--s-8) var(--gap);
  }
  .line {
    position: relative;
    grid-column: span 2;
    display: grid;
    align-content: start;
    gap: var(--s-5);
  }
  .line--modules,
  .line--hybrid {
    grid-column: span 3;
  }
  .line__well {
    position: relative;
    aspect-ratio: 4 / 3;
    background: var(--paper-2);
    border-radius: var(--r-2);
    transition: background-color var(--dur-2) var(--ease);
  }
  .line:hover .line__well {
    background: var(--paper-3);
  }
  .line__well img {
    position: absolute;
    inset: 9%;
    inline-size: 82%;
    block-size: 82%;
    object-fit: contain;
  }
  .line__body {
    position: relative;
    display: grid;
    align-content: start;
    gap: var(--s-3);
    padding-top: var(--s-4);
    border-top: 1px solid var(--line);
  }
  .line__index {
    font-size: 0.75rem;
    color: var(--muted);
  }
  .line__name {
    font-family: var(--font-sans);
    font-size: clamp(1.625rem, 1rem + 1.6vw, 2.5rem);
  }
  .line--modules .line__name,
  .line--hybrid .line__name {
    font-size: clamp(1.875rem, 1rem + 2.2vw, 3rem);
  }
  .line__link::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .line:has(.line__link:focus-visible) {
    outline: 2px solid var(--ink);
    outline-offset: 6px;
  }
  .line__link:focus-visible {
    outline: none;
  }
  .line__desc {
    max-width: 46ch;
    color: var(--muted);
  }
  .line__facts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-4) clamp(20px, 3vw, 40px);
    margin-top: var(--s-2);
  }
  .line__facts dd {
    margin-top: var(--s-1);
    font-size: clamp(1.125rem, 1rem + 0.5vw, 1.5rem);
    font-weight: 500;
    white-space: nowrap;
  }
  .line__arrow {
    position: absolute;
    inset-block-start: var(--s-4);
    inset-inline-end: 0;
    font-family: var(--font-mono);
    font-size: 1.25rem;
    transition: transform var(--dur-2) var(--ease);
  }
  .line__arrow::after {
    content: '→';
  }
  :global([dir='rtl']) .line__arrow::after {
    content: '←';
  }
  .line:hover .line__arrow {
    transform: translateX(6px);
  }
  :global([dir='rtl']) .line:hover .line__arrow {
    transform: translateX(-6px);
  }

  /* ---------- shared section head ---------- */
  .sec-head {
    display: grid;
    justify-items: start;
    gap: var(--s-4);
    margin-bottom: var(--s-8);
  }
  .sec-head h2 {
    max-width: 22ch;
  }
  .sec-head--row {
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    margin-bottom: var(--s-6);
  }
  .sec-head--row > div {
    display: grid;
    gap: var(--s-4);
  }

  /* ---------- technology ---------- */
  .tech__grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    border-top: 1px solid var(--line-inv);
  }
  .tech__item {
    display: grid;
    grid-template-rows: auto auto 1fr auto;
    gap: var(--s-3);
    padding: var(--s-6) var(--s-5) var(--s-5);
    border-inline-end: 1px solid var(--line-inv);
  }
  .tech__item:first-child {
    padding-inline-start: 0;
  }
  .tech__item:last-child {
    border-inline-end: 0;
    padding-inline-end: 0;
  }
  .tech__figure {
    display: grid;
    place-items: center;
    block-size: 148px;
    margin-bottom: var(--s-3);
    padding: var(--s-3);
    background: var(--ink-2);
    border-radius: var(--r-2);
    color: var(--paper);
  }
  .tech__figure :global(svg) {
    block-size: 100%;
  }
  .tech__name {
    font-size: 1.1875rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .tech__text {
