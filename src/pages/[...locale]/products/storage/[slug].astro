---
import Base from '../../../../layouts/Base.astro';
import Breadcrumbs from '../../../../components/products/Breadcrumbs.astro';
import ProductWell from '../../../../components/products/ProductWell.astro';
import Figure from '../../../../components/products/Figure.astro';
import SpecList, { type SpecRow } from '../../../../components/products/SpecList.astro';
import DocList from '../../../../components/products/DocList.astro';
import BatteryList from '../../../../components/products/BatteryList.astro';
import JsonLd from '../../../../components/seo/JsonLd.astro';
import { absolute, breadcrumbList, product, productGroup } from '../../../../lib/seo/schema.ts';
import {
  CAPACITY_KEYS,
  batteries,
  batteryBySlug,
  capacityValue,
  categoryHref,
  categoryImage,
  displayName,
  docItem,
  headlineCapacity,
  productImage,
} from '../../../../components/products/data.ts';
import { whatsappLink } from '../../../../data/site.ts';
import { paragraphs } from '../../../../content/index.ts';
import { localeFromParam, localizePath, withLocales } from '../../../../i18n/config.ts';
import { common } from '../../../../i18n/common.ts';
import { products } from '../../../../i18n/products.ts';
import { chemistryText, storageText } from '../../../../i18n/catalog-text.ts';

export const getStaticPaths = () => withLocales(batteries.map((b) => ({ params: { slug: b.slug } })));

const locale = localeFromParam(Astro.params.locale);
const battery = batteryBySlug(Astro.params.slug!)!;
const name = displayName(battery.name);
const t = products[locale];
const p = t.storagePage;
const nav = common[locale];
const text = storageText(locale, battery.slug);
const capacity = headlineCapacity(battery);
const photo = battery.photos[0];
/** The owner's line name; on English pages Peimar's for a curated battery; never another language. */
const family = text?.family ?? (locale === 'en' ? battery.family : null) ?? undefined;
const sheetsOnly = battery.docs.every((doc) => doc.kind === 'datasheet');

const rows: SpecRow[] = [
  ...(text?.family ? [{ label: p.fact.line, text: text.family }] : []),
  ...(text?.role ? [{ label: p.fact.type, text: displayName(text.role) }] : []),
  ...CAPACITY_KEYS.flatMap((key) => {
    const v = battery.capacity?.[key];
    return v === undefined ? [] : [{ label: p.fact[key], ...capacityValue(key, v) }];
  }),
  ...(battery.chemistry ? [{ label: p.fact.chemistry, value: chemistryText(locale, battery.chemistry) }] : []),
];

const others = batteries.filter((b) => b.slug !== battery.slug);
/* Search results show about 160 characters of a description: the owner's line name joins it when it fits. */
const withLine = p.description(battery.brand, name, family);
const description = withLine.length > 160 ? p.description(battery.brand, name) : withLine;
const pageUrl = absolute(localizePath(`/products/storage/${battery.slug}/`, locale));
/* A name that groups models with " | " is one product sold in several models. */
const models = battery.name.split(' | ');
const about = {
  name: `${battery.brand} ${name}`,
  brand: battery.brand,
  description: text?.description ?? `${name} · ${family ?? t.storage}`,
  image: photo?.src ?? categoryImage.hybrid.src,
  url: pageUrl,
  category: family ?? t.storage,
  additionalProperty: [
    ...(capacity
      ? [{ name: 'Capacity', value: capacity[0] === capacity[1] ? capacity[0] : `${capacity[0]}–${capacity[1]}`, unitCode: 'KWH' }]
      : []),
    ...(battery.chemistry ? [{ name: 'Chemistry', value: chemistryText('en', battery.chemistry) }] : []),
    ...(battery.warrantyYears ? [{ name: 'Product warranty', value: battery.warrantyYears, unitText: 'years' }] : []),
  ],
};
const schema = [
  models.length > 1 ? productGroup({ ...about, id: battery.slug, models }) : product({ ...about, model: battery.name }),
  breadcrumbList([
    { name: nav.nav.products, url: absolute(localizePath('/products/', locale)) },
    { name: nav.productNav.hybrid, url: absolute(localizePath(categoryHref('hybrid'), locale)) },
    { name, url: pageUrl },
  ]),
];
---

<Base title={p.title(battery.brand, name)} description={description}>
  <JsonLd data={schema} />
  <section class="product theme-light">
    <div class="container">
      <Breadcrumbs
        locale={locale}
        items={[
          { label: nav.nav.products, href: '/products/' },
          { label: nav.productNav.hybrid, href: categoryHref('hybrid') },
          { label: name },
        ]}
      />

      <div class="product__grid">
        <figure class="product__figure">
          {
            photo ? (
              <ProductWell
                image={photo}
                alt={photo.alt[locale] ?? name}
                label={name}
                brand={battery.brand}
                sizes="(max-width: 900px) 49vw, (max-width: 1440px) 29vw, 420px"
                eager
                priority
                class="product__well"
              />
            ) : (
              <>
                <ProductWell
                  image={productImage(categoryImage.hybrid.src, categoryImage.hybrid.size)}
                  alt={t.categoryAlt.hybrid}
                  label={name}
                  sizes="(max-width: 900px) 49vw, (max-width: 1440px) 29vw, 420px"
                  eager
                  priority
                  class="product__well"
                />
                <figcaption class="product__caption">{p.photo}</figcaption>
              </>
            )
          }
        </figure>

        <div class="product__info">
          <header class="product__head">
            <p class="eyebrow eyebrow--dot">{p.eyebrow(battery.brand)}</p>
            <h1 class="h1 product__title" data-reveal="lines">{name}</h1>
            {text?.description && paragraphs(text.description).map((para) => <p class="product__lead">{para}</p>)}
          </header>

          {
            (capacity || battery.warrantyYears) && (
              <dl class="figures">
                {capacity && (
                  <div class="figures__item">
                    <dt>{t.label.capacity}</dt>
                    <dd class="figures__value">
                      <Figure value={capacity} unit="kWh" count />
                    </dd>
                  </div>
                )}
                {battery.warrantyYears && (
                  <div class="figures__item">
                    <dt>{t.label.warranty}</dt>
                    <dd class="figures__value">
                      <Figure value={String(battery.warrantyYears)} word={t.years(battery.warrantyYears)} count />
                    </dd>
                    {text?.warrantyNote && <dd class="figures__note">{text.warrantyNote}</dd>}
                  </div>
                )}
              </dl>
            )
          }

          <section class="product__facts" aria-labelledby="specs-title">
            <h2 id="specs-title" class="product__label">{p.specs}</h2>
            <SpecList rows={rows} />
          </section>

          {
            battery.docs.length > 0 && (
              <section class="product__facts" aria-labelledby="sheet-title">
                <h2 id="sheet-title" class="product__label">
                  {sheetsOnly ? t.label.datasheet : t.label.documents}
                </h2>
                <DocList
                  locale={locale}
                  items={battery.docs.map((doc) => (doc.kind === 'manual' ? docItem(doc, `${t.label.manual} · ${doc.label}`) : docItem(doc)))}
                />
              </section>
            )
          }

          <div class="product__actions">
            <a class="btn btn--sun" href={whatsappLink(t.quoteMessage(battery.brand, name))} target="_blank" rel="noopener">
              {t.quote}<span class="sr-only">{t.newTab}</span>
            </a>
            <a class="btn btn--line" href={localizePath(`${categoryHref('hybrid')}#storage`, locale)}>
              {nav.productNav.hybrid}
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section theme-paper" aria-labelledby="more-title">
    <div class="container">
      <h2 id="more-title" class="h2 more__title">{p.moreTitle}</h2>
      <BatteryList locale={locale} batteries={others} />
    </div>
  </section>
</Base>

<style>
  .product {
    padding-block: var(--s-4) clamp(56px, 7vw, 112px);
  }
  .product__grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: var(--s-7) clamp(32px, 5vw, 96px);
    margin-top: var(--s-6);
    align-items: start;
  }
  .product__figure {
    position: sticky;
    top: calc(var(--header-h) + var(--s-5));
    display: grid;
    gap: var(--s-3);
  }
  .product :global(.product__well) {
    padding: 10%;
  }
  .product__caption {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--muted);
  }
  .product__info {
    display: grid;
    gap: var(--s-7);
    min-width: 0;
  }
  .product__head {
    display: grid;
    justify-items: start;
    gap: var(--s-4);
  }
  .product__title {
    font-family: var(--font-sans);
    font-size: clamp(2.25rem, 1rem + 3vw, 4rem);
    overflow-wrap: anywhere;
  }
  .product__lead {
    max-width: 52ch;
    font-size: 1.0625rem;
    color: var(--muted);
  }
  .figures {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-top: 1px solid var(--line-strong);
  }
  .figures__item {
    display: grid;
    align-content: start;
    gap: var(--s-1);
    padding-block: var(--s-4) var(--s-5);
    padding-inline: var(--s-4);
    border-bottom: 1px solid var(--line);
  }
  .figures__item:first-child {
    padding-inline-start: 0;
  }
  .figures__item + .figures__item {
    border-inline-start: 1px solid var(--line);
  }
  .figures dt,
  .product__label {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
  }
  :global([dir='rtl']) :is(.figures dt, .product__label) {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    letter-spacing: 0;
    text-transform: none;
  }
  .figures__value {
    font-size: clamp(1.75rem, 1rem + 1.6vw, 2.5rem);
    font-weight: 500;
    line-height: 1.15;
  }
  .figures__note {
    margin-top: var(--s-2);
    max-width: 40ch;
    font-size: 0.8125rem;
    color: var(--muted);
  }
  .product__facts {
    display: grid;
    gap: var(--s-3);
  }
  .product__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
  }
  .more__title {
    margin-bottom: var(--s-6);
  }
  @media (max-width: 900px) {
    .product__grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .product__figure {
      position: static;
    }
    .product :global(.product__well) {
      aspect-ratio: 16 / 10;
      padding: 5%;
    }
  }
  @media (max-width: 720px) {
    .product__actions .btn {
      flex: 1 1 100%;
    }
  }
  @media (max-width: 520px) {
    .figures {
      grid-template-columns: minmax(0, 1fr);
    }
    .figures__item {
      padding-inline: 0;
    }
    .figures__item + .figures__item {
      border-inline-start: 0;
    }
  }
</style>
