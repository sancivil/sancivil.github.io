---
import Base from '../../../../layouts/Base.astro';
import PageIntro from '../../../../components/products/PageIntro.astro';
import Stats from '../../../../components/products/Stats.astro';
import SectionHead from '../../../../components/products/SectionHead.astro';
import PhaseGroups from '../../../../components/products/PhaseGroups.astro';
import BatteryList from '../../../../components/products/BatteryList.astro';
import SystemDiagram from '../../../../components/products/SystemDiagram.astro';
import {
  batteries,
  categoryImage,
  groupModels,
  groupPower,
  powerParts,
  warranty,
} from '../../../../components/products/data.ts';
import { localeFromParam, localeParams } from '../../../../i18n/config.ts';
import { common } from '../../../../i18n/common.ts';
import { products } from '../../../../i18n/products.ts';
import { catalogText } from '../../../../i18n/catalog-text.ts';

export const getStaticPaths = () => localeParams();
const locale = localeFromParam(Astro.params.locale);
const t = products[locale];
const p = t.hybridPage;
const nav = common[locale];
const power = powerParts(groupPower('hybrid'));
const years = warranty.batteries.years;
const models = groupModels('hybrid');
---

<Base title={p.title} description={p.description}>
  <PageIntro
    locale={locale}
    crumbs={[{ label: nav.nav.products, href: '/products/' }, { label: nav.productNav.hybrid }]}
    eyebrow={p.eyebrow}
    title={nav.productNav.hybrid}
    lead={catalogText[locale].categories.hybrid}
    display
  >
    <Stats
      items={[
        { label: p.stat.power, value: power.value, unit: power.unit },
        { label: p.stat.warranty, value: String(years), word: t.years(years), count: true },
        { label: p.stat.models, value: String(models) },
      ]}
    />
  </PageIntro>

  <section class="section" aria-labelledby="inverters-title">
    <div class="container">
      <SectionHead
        id="inverters-title"
        title={p.invertersTitle}
        meta={t.count.models(models)}
        image={{ ...categoryImage.hybrid, alt: t.categoryAlt.hybrid }}
      />
      <PhaseGroups locale={locale} group="hybrid" />
    </div>
  </section>

  <section class="section section--tight system" aria-labelledby="system-title">
    <div class="container system__grid">
      <div class="system__head">
        <p class="eyebrow">{t.detail.systemEyebrow}</p>
        <h2 id="system-title" class="h2">{t.detail.systemTitle}</h2>
        <p class="system__lead">{t.detail.systemLead}</p>
      </div>
      <SystemDiagram locale={locale} />
    </div>
  </section>

  <section class="section theme-paper" id="storage" aria-labelledby="storage-title">
    <div class="container">
      <SectionHead id="storage-title" title={p.storageTitle} lead={p.storageLead} meta={t.count.storage(batteries.length)} />
      <BatteryList locale={locale} batteries={batteries} />
    </div>
  </section>
</Base>

<style>
  .system {
    padding-block-start: 0;
  }
  .system__grid {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
    gap: var(--s-6) clamp(32px, 5vw, 96px);
    align-items: start;
    padding-top: var(--s-7);
    border-top: 1px solid var(--line);
  }
  .system__head {
    display: grid;
    justify-items: start;
    gap: var(--s-4);
  }
  .system__lead {
    max-width: 44ch;
    color: var(--muted);
  }
  @media (max-width: 1080px) {
    .system__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
