---
import Base from '../../../layouts/Base.astro';
import PageHead from '../../../components/company/PageHead.astro';
import ProjectMedia from '../../../components/company/ProjectMedia.astro';
import CtaBand from '../../../components/company/CtaBand.astro';
import { projectList, projectSpan } from '../../../components/company/facts.ts';
import { localeFromParam, localeParams, localizePath } from '../../../i18n/config.ts';
import { company, type ProjectSlug } from '../../../i18n/company.ts';

export const getStaticPaths = () => localeParams();

const locale = localeFromParam(Astro.params.locale);
const c = company[locale];
const t = c.projectsPage;
---

<Base title={t.meta.title} description={t.meta.description}>
  <PageHead eyebrow={t.eyebrow} title={t.title(projectSpan.min, projectSpan.max)} lead={t.lead} />

  <section class="plist theme-light section" aria-label={t.listLabel}>
    <div class="container">
      <ol class="plist__rows" role="list">
        {
          projectList.map((p) => {
            const copy = c.projects[p.slug as ProjectSlug];
            return (
              <li id={p.slug} class="plist__row">
                <p class="plist__kwp"><span class="num">{p.kwp}<span class="unit">kWp</span></span></p>
                <div class="plist__text">
                  <h2 class="h3 plist__title">{copy.title}</h2>
                  <p class="plist__line">{copy.line}</p>
                  <span class="tag">{c.categories[p.category]}</span>
                </div>
                <div class="plist__media">
                  <ProjectMedia project={p} alt={copy.alt} />
                </div>
              </li>
            );
          })
        }
      </ol>
    </div>
  </section>

  <CtaBand
    title={t.cta.title}
    primary={{ label: t.cta.designer, href: localizePath('/designer/', locale) }}
    secondary={{ label: t.cta.contact, href: localizePath('/contact/', locale) }}
  />
</Base>

<style>
  .plist__rows {
    border-bottom: 1px solid var(--line);
  }
  .plist__row {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 4fr) minmax(0, 5fr);
    grid-template-areas: 'kwp text media';
    align-items: start;
    gap: var(--s-5) var(--gap);
    padding-block: clamp(var(--s-6), 4vw, var(--s-8));
    border-top: 1px solid var(--line);
  }
  .plist__kwp {
    grid-area: kwp;
    font-size: clamp(3rem, 1.6rem + 4.4vw, 6.75rem);
    line-height: 0.9;
  }
  .plist__text {
    grid-area: text;
    display: grid;
    justify-items: start;
    gap: var(--s-3);
  }
  .plist__line {
    max-width: 36ch;
    color: var(--muted);
  }
  .plist__text .tag {
    margin-block-start: var(--s-2);
  }
  .plist__media {
    grid-area: media;
  }

  @media (max-width: 1080px) {
    .plist__row {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      grid-template-areas:
        'kwp media'
        'text media';
      row-gap: var(--s-4);
    }
  }

  @media (max-width: 720px) {
    .plist__row {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas:
        'media'
        'kwp'
        'text';
    }
    .plist__kwp {
      margin-block-start: var(--s-2);
    }
  }
</style>
