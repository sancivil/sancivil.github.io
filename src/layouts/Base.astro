---
import '@fontsource-variable/dm-sans';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '../styles/global.css';
import dmSansLatin from '@fontsource-variable/dm-sans/files/dm-sans-latin-wght-normal.woff2?url';
import notoSansArabic from '@fontsource-variable/noto-sans-arabic/files/noto-sans-arabic-arabic-wght-normal.woff2?url';
import notoKufiArabic from '@fontsource-variable/noto-kufi-arabic/files/noto-kufi-arabic-arabic-wght-normal.woff2?url';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import HelpButton from '../components/HelpButton.astro';
import JsonLd from '../components/seo/JsonLd.astro';
import { contact, phones } from '../data/site.ts';
import iraq from '../data/iraq-solar.json';
import { openingHoursSchema, organization as org, socials } from '../content/index.ts';
import { common, langHint } from '../i18n/common.ts';
import { locales, localeMeta, localeFromPath, localizePath, stripLocale } from '../i18n/config.ts';
import { website } from '../lib/seo/schema.ts';

interface Props {
  title: string;
  description: string;
  /** Open Graph image path. Without it, the default card, with its size and description (og:image:width/height/alt). */
  image?: string;
  /** Single-URL pages (404, dev): no canonical or hreflang, and the language switcher goes to each language's home. */
  noindex?: boolean;
}

const { title, description, image, noindex = false } = Astro.props;
const locale = localeFromPath(Astro.url.pathname);
const meta = localeMeta[locale];
const basePath = stripLocale(Astro.url.pathname);
/* Search results show about 65 characters of a title: the brand follows the page's own title when both fit. */
const branded = `${title} · Faraday`;
const fullTitle = title.includes('Faraday') || branded.length > 65 ? title : branded;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image ?? '/brand/og-default.png', Astro.site);
/* What the default card (1200 × 630) says, for link previews read aloud. */
const ogDefaultAlt = `Faraday · ${common[locale].footer.eyebrow}`;
const rtl = meta.dir === 'rtl';
const showLangHint = locale === 'en' && !noindex;
/** GitHub Pages preview build (SITE_PREVIEW=1, set in .github/workflows): keep the copy out of search results. */
const preview = import.meta.env.SITE_PREVIEW === '1';
const hintLocales = ['ar', 'ckb'] as const;

/* Arabic script reads smaller than DM Sans at the same size. On Arabic and Kurdish pages these aliases of the Noto
   faces carry size-adjust for Arabic code points only, so Latin brand names, codes and digits keep their size. Latin
   pages show Arabic script only in the language hint and on the 404 page, in Noto Sans Arabic at its own size (the
   language names have their own subset, global.css). Only the Arabic files are declared: arrows such as → are in no
   font here, so a face that claimed them would be downloaded for nothing before the system font draws them. */
const arabicRange =
  'U+0600-06FF, U+0750-077F, U+0870-088E, U+0890-0891, U+0897-08E1, U+08E3-08FF, U+200C-200E, U+FB50-FDFF, U+FE70-FE74, U+FE76-FEFC';
const arabicFaces = (
  rtl
    ? [
        ['Faraday Arabic', notoSansArabic, '107%'],
        ['Faraday Kufi', notoKufiArabic, '103%'],
      ]
    : [['Noto Sans Arabic Variable', notoSansArabic, '100%']]
)
  .map(
    ([family, src, size]) =>
      `@font-face{font-family:'${family}';font-style:normal;font-display:swap;font-weight:100 900;src:url(${src}) format('woff2-variations');unicode-range:${arabicRange};size-adjust:${size}}`,
  )
  .join('');

const alternates = locales.map((l) => ({
  hreflang: localeMeta[l].hreflang,
  href: new URL(localizePath(basePath, l), Astro.site).toString(),
}));

/* One ContactPoint object for a single phone, an array for several; the label names a labelled one. */
const contactPoints = phones.map((phone) => ({
  '@type': 'ContactPoint',
  contactType: phone.label?.en ?? 'sales',
  telephone: phone.e164,
  email: contact.email,
  availableLanguage: ['English', 'Arabic', 'Kurdish'],
  areaServed: 'IQ',
}));
const organization = {
  '@context': 'https://schema.org',
  '@type': ['LocalBusiness', 'Store'],
  '@id': `${Astro.site}#business`,
  name: contact.company,
  alternateName: ['Faraday', 'Faraday Iraq', 'فاراداي', 'فارادەی'],
  description: org.description,
  slogan: org.slogan,
  foundingDate: String(contact.founded),
  foundingLocation: { '@type': 'Place', name: 'Sulaymaniyah, Iraq' },
  url: Astro.site?.toString(),
  brand: { '@type': 'Brand', name: 'Peimar', url: 'https://peimar.com/' },
  knowsAbout: [
    'Photovoltaic modules',
    'Solar panels',
    'Hybrid inverters',
    'On-grid inverters',
    'Battery energy storage',
    'PV string sizing',
    'Solar power systems for homes and businesses in Iraq',
    'Peimar',
  ],
  knowsLanguage: ['en', 'ar', 'ckb'],
  areaServed: [
    { '@type': 'Country', name: 'Iraq' },
    { '@type': 'AdministrativeArea', name: 'Kurdistan Region' },
    ...org.areaServed.flatMap((id) => iraq.cities.filter((c) => c.id === id).map((c) => ({ '@type': 'City', name: c.name }))),
  ],
  ...(contact.mapsHref && { hasMap: contact.mapsHref }),
  contactPoint: contactPoints.length === 1 ? contactPoints[0] : contactPoints,
  logo: new URL('/brand/icon-512.png', Astro.site).toString(),
  image: new URL('/brand/og-default.png', Astro.site).toString(),
  telephone: contact.phoneHref.replace('tel:', ''),
  email: contact.email,
  address: {
    '@type': 'PostalAddress',
    streetAddress: contact.street,
    addressLocality: contact.city,
    ...(contact.postalCode && { postalCode: contact.postalCode }),
    addressCountry: 'IQ',
  },
  ...(openingHoursSchema.length > 0 && { openingHoursSpecification: openingHoursSchema }),
  ...(socials.length > 0 && { sameAs: socials.map((s) => s.url) }),
};
---

<!doctype html>
<html lang={meta.lang} dir={meta.dir} class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    {/* The view-transition opt-in comes before any stylesheet (see "page transitions" in global.css). */}
    <style is:inline>
      @media (prefers-reduced-motion: no-preference) {
        @view-transition {
          navigation: auto;
        }
      }
    </style>
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {
      noindex ? (
        <meta name="robots" content="noindex" />
      ) : (
        <>
          <link rel="canonical" href={canonical} />
          {alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
          <link rel="alternate" hreflang="x-default" href={alternates[0].href} />
          {preview && <meta name="robots" content="noindex" />}
        </>
      )
    }
    <link rel="preload" href={dmSansLatin} as="font" type="font/woff2" crossorigin />
    {rtl && <link rel="preload" href={notoSansArabic} as="font" type="font/woff2" crossorigin />}
    <style is:inline set:html={arabicFaces} />
    <meta name="theme-color" content="#0b0b0c" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <JsonLd data={noindex ? organization : [organization, website(locale)]} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Faraday" />
    <meta property="og:locale" content={meta.ogLocale} />
    {
      !noindex &&
        locales.filter((l) => l !== locale).map((l) => <meta property="og:locale:alternate" content={localeMeta[l].ogLocale} />)
    }
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    {
      !image && (
        <>
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
          <meta property="og:image:alt" content={ogDefaultAlt} />
        </>
      )
    }
    <meta name="twitter:card" content="summary_large_image" />
    {!image && <meta name="twitter:image:alt" content={ogDefaultAlt} />}

    <script is:inline>
      (function () {
        var d = document.documentElement;
        d.classList.remove('no-js');
        d.classList.add('js');
        var motion = !window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (motion) d.classList.add('motion');
        setTimeout(function () {
          d.classList.add('motion-ready');
        }, 2500);
        try {
          if (motion && !sessionStorage.getItem('faraday-intro')) {
            sessionStorage.setItem('faraday-intro', '1');
            d.classList.add('logo-intro');
            setTimeout(function () {
              d.classList.remove('logo-intro');
            }, 1400);
          }
        } catch (e) {}
        window.addEventListener('pagereveal', function (e) {
          var vt = e.viewTransition;
          var nav = window.navigation && window.navigation.activation;
          if (!vt || !vt.types || !nav || nav.navigationType !== 'traverse' || !nav.from || !nav.entry) return;
          if (nav.entry.index < nav.from.index) vt.types.add('back');
        });
      })();
    </script>
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">{common[locale].skip}</a>
    <Header localized={!noindex} />
    {
      showLangHint && (
        <>
          <div class="lang-hint theme-dark" data-lang-hint hidden>
            {hintLocales.map((l) => (
              <div class="container lang-hint__row" data-hint={l} lang={localeMeta[l].lang} dir="rtl" hidden>
                <p class="lang-hint__text">{langHint[l].text}</p>
                <a class="lang-hint__go" href={localizePath(basePath, l)} hreflang={localeMeta[l].hreflang} data-lang-link={l}>
                  {langHint[l].action}
                </a>
                <button type="button" class="lang-hint__close" aria-label={langHint[l].dismiss} data-hint-dismiss>
                  <svg viewBox="0 0 12 12" width="12" height="12" aria-hidden="true">
                    <path d="M1 1l10 10M11 1 1 11" />
                  </svg>
                </button>
              </div>
            ))}
          </div>
          <script is:inline>
            (function () {
              var bar = document.currentScript.previousElementSibling;
              try {
                if (localStorage.getItem('faraday-lang')) return;
                var langs = navigator.languages || [navigator.language || ''];
                var pick = null;
                for (var i = 0; i < langs.length && !pick; i++) {
                  var tag = String(langs[i]).toLowerCase();
                  if (/^ar(-|$)/.test(tag)) pick = 'ar';
                  else if (/^(ckb|ku)(-|$)/.test(tag)) pick = 'ckb';
                }
                if (!pick) return;
                bar.querySelector('[data-hint="' + pick + '"]').hidden = false;
                bar.hidden = false;
                bar.addEventListener('click', function (e) {
                  if (!e.target.closest('[data-hint-dismiss]')) return;
                  localStorage.setItem('faraday-lang', 'en');
                  bar.hidden = true;
                });
              } catch (e) {}
            })();
          </script>
        </>
      )
    }
    <main id="main">
      <slot />
    </main>
    <Footer localized={!noindex} />
    <HelpButton />
    <script>
      import '../lib/italy.ts';
      import '../lib/motion/init.ts';
    </script>
  </body>
</html>

<style>
  .lang-hint {
    border-bottom: 1px solid var(--line-inv);
    background: var(--ink-2);
  }
  .lang-hint__row[hidden] {
    display: none;
  }
  .lang-hint__row {
    display: flex;
    align-items: center;
    gap: var(--s-2) var(--s-5);
    min-height: 48px;
  }
  .lang-hint__text {
    display: inline-flex;
    align-items: center;
    gap: var(--s-3);
    font-size: 0.9375rem;
    line-height: 1.5;
  }
  .lang-hint__text::before {
    content: '';
    flex: none;
    width: 6px;
    height: 6px;
    background: var(--sun);
  }
  .lang-hint__go {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin-inline-start: auto;
    font-size: 0.9375rem;
    font-weight: 600;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 5px;
    white-space: nowrap;
  }
  .lang-hint__close {
    display: grid;
    place-items: center;
    flex: none;
    width: 44px;
    height: 44px;
    margin-inline-end: -12px;
    color: var(--muted-inv);
  }
  .lang-hint__close svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.4;
  }
  .lang-hint__close:hover {
    color: var(--paper);
  }
  @media (max-width: 520px) {
    .lang-hint__text {
      font-size: 0.875rem;
    }
    .lang-hint__go {
      font-size: 0.875rem;
    }
  }
</style>
