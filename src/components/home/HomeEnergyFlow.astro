</style>

<script>
  import { reduceMotion } from '../../lib/motion/init.ts';

  const root = document.querySelector<HTMLElement>('[data-ef]');
  const stage = root?.querySelector<HTMLElement>('[data-ef-stage]');
  const modes = root?.querySelector<HTMLFieldSetElement>('.ef__modes');

  if (root && stage && modes) {
    const radios = [...modes.querySelectorAll<HTMLInputElement>('input[type="radio"]')];
    const dwell = 3800;
    let auto = !reduceMotion;
    let started = false;
    let step = 0;
    let timer = 0;
    let since = 0;
    let left = dwell;

    const stop = () => {
      auto = false;
      window.clearTimeout(timer);
      timer = 0;
      root.classList.remove('is-auto', 'is-held');
    };
    const wait = (ms: number) => {
      left = ms;
      since = performance.now();
      root.classList.remove('is-held');
      timer = window.setTimeout(next, ms);
    };
    function next() {
      timer = 0;
      step += 1;
      const radio = radios[step];
      if (!radio) return stop();
      radio.checked = true;
      if (step >= radios.length - 1) stop();
      else wait(dwell);
    }

    new IntersectionObserver(
      ([entry]) => {
        root.classList.toggle('is-live', entry.isIntersecting);
        if (!auto) return;
        if (entry.isIntersecting && entry.intersectionRatio >= 0.5) {
          if (!started) {
            started = true;
            root.classList.add('is-auto');
            wait(dwell);
          } else if (!timer) wait(left);
        } else if (started && timer) {
          window.clearTimeout(timer);
          timer = 0;
          left = Math.max(0, left - (performance.now() - since));
          root.classList.add('is-held');
        }
      },
      { threshold: [0, 0.5] },
    ).observe(stage);

    modes.addEventListener('change', stop);
    modes.addEventListener('focusin', stop);
  }
</script>
