---
import catalog from '../../data/catalog.json';
import { home } from '../../i18n/home.ts';
import { localizePath, type Locale } from '../../i18n/config.ts';
import { formatPower, rangeRows } from '../company/facts.ts';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = home[locale].flow;

type Mode = 'sun' | 'outage' | 'night';
type NodeKey = 'pv' | 'inverter' | 'battery' | 'home' | 'grid';
type LinkKey = 'pv' | 'battery' | 'home' | 'grid';
type P = [number, number];
type Vars = Record<string, string | number>;

const modes: Mode[] = ['sun', 'outage', 'night'];

const hybrid = rangeRows.find((r) => r.key === 'hybrid');
const hybridPower = hybrid?.power ? formatPower(hybrid.power) : null;
const lfp = catalog.batteries.filter((b) => b.chemistry).every((b) => /LFP|LiFePO4/.test(b.chemistry ?? ''));
const batteryYears = catalog.warranty.batteries.years;

/** Relative power on each link, balanced at the inverter (in = out). Direction 1 flows towards the inverter. */
const flows: Record<LinkKey, Record<Mode, [number, -1 | 0 | 1]>> = {
  pv: { sun: [3, 1], outage: [2, 1], night: [0, 0] },
  battery: { sun: [1, -1], outage: [1, 1], night: [2, 1] },
  home: { sun: [1.5, -1], outage: [3, -1], night: [3, -1] },
  grid: { sun: [0.5, -1], outage: [0, 0], night: [1, 1] },
};

const styleOf = (perMode: Partial<Record<Mode, Vars>>) =>
  Object.entries(perMode)
    .flatMap(([mode, vars]) => Object.entries(vars ?? {}).map(([k, v]) => `--${k}-${mode}:${v}`))
    .join(';');
const flowStyle = (k: LinkKey) =>
  styleOf(
    Object.fromEntries(
      modes.map((m) => {
        const [w, dir] = flows[k][m];
        return [m, { w, on: w > 0 ? 1 : 0, d: dir < 0 ? 'reverse' : 'normal', r: dir < 0 ? '180deg' : '0deg' }];
      }),
    ),
  );
const onIn = (...on: Mode[]) => styleOf(Object.fromEntries(on.map((m) => [m, { on: 1 }])));
const batteryStyle = styleOf({
  sun: { on: 1, lv: 'normal', lvl: 0.85 },
  outage: { on: 1, lv: 'reverse', lvl: 0.6 },
  night: { on: 1, lv: 'reverse', lvl: 0.4 },
});

const statuses: Record<NodeKey, { key: keyof typeof t.status; on: Mode[]; alert?: boolean }[]> = {
  pv: [
    { key: 'producing', on: ['sun', 'outage'] },
    { key: 'dark', on: ['night'] },
  ],
  inverter: [
    { key: 'tied', on: ['sun', 'night'] },
    { key: 'backup', on: ['outage'], alert: true },
  ],
  battery: [
    { key: 'charging', on: ['sun'] },
    { key: 'discharging', on: ['outage', 'night'] },
  ],
  home: [
    { key: 'onSolar', on: ['sun'] },
    { key: 'stays', on: ['outage'], alert: true },
    { key: 'onBattery', on: ['night'] },
  ],
  grid: [
    { key: 'surplus', on: ['sun'] },
    { key: 'down', on: ['outage'], alert: true },
    { key: 'topUp', on: ['night'] },
  ],
};

interface Layout {
  id: 'wide' | 'tall';
  w: number;
  h: number;
  scale: number;
  nodes: Record<NodeKey, P>;
  links: Record<LinkKey, P[]>;
  labels: Record<NodeKey, { at: P; align: 'center' | 'start' }>;
  sun: P;
}

/** Wide: sources on the inline-start side, loads on the end. Tall (phones): the same topology stacked. */
const layouts: Layout[] = [
  {
    id: 'wide',
    w: 1100,
    h: 470,
    scale: 1,
    nodes: { pv: [170, 110], battery: [170, 360], inverter: [550, 235], home: [930, 110], grid: [930, 360] },
    links: {
      pv: [[220, 110], [363, 110], [363, 207], [506, 207]],
      battery: [[220, 360], [363, 360], [363, 263], [506, 263]],
      home: [[880, 110], [737, 110], [737, 207], [594, 207]],
      grid: [[880, 360], [737, 360], [737, 263], [594, 263]],
    },
    labels: {
      pv: { at: [170, 168], align: 'center' },
      battery: { at: [170, 418], align: 'center' },
      inverter: { at: [550, 304], align: 'center' },
      home: { at: [930, 168], align: 'center' },
      grid: { at: [930, 418], align: 'center' },
    },
    sun: [228, 50],
  },
  {
    id: 'tall',
    w: 360,
    h: 540,
    scale: 0.72,
    nodes: { pv: [80, 110], home: [280, 110], inverter: [180, 280], battery: [80, 440], grid: [280, 440] },
    links: {
      pv: [[116, 110], [162, 110], [162, 240]],
      home: [[244, 110], [198, 110], [198, 240]],
      battery: [[116, 440], [162, 440], [162, 320]],
      grid: [[244, 440], [198, 440], [198, 320]],
    },
    labels: {
      pv: { at: [80, 152], align: 'center' },
      home: { at: [280, 152], align: 'center' },
      inverter: { at: [222, 280], align: 'start' },
      battery: { at: [80, 482], align: 'center' },
      grid: { at: [280, 482], align: 'center' },
    },
    sun: [124, 54],
  },
];

const r2 = (n: number) => Math.round(n * 100) / 100;

/** Orthogonal trace through the points, with rounded corners. */
function trace(points: P[], radius = 14) {
  let d = `M${points[0][0]} ${points[0][1]}`;
  for (let i = 1; i < points.length - 1; i++) {
    const [px, py] = points[i - 1];
    const [cx, cy] = points[i];
    const [nx, ny] = points[i + 1];
    const l1 = Math.hypot(cx - px, cy - py);
    const l2 = Math.hypot(nx - cx, ny - cy);
    const k = Math.min(radius, l1 / 2, l2 / 2);
    const a = [cx - ((cx - px) / l1) * k, cy - ((cy - py) / l1) * k].map(r2);
    const b = [cx + ((nx - cx) / l2) * k, cy + ((ny - cy) / l2) * k].map(r2);
    d += ` L${a[0]} ${a[1]} Q${cx} ${cy} ${b[0]} ${b[1]}`;
  }
  const end = points[points.length - 1];
  return `${d} L${end[0]} ${end[1]}`;
}

/** Midpoint and heading of the trace's second segment, where the reduced-motion arrow sits. */
function arrowAt(points: P[]) {
  const [a, b] = [points[1], points[2]];
  return { x: (a[0] + b[0]) / 2, y: (a[1] + b[1]) / 2, angle: (Math.atan2(b[1] - a[1], b[0] - a[0]) * 180) / Math.PI };
}

const linkKeys: LinkKey[] = ['pv', 'battery', 'home', 'grid'];
const nodeKeys: NodeKey[] = ['pv', 'inverter', 'battery', 'home', 'grid'];
const bracket = 'M-50 -38V-50H-38M38 -50H50V-38M50 38V50H38M-38 50H-50V38';
const rays = Array.from({ length: 8 }, (_, i) => {
  const a = (i * Math.PI) / 4;
  return `M${r2(Math.cos(a) * 14)} ${r2(Math.sin(a) * 14)}L${r2(Math.cos(a) * 20)} ${r2(Math.sin(a) * 20)}`;
}).join('');
const pct = (v: number, of: number) => `${r2((v / of) * 100)}%`;
const wide = layouts[0];
const tall = layouts[1];
---

<section class="ef theme-paper section" aria-labelledby="ef-title" data-ef>
  <div class="container">
    <div class="ef__head">
      <div class="ef__heading">
        <p class="eyebrow">{t.eyebrow}</p>
        <h2 id="ef-title" class="h2 ef__title" data-reveal="lines">{t.title}</h2>
      </div>
      <p class="ef__text">{t.text}</p>
    </div>

    <div class="ef__console theme-dark">
      <div class="ef__bar">
        <fieldset class="ef__modes">
          <legend class="sr-only">{t.legend}</legend>
          <span class="ef__thumb" aria-hidden="true"></span>
          {
            modes.map((m, i) => (
              <label class="ef__seg">
                <input class="ef__radio sr-only" type="radio" name="ef-mode" id={`ef-${m}`} value={m} checked={i === 0} />
                <span>{t.modes[m]}</span>
              </label>
            ))
          }
        </fieldset>
        <div class="ef__notes" aria-live="polite">
          {modes.map((m) => <p class:list={['ef__note', `ef__note--${m}`]}>{t.notes[m]}</p>)}
        </div>
      </div>

      <div class="ef__stage" data-ef-stage aria-hidden="true">
        {
          layouts.map((L) => (
            <svg
              class:list={['ef__svg', `ef__svg--${L.id}`]}
              viewBox={`0 0 ${L.w} ${L.h}`}
              width={L.w}
              height={L.h}
              focusable="false"
            >
              <defs>
                <clipPath id={`ef-cells-${L.id}`}>
                  <rect x="-13" y="-27" width="26" height="11" />
                  <rect x="-13" y="-12" width="26" height="11" />
                  <rect x="-13" y="3" width="26" height="11" />
                  <rect x="-13" y="18" width="26" height="11" />
                </clipPath>
              </defs>

              {linkKeys.map((k) => <path class="ef__trace" d={trace(L.links[k])} />)}
              <rect
                class="ef__gap"
                x={(L.links.grid[0][0] + L.links.grid[1][0]) / 2 - 13}
                y={L.links.grid[0][1] - 6}
                width="26"
                height="12"
              />
              {linkKeys.map((k) => <path class:list={['ef__flow ef__v ef__anim', `ef__flow--${k}`]} d={trace(L.links[k])} style={flowStyle(k)} />)}
              {
                linkKeys.map((k) => {
                  const a = arrowAt(L.links[k]);
                  return (
                    <g transform={`translate(${r2(a.x)} ${r2(a.y)}) rotate(${r2(a.angle)})`}>
                      <path class="ef__chev ef__v" d="M-4 -6L4 0L-4 6" style={flowStyle(k)} />
                    </g>
                  );
                })
              }
              <g
                class="ef__switch"
                transform={`translate(${(L.links.grid[0][0] + L.links.grid[1][0]) / 2} ${L.links.grid[0][1]})`}
              >
                <g class="ef__v" style={onIn('sun', 'night')}>
                  <line class="ef__lever" x1="-9" y1="0" x2="9" y2="0" />
                </g>
                <circle cx="-9" cy="0" r="2.6" />
                <circle cx="9" cy="0" r="2.6" />
              </g>

              {
                nodeKeys.map((k) => {
                  const [x, y] = L.nodes[k];
                  return (
                    <g transform={`translate(${x} ${y}) scale(${L.scale})`}>
                      {k !== 'inverter' && <path class="ef__frame" d={bracket} />}
                      {k === 'pv' && (
                        <g class="ef__icon ef__v" style={onIn('sun', 'outage')}>
                          <path d="M-34 -20H34L44 22H-44Z" />
                          <path d="M-11.33 -20L-14.67 22M11.33 -20L14.67 22M-39 1H39" />
                          <path d="M0 22V36M-14 36H14" />
                        </g>
                      )}
                      {k === 'inverter' && (
                        <g class="ef__icon ef__icon--on">
                          <rect x="-44" y="-56" width="88" height="112" rx="6" />
                          <g class="ef__v" style={onIn('outage')}>
                            <rect class="ef__screen" x="-26" y="-40" width="52" height="16" rx="2" />
                          </g>
                          <path d="M-22 6q5.5 -11 11 0t11 0t11 0t11 0" />
                          <path d="M-22 28H22" />
                          <path class="ef__dc" d="M-22 36H22" />
                          <circle class="ef__led ef__anim" cx="30" cy="-46" r="2.6" />
                        </g>
                      )}
                      {k === 'battery' && (
                        <g class="ef__icon ef__icon--on ef__v" style={batteryStyle}>
                          <rect x="-20" y="-32" width="40" height="66" rx="3" />
                          <rect class="ef__cap" x="-8" y="-38" width="16" height="6" rx="1" />
                          <g clip-path={`url(#ef-cells-${L.id})`}>
                            <rect class="ef__cells" x="-13" y="-27" width="26" height="56" />
                            <rect class="ef__level ef__anim" x="-13" y="-27" width="26" height="56" />
                          </g>
                        </g>
                      )}
                      {k === 'home' && (
                        <g class="ef__icon ef__icon--on">
                          <path d="M-42 -2L0 -38L42 -2M-31 -11V34H31V-11" />
                          <path d="M-8 34V12H8V34" />
                          <rect class="ef__window" x="-24" y="-1" width="11" height="11" />
                          <rect class="ef__window" x="13" y="-1" width="11" height="11" />
                        </g>
                      )}
                      {k === 'grid' && (
                        <g class="ef__icon ef__v" style={onIn('sun', 'night')}>
                          <path d="M-16 38L-5 -36H5L16 38M-30 -22H30M-22 -4H22M-11 8L10 24M11 8L-10 24M-9.5 -22L5.5 -4M9.5 -22L-5.5 -4" />
                          <path d="M-30 -22V-16M30 -22V-16M-22 -4V2M22 -4V2" />
                        </g>
                      )}
                    </g>
                  );
                })
              }

              <g transform={`translate(${L.sun[0]} ${L.sun[1]}) scale(${L.scale})`}>
                <g class="ef__sun ef__v" style={onIn('sun', 'outage')}>
                  <circle r="9" />
                  <path d={rays} />
                </g>
                <g class="ef__moon ef__v" style={onIn('night')}>
                  <path d="M6 -8A10 10 0 1 0 6 8A8.9 8.9 0 0 1 6 -8Z" />
                </g>
              </g>
            </svg>
          ))
        }

        <div class="ef__labels">
          {
            nodeKeys.map((k) => {
              const w = wide.labels[k];
              const s = tall.labels[k];
              const style = [
                `--x:${pct(w.at[0], wide.w)}`,
                `--y:${pct(w.at[1], wide.h)}`,
                `--xt:${pct(s.at[0], tall.w)}`,
                `--yt:${pct(s.at[1], tall.h)}`,
                `--tx:${w.align === 'center' ? '-50%' : '0%'}`,
                `--txt:${s.align === 'center' ? '-50%' : '0%'}`,
                `--tyt:${s.align === 'center' ? '0%' : '-50%'}`,
              ].join(';');
              return (
                <div class="ef__label" data-tall={s.align} style={style}>
                  <span class="ef__name">{t.nodes[k]}</span>
                  <span class="ef__states">
                    {statuses[k].map((st) => (
                      <span class:list={['ef__status ef__v', { 'ef__status--alert': st.alert }]} style={onIn(...st.on)}>
                        {t.status[st.key]}
                      </span>
                    ))}
                  </span>
                </div>
              );
            })
          }
        </div>
      </div>

      <div class="ef__foot">
        <dl class="ef__specs">
          {
            hybrid && hybridPower && (
              <div>
                <dt>{t.specs.inverters}</dt>
                <dd>
                  <span class="num">
                    {hybridPower.value}
                    <span class="unit">{hybridPower.unit}</span>
                  </span>
                  <span class="ef__sep" aria-hidden="true" />
                  <span>{t.specs.lines(hybrid.lines)}</span>
                </dd>
              </div>
            )
          }
          <div>
            <dt>{t.specs.storage}</dt>
            <dd>
              {lfp && <span class="mono">LiFePO4</span>}
              {lfp && <span class="ef__sep" aria-hidden="true" />}
              <span>{t.specs.warranty(batteryYears)}</span>
            </dd>
          </div>
        </dl>
        <a class="link-arrow" href={localizePath('/products/hybrid/', locale)}>{t.link}</a>
      </div>
    </div>
  </div>
</section>

<style>
  .ef {
    --flip-x: 1;
    --dwell: 3800ms;
  }
  :global([dir='rtl']) .ef {
    --flip-x: -1;
  }

  .ef__head {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    align-items: end;
    gap: var(--s-5) var(--gap);
    margin-block-end: clamp(var(--s-7), 5vw, var(--s-9));
  }
  .ef__heading {
    display: grid;
    justify-items: start;
    gap: var(--s-4);
  }
  .ef__title {
    max-width: 15ch;
  }
  :global([dir='rtl']) .ef__title {
    max-width: 20ch;
  }
  .ef__text {
    max-width: 46ch;
    color: var(--muted);
  }

  /* ---------- console ---------- */

  .ef__console {
    border-radius: var(--r-2);
    overflow: hidden;
  }
  .ef__bar {
    display: grid;
    grid-template-columns: minmax(0, 27rem) minmax(0, 1fr);
    align-items: center;
    gap: var(--s-4) var(--s-6);
    padding: var(--s-4);
    border-bottom: 1px solid var(--line-inv);
  }

  .ef__modes {
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    min-width: 0;
    margin: 0;
    padding: 3px;
    border: 1px solid var(--line-inv);
    border-radius: var(--r-1);
    background: var(--ink-2);
  }
  .ef__thumb {
    position: absolute;
    inset-block: 3px;
    inset-inline-start: 3px;
    z-index: -1;
    width: calc((100% - 6px) / 3);
    border-radius: 1px;
    background: var(--sun);
    transform: translateX(calc(var(--seg, 0) * 100% * var(--flip-x)));
    transition: transform 560ms var(--ease-out-expo);
  }
  .ef:has(#ef-outage:checked) .ef__thumb {
    --seg: 1;
  }
  .ef:has(#ef-night:checked) .ef__thumb {
    --seg: 2;
  }
  .ef__seg {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 46px;
    padding: var(--s-2) var(--s-3);
    border-radius: 1px;
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1.2;
    text-align: center;
    color: var(--muted-inv);
    cursor: pointer;
    transition: color var(--dur-2) var(--ease);
  }
  .ef__seg:hover {
    color: var(--paper);
  }
  .ef__seg:has(:checked) {
    color: var(--sun-ink);
  }
  .ef__seg:has(:focus-visible) {
    outline: 2px solid var(--sun);
    outline-offset: 3px;
  }
  .ef__seg::after {
    content: '';
    position: absolute;
    inset-inline: var(--s-3);
    inset-block-end: 5px;
    height: 2px;
    background: currentColor;
    opacity: 0.3;
    transform: scaleX(0);
    transform-origin: left center;
  }
  :global([dir='rtl']) .ef__seg::after {
    transform-origin: right center;
  }
  .ef.is-auto .ef__seg:has(:checked)::after {
    animation: ef-progress var(--dwell) linear both;
  }
  .ef.is-held .ef__seg::after {
    animation-play-state: paused;
  }

  .ef__notes {
    display: grid;
  }
  .ef__note {
    grid-area: 1 / 1;
    max-width: 56ch;
    font-size: 1rem;
    line-height: 1.5;
    color: var(--paper);
    opacity: 0;
    visibility: hidden;
    transform: translateY(6px);
    transition:
      opacity var(--dur-2) var(--ease),
      transform var(--dur-3) var(--ease-out-expo),
      visibility 0s linear var(--dur-2);
  }
  .ef:has(#ef-sun:checked) .ef__note--sun,
  .ef:has(#ef-outage:checked) .ef__note--outage,
  .ef:has(#ef-night:checked) .ef__note--night {
    opacity: 1;
    visibility: visible;
    transform: none;
    transition-delay: 80ms, 80ms, 0s;
  }

  /* ---------- stage ---------- */

  .ef__stage {
    --pad-b: clamp(var(--s-3), 2vw, var(--s-6));
    --pad-i: clamp(var(--s-3), 4vw, var(--s-9));
    position: relative;
    padding: var(--pad-b) var(--pad-i);
    background-image:
      linear-gradient(rgb(255 255 255 / 0.035) 1px, transparent 1px),
      linear-gradient(90deg, rgb(255 255 255 / 0.035) 1px, transparent 1px);
    background-size: 44px 44px;
    background-position: center;
  }
  .ef__svg {
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .ef__svg--tall {
    display: none;
  }
  :global([dir='rtl']) .ef__svg {
    transform: scaleX(-1);
  }

  .ef:has(#ef-sun:checked) .ef__v {
    --on: var(--on-sun, 0);
    --w: var(--w-sun, 0);
    --d: var(--d-sun, normal);
    --r: var(--r-sun, 0deg);
    --lv: var(--lv-sun, normal);
    --lvl: var(--lvl-sun, 0.8);
  }
  .ef:has(#ef-outage:checked) .ef__v {
    --on: var(--on-outage, 0);
    --w: var(--w-outage, 0);
    --d: var(--d-outage, normal);
    --r: var(--r-outage, 0deg);
    --lv: var(--lv-outage, normal);
    --lvl: var(--lvl-outage, 0.8);
  }
  .ef:has(#ef-night:checked) .ef__v {
    --on: var(--on-night, 0);
    --w: var(--w-night, 0);
    --d: var(--d-night, normal);
    --r: var(--r-night, 0deg);
    --lv: var(--lv-night, normal);
    --lvl: var(--lvl-night, 0.8);
  }

  .ef__trace {
    fill: none;
    stroke: rgb(255 255 255 / 0.18);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }
  .ef__gap {
    fill: var(--ink);
  }
  .ef__flow {
    fill: none;
    stroke: var(--sun);
    stroke-dasharray: 10 14;
    stroke-width: calc(1px + var(--w) * 1.5px);
    opacity: var(--on);
    transition:
      stroke-width 700ms var(--ease-out-expo),
      opacity 360ms var(--ease);
    animation: ef-flow 0.9s linear infinite;
    animation-direction: var(--d, normal);
  }
  .ef__chev {
    display: none;
    fill: none;
    stroke: var(--sun);
    stroke-width: 2.4;
    stroke-linecap: square;
    opacity: var(--on);
    transform-box: fill-box;
    transform-origin: center;
    rotate: var(--r);
  }

  .ef__switch circle {
    fill: var(--paper);
  }
  .ef__lever {
    stroke: var(--paper);
    stroke-width: 1.8;
    vector-effect: non-scaling-stroke;
    transform-box: fill-box;
    transform-origin: 0% 50%;
    rotate: calc((1 - var(--on)) * -38deg);
    transition: rotate 600ms var(--ease-out-expo);
  }

  .ef__frame {
    fill: none;
