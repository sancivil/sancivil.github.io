---
import ModuleHero from '../three/ModuleHero.astro';
import { home } from '../../i18n/home.ts';
import { company } from '../../i18n/company.ts';
import { localizePath, type Locale } from '../../i18n/config.ts';
import { heroSpec, peakEfficiency, peimar, warranty } from '../company/facts.ts';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = home[locale].hero;
const years = company[locale].years;
---

<section class="hero theme-dark" aria-labelledby="hero-title">
  <div class="hero__stage">
    <ModuleHero spec={heroSpec} />
  </div>

  <div class="container hero__inner">
    <div class="hero__copy">
      <p class="eyebrow eyebrow--dot">{t.eyebrow}</p>
      <h1 id="hero-title" class="display hero__title">{t.title}</h1>
      <p class="lead hero__lead">{t.lead}</p>
      <div class="hero__actions">
        <a class="btn btn--sun" href={localizePath('/designer/', locale)}>{t.ctaDesigner}</a>
        <a class="link-arrow hero__more" href={localizePath('/products/', locale)}>{t.ctaRange}</a>
      </div>
    </div>

    <dl class="hero__specs">
      <div class="hero__spec">
        <dt>{t.specs.efficiency}</dt>
        <dd><span class="num">{(peakEfficiency * 100).toFixed(2)}<span class="unit">%</span></span></dd>
      </div>
      <div class="hero__spec">
        <dt>{t.specs.warranty}</dt>
        <dd><span class="num">{warranty.linearPowerYears}</span><span class="unit">{years}</span></dd>
      </div>
      <div class="hero__spec">
        <dt>{t.specs.capacity}</dt>
        <dd><span class="num">+{peimar.capacityGw}<span class="unit">GW</span></span></dd>
      </div>
      <div class="hero__spec">
        <dt>{t.specs.cells}</dt>
        <dd><span class="num">N-type</span></dd>
      </div>
    </dl>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    display: flex;
    height: calc(100svh - var(--header-h));
    min-height: 600px;
    overflow: hidden;
  }
  .hero__stage {
    position: absolute;
    inset-block: 0;
    inset-inline: 38% 0;
    z-index: 0;
  }
  .hero__inner {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: clamp(var(--s-6), 6svh, var(--s-9));
    padding-block-start: var(--s-7);
    pointer-events: none;
  }
  .hero__copy,
  .hero__specs {
    pointer-events: auto;
  }
  .hero__copy {
    display: grid;
    justify-items: start;
    gap: var(--s-5);
    max-width: 50%;
  }
  .hero__title {
    font-size: clamp(2.5rem, 0.9rem + 4.1vw, 5.25rem);
    line-height: 0.98;
  }
  :global([dir='rtl']) .hero__title {
    font-size: clamp(2.125rem, 0.9rem + 3.1vw, 4.25rem);
    line-height: 1.3;
  }
  .hero__lead {
    max-width: 36ch;
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-4) var(--s-6);
    margin-block-start: var(--s-2);
  }
  .hero__more {
    min-height: 44px;
  }

  .hero__specs {
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-top: 1px solid var(--line-inv);
  }
  .hero__specs::before {
    content: '';
    position: absolute;
    inset-block: 0;
    inset-inline: -50vw;
    z-index: -1;
    background: var(--ink);
    border-top: 1px solid var(--line-inv);
    transform: translateY(-1px);
  }
  .hero__spec {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    gap: var(--s-2);
    padding-block: var(--s-5) clamp(var(--s-5), 4svh, var(--s-7));
    padding-inline: var(--s-5);
  }
  .hero__spec:first-child {
    padding-inline-start: 0;
  }
  .hero__spec + .hero__spec {
    border-inline-start: 1px solid var(--line-inv);
  }
  .hero__spec dt {
    font-size: 0.8125rem;
    line-height: 1.35;
    color: var(--muted-inv);
  }
  .hero__spec dd {
    font-size: clamp(1.375rem, 0.85rem + 1.1vw, 2.125rem);
    line-height: 1.1;
  }

  @media (max-width: 1080px) {
    .hero__copy {
      max-width: 58%;
    }
  }

  @media (max-width: 900px) {
    .hero__stage {
      inset: 0 0 42% 0;
    }
    .hero::after {
      content: '';
      position: absolute;
      inset: 0;
      z-index: 1;
      pointer-events: none;
      background: linear-gradient(to top, var(--ink) 40%, rgb(11 11 12 / 0) 62%);
    }
    .hero__copy {
      max-width: 40rem;
    }
  }

  @media (max-width: 720px) {
    .hero__stage {
      inset: 0 0 50% 0;
    }
    .hero__inner {
      gap: var(--s-5);
    }
    .hero__copy {
      gap: var(--s-4);
    }
    .hero__actions {
      display: grid;
      width: 100%;
      gap: var(--s-1);
    }
    .hero__actions .btn {
      width: 100%;
    }
    .hero__more {
      justify-self: start;
    }
    .hero__specs {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .hero__spec {
      padding-block: var(--s-3);
      gap: 2px;
    }
    .hero__spec:nth-child(odd),
    .hero__spec + .hero__spec:nth-child(odd) {
      padding-inline-start: 0;
      border-inline-start: 0;
    }
    .hero__spec:nth-child(n + 3) {
      border-top: 1px solid var(--line-inv);
    }
    .hero__spec dt {
      font-size: 0.75rem;
    }
  }
</style>
