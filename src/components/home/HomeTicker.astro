---
import { panels, inverters } from '../../lib/designer/data.ts';
import { batteries, families, featured, modules } from '../../content/index.ts';
import { home } from '../../i18n/home.ts';
import type { Locale } from '../../i18n/config.ts';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = home[locale].ticker;

type Item = { code: string; figs: string[]; kind?: string };

const moduleItems: Item[] = modules
  .filter((m) => m.curatedKey !== 'revamping-line')
  .flatMap((m) => {
    const list = panels.filter((p) => m.designerModels.includes(p.id));
    return list.length ? [list.reduce((a, b) => (b.power > a.power ? b : a))] : [];
  })
  .sort((a, b) => b.power - a.power)
  .map((p) => ({
    code: p.model,
    figs: p.efficiency ? [`${p.power} W`, `${(p.efficiency * 100).toFixed(2)}%`] : [`${p.power} W`],
  }));

/* The owner's picks, or this list; either way only what the site shows. */
const tickerInverters = featured.tickerInverters ?? [
  'psi-x1p6000-hy',
  'psi-x3s15000-hy',
  'psi-x3p125000-tpm',
  'psi-x3p30000-hym',
  'psi-x1p1000-mic',
];
const tickerBatteries = featured.tickerBatteries ?? ['psi-x-hs-3-6', 'psi-x-5-8mst-v2'];

const kinds = { hybrid: t.kinds.hybrid, 'on-grid': t.kinds.onGrid, micro: t.kinds.micro };
const shownInverters = new Set(Object.values(families).flatMap((list) => list.flatMap((f) => f.designerModels)));
const inverterItems: Item[] = tickerInverters.flatMap((id) => {
  const inv = shownInverters.has(id) && inverters.find((i) => i.id === id);
  return inv ? [{ code: inv.model, figs: [`${inv.pnomAc / 1000} kW`], kind: kinds[inv.type] }] : [];
});
const batteryItems: Item[] = tickerBatteries.flatMap((slug) => {
  const b = batteries.find((x) => x.slug === slug);
  const kwh = b?.capacity?.nominalKwh ?? b?.capacity?.totalKwh;
  return b && kwh !== undefined
    ? [{ code: b.name, figs: [`${Array.isArray(kwh) ? kwh.join('–') : kwh} kWh`], kind: t.kinds.storage }]
    : [];
});

/* Batteries spread evenly among the inverters: battery k follows inverter floor(k · inverters / batteries). */
const others: Item[] = inverterItems.length
  ? inverterItems.flatMap((inv, i) => [
      inv,
      ...batteryItems.filter((_, k) => Math.floor((k * inverterItems.length) / batteryItems.length) === i),
    ])
  : batteryItems;

const items = moduleItems.flatMap((m, i) => (others[i] ? [m, others[i]] : [m])).concat(others.slice(moduleItems.length));
---

{
  items.length > 0 && (
    <section class="tk theme-dark" aria-label={t.label} data-ticker>
      <div class="tk__viewport">
        <div class="tk__track">
          {
            [0, 1].map((copy) => (
              <ul class="tk__list" role="list" aria-hidden={copy === 1 ? 'true' : undefined}>
                {items.map((item) => (
                  <li class="tk__item">
                    <span class="tk__code mono" dir="ltr">{item.code}</span>
                    {item.figs.map((f) => (
                      <span class="tk__fig num" dir="ltr">{f}</span>
                    ))}
                    {item.kind && <span class="tk__kind">{item.kind}</span>}
                  </li>
                ))}
              </ul>
            ))
          }
        </div>
      </div>
      <button type="button" class="tk__toggle" aria-label={t.pause} data-label-pause={t.pause} data-label-play={t.play}>
        <svg viewBox="0 0 12 12" width="12" height="12" aria-hidden="true">
          <path class="tk__icon-pause" d="M3 2v8M9 2v8"></path>
          <path class="tk__icon-play" d="M3 1.5v9l7.5-4.5z"></path>
        </svg>
      </button>
    </section>
  )
}

<style>
  .tk {
    position: relative;
    display: flex;
    align-items: stretch;
    height: 3.25rem;
    border-block: 1px solid var(--line-inv);
    overflow: hidden;
  }
  .tk__viewport {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    mask-image: linear-gradient(to right, transparent, #000 6%, #000 94%, transparent);
  }
  .tk__track {
    display: flex;
    width: max-content;
    height: 100%;
    animation: tk-run 90s linear infinite;
  }
  :global([dir='rtl']) .tk__track {
    animation-name: tk-run-rtl;
  }
  .tk:hover .tk__track,
  .tk:focus-within .tk__track,
  .tk.is-paused .tk__track,
  .tk.is-off .tk__track {
    animation-play-state: paused;
  }
  @keyframes tk-run {
    to {
      transform: translateX(-50%);
    }
  }
  @keyframes tk-run-rtl {
    to {
      transform: translateX(50%);
    }
  }
  .tk__list {
    display: flex;
    align-items: center;
    flex: none;
  }
  .tk__item {
    display: inline-flex;
    align-items: baseline;
    gap: var(--s-3);
    padding-inline: var(--s-6);
    white-space: nowrap;
    font-size: 0.8125rem;
    line-height: 1;
  }
  .tk__item + .tk__item {
    border-inline-start: 1px solid var(--line-inv);
  }
  .tk__code {
    color: var(--paper);
    letter-spacing: 0.02em;
  }
  .tk__fig {
    color: var(--muted-inv);
  }
  .tk__kind {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted-inv);
  }
  :global([dir='rtl']) .tk__kind {
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    letter-spacing: 0;
    text-transform: none;
  }

  .tk__toggle {
    flex: none;
    display: grid;
    place-items: center;
    width: 3.25rem;
    border-inline-start: 1px solid var(--line-inv);
    color: var(--muted-inv);
    transition: color var(--dur-2) var(--ease);
  }
  .tk__toggle:hover {
    color: var(--paper);
  }
  .tk__toggle:focus-visible {
    outline-offset: -4px;
  }
  .tk__toggle path {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
  }
  .tk__icon-play {
    display: none;
  }
  .tk.is-paused .tk__icon-play {
    display: block;
    fill: currentColor;
    stroke: none;
  }
  .tk.is-paused .tk__icon-pause {
    display: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .tk__track {
      animation: none;
    }
    .tk__toggle {
      display: none;
    }
  }
</style>

<script>
  const band = document.querySelector<HTMLElement>('[data-ticker]');
  const toggle = band?.querySelector<HTMLButtonElement>('.tk__toggle');
  if (band && toggle) {
    toggle.addEventListener('click', () => {
      const paused = band.classList.toggle('is-paused');
      toggle.setAttribute('aria-label', (paused ? toggle.dataset.labelPlay : toggle.dataset.labelPause) ?? '');
    });
    new IntersectionObserver(([entry]) => band.classList.toggle('is-off', !entry.isIntersecting)).observe(band);
  }
</script>
