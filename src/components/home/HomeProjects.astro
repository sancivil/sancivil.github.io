---
import ProjectMedia from '../company/ProjectMedia.astro';
import { home } from '../../i18n/home.ts';
import { company } from '../../i18n/company.ts';
import { localizePath, type Locale } from '../../i18n/config.ts';
import { projectList, projectSpan } from '../company/facts.ts';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = home[locale].projects;
const c = company[locale];
---

{
  projectSpan && (
    <section class="pj theme-light section" aria-labelledby="pj-title">
      <div class="container pj__head">
        <div class="pj__heading">
          <p class="eyebrow">{t.eyebrow}</p>
          <h2 id="pj-title" class="h2" data-reveal="lines">{t.title(projectSpan.count, projectSpan.min, projectSpan.max)}</h2>
        </div>
        <a class="link-arrow pj__all" href={localizePath('/projects/', locale)}>{t.link}</a>
      </div>

      <ul class="pj__row" role="list">
        {
          projectList.map((p, i) => {
            const copy = p.text[locale];
            return (
              <li class:list={['pj__item', { 'pj__item--lg': i < 2, 'pj__item--tile': !p.photo }]}>
                <a class="pj__card" href={localizePath(`/projects/#${p.slug}`, locale)}>
                  <span class="pj__media" data-pj-media={p.photo && i < 2 ? '' : undefined} data-reveal="clip">
                    <ProjectMedia project={p} alt="" />
                    <span class="tag pj__tag">{c.categories[p.category]}</span>
                    {!p.photo && (
                      <span class="pj__tile-word" aria-hidden="true">
                        {c.categories[p.category]}
                      </span>
                    )}
                  </span>
                  <span class="pj__meta">
                    <span class="pj__kwp num">
                      <span data-reveal="count" data-to={p.kwp} data-decimals={Number.isInteger(p.kwp) ? 0 : 1}>
                        {p.kwp}
                      </span>
                      <span class="unit">kWp</span>
                    </span>
                    <span class="pj__title">{copy.title}</span>
                  </span>
                </a>
              </li>
            );
          })
        }
      </ul>
    </section>
  )
}

<style>
  .pj__head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: end;
    gap: var(--s-5) var(--gap);
    margin-block-end: clamp(var(--s-7), 5vw, var(--s-9));
  }
  .pj__heading {
    display: grid;
    justify-items: start;
    gap: var(--s-4);
  }
  .pj__heading .h2 {
    max-width: 16ch;
  }
  :global([dir='rtl']) .pj__heading .h2 {
    max-width: 22ch;
  }
  .pj__all {
    min-height: 44px;
  }

  .pj__row {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: var(--s-8) var(--gap);
    width: 100%;
    max-width: var(--container);
    margin-inline: auto;
    padding-inline: var(--gutter);
  }
  .pj__item {
    grid-column: span 3;
  }
  .pj__item--lg {
    grid-column: span 6;
  }
  .pj__card {
    display: grid;
    gap: var(--s-4);
  }
  .pj__media {
    position: relative;
    display: block;
  }
  .pj__item--lg .pj__media :global(.pmedia) {
    aspect-ratio: 16 / 10;
  }
  .pj__media :global(.pmedia img) {
    transition: scale 1100ms var(--ease-out-expo);
  }
  .pj__media[data-pj-media] :global(.pmedia img) {
    height: 112%;
  }
  .pj__card:hover .pj__media :global(.pmedia img) {
    scale: 1.045;
  }
  .pj__tag {
    position: absolute;
    inset-block-start: var(--s-3);
    inset-inline-start: var(--s-3);
    border-color: transparent;
    background: var(--paper);
    color: var(--ink);
  }
  .pj__item--tile .pj__tag {
    display: none;
  }
  .pj__tile-word {
    position: absolute;
    inset-inline: var(--s-5);
    inset-block-end: var(--s-4);
    font-family: var(--font-display);
    font-size: clamp(2rem, 1rem + 3vw, 4rem);
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 1;
    color: var(--paper);
    pointer-events: none;
  }
  :global([dir='rtl']) .pj__tile-word {
    font-weight: 500;
    letter-spacing: 0;
    line-height: 1.4;
  }
  .pj__tile-word::before {
    content: '';
    display: block;
    width: 8px;
    height: 8px;
    margin-block-end: var(--s-4);
    background: var(--sun);
  }
  .pj__meta {
    display: grid;
    gap: var(--s-2);
    padding-block-start: var(--s-3);
    border-top: 1px solid var(--line);
  }
  .pj__kwp {
    font-size: clamp(2.25rem, 1.3rem + 2.4vw, 3.5rem);
    line-height: 1;
  }
  .pj__item:not(.pj__item--lg) .pj__kwp {
    font-size: clamp(1.75rem, 1.2rem + 1.4vw, 2.5rem);
  }
  .pj__title {
    font-size: 1.0625rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.35;
    max-width: 28ch;
    background: linear-gradient(currentColor, currentColor) 0 100% / 0 1px no-repeat;
    transition: background-size var(--dur-3) var(--ease-out-expo);
    justify-self: start;
  }
  :global([dir='rtl']) .pj__title {
    letter-spacing: 0;
    line-height: 1.6;
    background-position: 100% 100%;
  }
  .pj__card:hover .pj__title {
    background-size: 100% 1px;
  }

  @media (max-width: 1080px) {
    .pj__row {
      gap: var(--s-7) var(--gap);
    }
    .pj__item {
      grid-column: span 6;
    }
    .pj__item--lg .pj__media :global(.pmedia) {
      aspect-ratio: 4 / 3;
    }
  }

  @media (max-width: 900px) {
    .pj__row {
      grid-template-columns: none;
      grid-auto-flow: column;
      grid-auto-columns: min(64vw, 22rem);
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: var(--gutter);
      padding-block-end: var(--s-4);
      scrollbar-width: thin;
    }
    .pj__item,
    .pj__item--lg {
      grid-column: auto;
      scroll-snap-align: start;
    }
    .pj__media[data-pj-media] :global(.pmedia img) {
      height: 100%;
    }
  }

  @media (max-width: 520px) {
    .pj__row {
      grid-auto-columns: 78vw;
    }
  }
</style>

<script>
  import { gsap, reduceMotion } from '../../lib/motion/init.ts';

  if (!reduceMotion) {
    gsap.matchMedia().add('(min-width: 901px)', () => {
      document.querySelectorAll<HTMLElement>('[data-pj-media]').forEach((media) => {
        const img = media.querySelector('img');
        if (!img) return;
        gsap.fromTo(
          img,
          { yPercent: -10 },
          { yPercent: 0, ease: 'none', scrollTrigger: { trigger: media, start: 'top bottom', end: 'bottom top', scrub: true } },
        );
      });
    });
  }
</script>
