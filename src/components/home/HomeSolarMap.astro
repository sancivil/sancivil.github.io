---
import iraq from '../../data/iraq-solar.json';
import { home } from '../../i18n/home.ts';
import { localizePath, type Locale } from '../../i18n/config.ts';
import { iraqMap, project } from './iraq-map.ts';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = home[locale].map;

const fmt = (v: number) => Math.round(v).toLocaleString('en-US');
const yields = iraq.cities.map((c) => c.yieldAnnual);
const min = Math.min(...yields);
const max = Math.max(...yields);
const nameOf = (c: (typeof iraq.cities)[number]) => (locale === 'ar' ? c.nameAr : locale === 'ckb' ? c.nameKu : c.name);
const colour = (k: number) => `hsl(${44 + 4 * k} ${14 + 86 * k}% ${60 - 10 * k}%)`;

const north = [...iraq.cities].sort((a, b) => b.lat - a.lat).map((c) => c.id);
const cities = iraq.cities
  .map((c) => {
    const k = (c.yieldAnnual - min) / (max - min);
    const [x, y] = project(c.lon, c.lat);
    return {
      id: c.id,
      name: nameOf(c),
      yieldText: fmt(c.yieldAnnual),
      tilt: c.optimalTilt,
      href: localizePath(`/solar/${c.id}/`, locale),
      x,
      y,
      r: 7 + 9 * k,
      fill: colour(k),
      order: north.indexOf(c.id),
    };
  })
  .sort((a, b) => Number(b.yieldText.replace(',', '')) - Number(a.yieldText.replace(',', '')));

const office = 'sulaymaniyah';
const labelled = new Set(['mosul', 'erbil', 'baghdad', 'basra', office]);
const { width: W, height: H } = iraqMap;
const latLines = [30, 32, 34, 36].map((lat) => ({ lat, y: project(iraqMap.bbox.minLon, lat)[1] }));
const lonLines = [40, 42, 44, 46, 48].map((lon) => ({ lon, x: project(lon, iraqMap.bbox.minLat)[0] }));
---

<section class="iq theme-dark section" aria-labelledby="iq-title" data-iq>
  <div class="container">
    <div class="iq__head">
      <div class="iq__heading">
        <p class="eyebrow eyebrow--dot">{t.eyebrow}</p>
        <h2 id="iq-title" class="h2 iq__title" data-reveal="lines">{t.title(fmt(min), fmt(max))}</h2>
      </div>
      <div class="iq__aside">
        <p class="iq__text">{t.text(iraq.cities.length)}</p>
        <a class="link-arrow" href={localizePath('/solar/', locale)}>{t.all}</a>
      </div>
    </div>

    <div class="iq__grid">
      <div class="iq__map" data-iq-map>
        <svg class="iq__svg" viewBox={`-40 -20 ${W + 80} ${H + 60}`} role="presentation" aria-hidden="true" focusable="false">
          <defs>
            <clipPath id="iq-clip"><path d={iraqMap.path}></path></clipPath>
            <pattern id="iq-grid" width="18" height="18" patternUnits="userSpaceOnUse">
              <circle cx="9" cy="9" r="1.5"></circle>
            </pattern>
          </defs>
          <g class="iq__graticule">
            {latLines.map((l) => <line x1="-40" x2={W + 40} y1={l.y} y2={l.y} />)}
            {lonLines.map((l) => <line y1="-20" y2={H + 20} x1={l.x} x2={l.x} />)}
          </g>
          <g class="iq__ticks">
            {
              latLines.map((l) => (
                <text x={W + 36} y={l.y - 8} text-anchor="end">
                  {l.lat}°N
                </text>
              ))
            }
            {
              lonLines.map((l) => (
                <text x={l.x + 8} y={H + 34}>
                  {l.lon}°E
                </text>
              ))
            }
          </g>
          <path class="iq__land" d={iraqMap.path}></path>
          <rect class="iq__dots" x="0" y="0" width={W} height={H} fill="url(#iq-grid)" clip-path="url(#iq-clip)"></rect>
          <path class="iq__outline" d={iraqMap.path} pathLength="1"></path>
          {
            cities.map((c) => (
              <a class="iq__city" href={c.href} tabindex="-1" data-city={c.id}>
                <circle class="iq__hit" cx={c.x} cy={c.y} r="26" />
                <circle class="iq__ring" cx={c.x} cy={c.y} r={c.r + 9} />
                <circle class="iq__dot" cx={c.x} cy={c.y} r={c.r} style={`fill:${c.fill};--i:${c.order}`} />
              </a>
            ))
          }
          {
            cities
              .filter((c) => labelled.has(c.id))
              .map((c) => (
                <text
                  class:list={['iq__label', { 'iq__label--office': c.id === office }]}
                  x={c.id === 'mosul' ? c.x - c.r - 12 : c.x + c.r + 12}
                  y={c.y + 7}
                  text-anchor={c.id === 'mosul' ? 'end' : 'start'}
                  direction="ltr"
                >
                  {c.name}
                </text>
              ))
          }
        </svg>
        <div class="iq__tip" data-iq-tip hidden>
          <span class="iq__tip-name" data-tip-name></span>
          <span class="iq__tip-yield"><span class="num" data-tip-yield></span> <span class="iq__tip-unit">{t.unit}</span></span>
          <span class="iq__tip-tilt" data-tip-tilt></span>
        </div>
      </div>

      <div class="iq__side">
        <p class="iq__list-title eyebrow" id="iq-list">{t.list}</p>
        <ol class="iq__list" role="list" aria-labelledby="iq-list">
          {
            cities.map((c, i) => (
              <li>
                <a
                  class="iq__row"
                  href={c.href}
                  data-city={c.id}
                  data-name={c.name}
                  data-yield={c.yieldText}
                  data-tilt={t.tilt(c.tilt)}
                  data-x={(c.x / W) * 100}
                  data-y={(c.y / H) * 100}
                >
                  <span class="iq__rank mono" aria-hidden="true">
                    {String(i + 1).padStart(2, '0')}
                  </span>
                  <span class="iq__swatch" style={`background:${c.fill}`} aria-hidden="true" />
                  <span class="iq__name">
                    {c.name}
                    {c.id === office && <span class="iq__office">{t.office}</span>}
                  </span>
                  <span class="iq__yield num">
                    {c.yieldText}
                    <span class="sr-only"> {t.unit}</span>
                  </span>
                </a>
              </li>
            ))
          }
        </ol>
        <div class="iq__legend" aria-hidden="true">
          <span class="iq__legend-bar"></span>
          <span class="iq__legend-ends">
            <span><span class="num">{fmt(min)}</span> {t.low}</span>
            <span><span class="num">{fmt(max)}</span> {t.high}</span>
          </span>
          <span class="iq__legend-unit">{t.unit}</span>
        </div>
        <p class="iq__source">{t.source}</p>
      </div>
    </div>
  </div>
</section>

<style>
  .iq {
    position: relative;
  }
  .iq__head {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    align-items: end;
    gap: var(--s-5) var(--gap);
    margin-block-end: clamp(var(--s-7), 5vw, var(--s-9));
  }
  .iq__heading {
    display: grid;
    justify-items: start;
    gap: var(--s-4);
  }
  .iq__title {
    max-width: 17ch;
  }
  :global([dir='rtl']) .iq__title {
    max-width: 22ch;
  }
  .iq__aside {
    display: grid;
    justify-items: start;
    gap: var(--s-4);
  }
  .iq__text {
    max-width: 46ch;
    color: var(--muted-inv);
  }

  .iq__grid {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    align-items: start;
    gap: var(--s-8) var(--gap);
  }
  .iq__map {
    position: relative;
  }
  .iq__svg {
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .iq__graticule line {
    stroke: rgb(255 255 255 / 0.07);
    stroke-width: 1;
    stroke-dasharray: 2 6;
    vector-effect: non-scaling-stroke;
  }
  .iq__ticks text {
    font-family: var(--font-mono);
    font-size: 17px;
    fill: var(--muted-inv);
    opacity: 0.7;
  }
  .iq__land {
    fill: var(--ink-2);
  }
  .iq__dots circle {
    fill: rgb(255 255 255 / 0.13);
  }
  .iq__outline {
    fill: none;
    stroke: var(--line-inv-strong);
    stroke-width: 1.25;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }
  .iq__city {
    cursor: pointer;
  }
  .iq__hit {
    fill: transparent;
  }
  .iq__dot {
    stroke: var(--ink);
    stroke-width: 2;
    transform-box: fill-box;
    transform-origin: center;
    transition: scale var(--dur-2) var(--ease);
  }
  .iq__ring {
    fill: none;
    stroke: var(--paper);
    stroke-width: 1.5;
    opacity: 0;
    transform-box: fill-box;
    transform-origin: center;
    scale: 0.6;
    transition:
      opacity var(--dur-2) var(--ease),
      scale var(--dur-3) var(--ease-out-expo);
    vector-effect: non-scaling-stroke;
  }
  .iq__city.is-active .iq__ring {
    opacity: 1;
    scale: 1;
  }
  .iq__city.is-active .iq__dot {
    scale: 1.15;
  }
  :global(html.motion) .iq:not(.is-in) .iq__dot {
    scale: 0;
  }
  .iq.is-in:not(.is-settled) .iq__dot {
    transition: scale 900ms var(--ease-out-expo) calc(450ms + var(--i) * 45ms);
  }
  .iq__label {
    font-family: var(--font-sans);
    font-size: 22px;
    font-weight: 500;
    fill: rgb(255 255 255 / 0.78);
    pointer-events: none;
  }
  .iq__label--office {
    fill: var(--sun);
  }

  .iq__tip {
    position: absolute;
    z-index: 2;
    display: grid;
    gap: 2px;
    min-width: 11rem;
    padding: var(--s-3) var(--s-4);
    border: 1px solid var(--line-inv-strong);
    border-radius: var(--r-1);
    background: var(--ink);
    font-size: 0.8125rem;
    line-height: 1.4;
    color: var(--muted-inv);
    pointer-events: none;
    translate: -50% calc(-100% - 18px);
  }
  .iq__tip[hidden] {
    display: none;
  }
  .iq__tip.is-below {
    translate: -50% 22px;
  }
  .iq__tip-name {
    font-size: 1rem;
    font-weight: 600;
    color: var(--paper);
  }
  .iq__tip-yield .num {
    font-size: 1.125rem;
    color: var(--sun);
  }

  .iq__side {
    display: grid;
    gap: var(--s-5);
  }
  .iq__list {
    columns: 2;
    column-gap: var(--gap);
    border-top: 1px solid var(--line-inv);
  }
  .iq__list li {
    break-inside: avoid;
  }
  .iq__row {
    display: grid;
    grid-template-columns: 1.75rem 8px minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--s-3);
    min-height: 44px;
    border-bottom: 1px solid var(--line-inv);
    font-size: 0.9375rem;
    transition: color var(--dur-1) var(--ease);
  }
  .iq__rank {
    font-size: 0.6875rem;
    color: var(--muted-inv);
  }
  .iq__swatch {
    width: 8px;
    height: 8px;
    border-radius: 50%;
  }
  .iq__name {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 var(--s-2);
    min-width: 0;
  }
  .iq__office {
    font-size: 0.75rem;
    color: var(--sun);
  }
  .iq__yield {
    font-size: 0.875rem;
    color: var(--muted-inv);
  }
  .iq__row:hover,
  .iq__row.is-active {
    color: var(--sun);
  }
  .iq__row:hover .iq__yield,
  .iq__row.is-active .iq__yield {
    color: var(--paper);
  }
  .iq__row:focus-visible {
    outline-offset: 0;
  }

  .iq__legend {
    display: grid;
    gap: var(--s-2);
    max-width: 22rem;
    font-size: 0.75rem;
    color: var(--muted-inv);
  }
  .iq__legend-bar {
    height: 6px;
    border-radius: 3px;
    background: linear-gradient(to right, hsl(44 14% 60%), hsl(46 57% 55%), hsl(48 100% 50%));
  }
  :global([dir='rtl']) .iq__legend-bar {
    background: linear-gradient(to left, hsl(44 14% 60%), hsl(46 57% 55%), hsl(48 100% 50%));
  }
  .iq__legend-ends {
    display: flex;
    justify-content: space-between;
    gap: var(--s-4);
  }
  .iq__legend-ends .num {
    color: var(--paper);
  }
  .iq__source {
    max-width: 44ch;
    font-size: 0.75rem;
    line-height: 1.5;
    color: var(--muted-inv);
  }

  :global(html.motion) .iq:not(.is-in) .iq__outline {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
  }
  .iq.is-in .iq__outline {
    stroke-dasharray: 1;
    animation: iq-draw 2400ms var(--ease-out-expo) both;
  }
  @keyframes iq-draw {
    from {
      stroke-dashoffset: 1;
    }
    to {
      stroke-dashoffset: 0;
    }
  }

  @media (max-width: 1080px) {
    .iq__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
    .iq__list {
      columns: 1;
    }
  }

  @media (max-width: 900px) {
    .iq__head,
    .iq__grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .iq__map {
      max-width: 36rem;
      width: 100%;
      justify-self: center;
    }
    .iq__list {
      columns: 2;
    }
  }

  @media (max-width: 520px) {
    .iq__list {
      column-gap: var(--s-4);
    }
    .iq__row {
      grid-template-columns: 8px minmax(0, 1fr) auto;
      gap: var(--s-2);
      font-size: 0.875rem;
    }
    .iq__rank,
    .iq__office {
      display: none;
    }
    .iq__yield {
      font-size: 0.8125rem;
    }
    .iq__label {
      font-size: 30px;
    }
  }
</style>

<script>
  import { gsap, ScrollTrigger, reduceMotion } from '../../lib/motion/init.ts';

  const section = document.querySelector<HTMLElement>('[data-iq]');
  const map = section?.querySelector<HTMLElement>('[data-iq-map]');
  const tip = section?.querySelector<HTMLElement>('[data-iq-tip]');

  if (section && map && tip) {
    const rows = new Map(
      [...section.querySelectorAll<HTMLAnchorElement>('.iq__row')].map((row) => [row.dataset.city ?? '', row]),
    );
    const dots = new Map(
      [...section.querySelectorAll<SVGAElement>('.iq__city')].map((dot) => [dot.dataset.city ?? '', dot]),
    );
    const name = tip.querySelector<HTMLElement>('[data-tip-name]');
    const yieldEl = tip.querySelector<HTMLElement>('[data-tip-yield]');
    const tilt = tip.querySelector<HTMLElement>('[data-tip-tilt]');
    let active = '';

    const show = (id: string) => {
      const row = rows.get(id);
      if (!row || !name || !yieldEl || !tilt) return;
      if (active) {
        rows.get(active)?.classList.remove('is-active');
        dots.get(active)?.classList.remove('is-active');
      }
      active = id;
      row.classList.add('is-active');
      dots.get(id)?.classList.add('is-active');
      name.textContent = row.dataset.name ?? '';
      yieldEl.textContent = row.dataset.yield ?? '';
      tilt.textContent = row.dataset.tilt ?? '';
      const svg = map.querySelector('svg');
      const box = svg?.viewBox.baseVal;
      const circle = dots.get(id)?.querySelector<SVGCircleElement>('.iq__dot');
      if (!box || !circle) return;
      const x = ((circle.cx.baseVal.value - box.x) / box.width) * 100;
      const y = ((circle.cy.baseVal.value - box.y) / box.height) * 100;
      tip.style.left = `${Math.min(Math.max(x, 14), 86)}%`;
      tip.style.top = `${y}%`;
      tip.classList.toggle('is-below', y < 18);
      tip.hidden = false;
    };
    const hide = () => {
      if (!active) return;
      rows.get(active)?.classList.remove('is-active');
      dots.get(active)?.classList.remove('is-active');
      active = '';
      tip.hidden = true;
    };

    rows.forEach((row, id) => {
      row.addEventListener('pointerenter', () => show(id));
      row.addEventListener('focus', () => show(id));
      row.addEventListener('pointerleave', hide);
      row.addEventListener('blur', hide);
    });
    dots.forEach((dot, id) => {
      dot.addEventListener('pointerenter', (e) => {
        if (e.pointerType === 'mouse') show(id);
      });
      dot.addEventListener('pointerleave', (e) => {
        if (e.pointerType === 'mouse') hide();
      });
      dot.addEventListener('click', (e) => {
        if (active === id) return;
        e.preventDefault();
        show(id);
      });
    });
    document.addEventListener('pointerdown', (e) => {
      if (active && !(e.target as Element).closest('.iq__city, .iq__row')) hide();
    });

    if (reduceMotion) {
      section.classList.add('is-in');
    } else {
      ScrollTrigger.create({
        trigger: map,
        start: 'top 75%',
        once: true,
        onEnter: () => {
          section.classList.add('is-in');
          window.setTimeout(() => section.classList.add('is-settled'), 2600);
        },
      });
      gsap.fromTo(
        section,
        { clipPath: 'inset(0% 3% 0% 3% round 8px)' },
        {
          clipPath: 'inset(0% 0% 0% 0% round 0px)',
          ease: 'none',
          scrollTrigger: { trigger: section, start: 'top bottom', end: 'top 35%', scrub: true },
        },
      );
    }
  }
</script>
