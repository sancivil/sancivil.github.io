---
/* Generic hybrid topology: PV array → hybrid inverter → battery, home loads and grid. Laid out with logical CSS, so it mirrors in RTL. */
import type { Locale } from '../../i18n/config.ts';
import { products } from '../../i18n/products.ts';

interface Props {
  locale: Locale;
}
const d = products[Astro.props.locale].detail;
const icon = {
  pv: '<path d="M6 30 L14 8 H42 L34 30 Z" /><path d="M10 19 H38 M13 8 L6 30 M24 8 L20 30 M33 8 L28 30" class="thin" />',
  inverter: '<rect x="10" y="4" width="28" height="30" rx="3" /><rect x="17" y="12" width="14" height="8" class="thin" /><path d="M16 38 V34 M32 38 V34" />',
  battery: '<rect x="12" y="8" width="24" height="28" rx="2" /><path d="M20 4 H28 M12 17 H36 M12 26 H36" class="thin" />',
  loads: '<path d="M6 20 L24 6 L42 20" /><path d="M11 17 V36 H37 V17" /><path d="M21 36 V26 H27 V36" class="thin" />',
  grid: '<path d="M24 4 L14 38 M24 4 L34 38 M17 26 H31 M15 14 H33 M19 14 L29 26 M29 14 L19 26" />',
};
type Key = keyof typeof icon;
const outputs: { key: Key; flow: string }[] = [
  { key: 'battery', flow: 'DC' },
  { key: 'loads', flow: 'AC' },
  { key: 'grid', flow: 'AC' },
];
---

<figure class="sysdia">
  <div class="sysdia__map">
    <div class="sysdia__node sysdia__node--pv">
      <svg viewBox="0 0 48 42" aria-hidden="true" set:html={icon.pv} />
      <span>{d.node.pv}</span>
    </div>
    <div class="sysdia__link sysdia__link--in" aria-hidden="true"><span class="mono">DC</span></div>
    <div class="sysdia__node sysdia__node--core">
      <svg viewBox="0 0 48 42" aria-hidden="true" set:html={icon.inverter} />
      <span>{d.node.inverter}</span>
    </div>
    <ul role="list" class="sysdia__outs">
      {
        outputs.map((o) => (
          <li class="sysdia__out">
            <span class="sysdia__link sysdia__link--out" aria-hidden="true">
              <span class="mono">{o.flow}</span>
            </span>
            <span class="sysdia__node">
              <svg viewBox="0 0 48 42" aria-hidden="true" set:html={icon[o.key]} />
              <span>{d.node[o.key]}</span>
            </span>
          </li>
        ))
      }
    </ul>
  </div>
  <figcaption class="sysdia__note small">{d.systemNote}</figcaption>
</figure>

<style>
  .sysdia {
    display: grid;
    gap: var(--s-5);
  }
  .sysdia__map {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(48px, 0.7fr) minmax(0, 1.1fr) minmax(0, 2fr);
    align-items: center;
    padding: clamp(20px, 3vw, 40px);
    background: var(--surface);
    border-radius: var(--r-2);
  }
  .sysdia__node {
    display: grid;
    justify-items: center;
    gap: var(--s-2);
    padding: var(--s-4) var(--s-3);
    background: var(--paper);
    border: 1px solid var(--line-c);
    border-radius: var(--r-2);
    text-align: center;
    font-size: 0.875rem;
    font-weight: 500;
    line-height: 1.3;
  }
  :global(.theme-dark) .sysdia__node {
    background: var(--ink-3);
  }
  .sysdia__node svg {
    inline-size: 44px;
    block-size: 38px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linejoin: round;
    stroke-linecap: round;
  }
  .sysdia__node svg :global(.thin) {
    stroke-width: 1.25;
  }
  .sysdia__node--core {
    border-color: currentColor;
    box-shadow: inset 0 -3px 0 var(--sun);
  }
  .sysdia__link {
    position: relative;
    display: grid;
    place-items: center;
    block-size: 2px;
    background: currentColor;
  }
  .sysdia__link::after {
    content: '';
    position: absolute;
    inset-inline-end: -1px;
    inset-block-start: 50%;
    inline-size: 8px;
    block-size: 8px;
    border-block-start: 2px solid currentColor;
    border-inline-end: 2px solid currentColor;
    transform: translateY(-50%) rotate(45deg);
  }
  :global([dir='rtl']) .sysdia__link::after {
    transform: translateY(-50%) rotate(-45deg);
  }
  .sysdia__link .mono {
    position: absolute;
    inset-block-end: 8px;
    font-size: 0.6875rem;
    color: var(--muted-c);
  }
  .sysdia__outs {
    display: grid;
    gap: var(--s-3);
    position: relative;
    padding-inline-start: var(--s-5);
    border-inline-start: 2px solid currentColor;
  }
  .sysdia__out {
    display: grid;
    grid-template-columns: minmax(40px, 0.6fr) minmax(0, 1.4fr);
    align-items: center;
    margin-inline-start: calc(-1 * var(--s-5));
  }
  .sysdia__out .sysdia__node {
    grid-template-columns: auto minmax(0, 1fr);
    justify-items: start;
    text-align: start;
    gap: var(--s-3);
    padding-block: var(--s-3);
  }
  .sysdia__out .sysdia__node svg {
    inline-size: 34px;
    block-size: 30px;
  }
  .sysdia__out:first-child .sysdia__link--out::before {
    content: '';
    position: absolute;
    inset-inline-start: 6px;
    inset-block-start: -8px;
    inline-size: 8px;
    block-size: 8px;
    border-block-end: 2px solid currentColor;
    border-inline-start: 2px solid currentColor;
    transform: rotate(45deg);
  }
  :global([dir='rtl']) .sysdia__out:first-child .sysdia__link--out::before {
    transform: rotate(-45deg);
  }
  .sysdia__note {
    max-width: 68ch;
    color: var(--muted-c);
  }
  @media (max-width: 720px) {
    .sysdia__map {
      grid-template-columns: minmax(0, 1fr);
      justify-items: stretch;
      gap: 0;
    }
    .sysdia__link--in {
      inline-size: 2px;
      block-size: 36px;
      justify-self: center;
    }
    .sysdia__link--in::after {
      inset-inline-end: auto;
      inset-block-start: auto;
      inset-block-end: -1px;
      transform: translateX(-50%) rotate(135deg);
      inset-inline-start: 50%;
    }
    :global([dir='rtl']) .sysdia__link--in::after {
      transform: translateX(50%) rotate(135deg);
    }
    .sysdia__link--in .mono {
      inset-block-end: auto;
      inset-inline-start: 10px;
    }
    .sysdia__outs {
      margin-block-start: var(--s-5);
    }
  }
</style>
