---
/**
 * The company's logo: the owner's own logo file, trimmed and resized only (public/brand). The header and footer are
 * dark, so they take the copy whose letters are white ("light"); "dark" is the original, black letters.
 */
interface Props {
  class?: string;
  /** Empty for a decorative copy (the footer's), so it is not announced twice. */
  title?: string;
  tone?: 'light' | 'dark';
  /** How wide the logo is drawn, for choosing between the 1200 and 2400 px files. */
  sizes?: string;
  loading?: 'eager' | 'lazy';
}
const { class: className, title = 'Faraday', tone = 'light', sizes = '132px', loading = 'eager' } = Astro.props;
const file = tone === 'light' ? '/brand/faraday-logo-light' : '/brand/faraday-logo';
---

<img
  class:list={['logo', className]}
  src={`${file}-1200.png`}
  srcset={`${file}-1200.png 1200w, ${file}-2400.png 2400w`}
  sizes={sizes}
  width="1200"
  height="311"
  alt={title}
  loading={loading}
  decoding="async"
/>

<style>
  .logo {
    display: block;
    width: 100%;
    height: auto;
  }
</style>
