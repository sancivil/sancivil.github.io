---
interface Props {
  class?: string;
  title?: string;
}
const { class: className, title = 'Faraday' } = Astro.props;
const clipId = `fw-cap-${Math.random().toString(36).slice(2, 8)}`;
---

<svg class:list={['logo', className]} viewBox="0 -3.5 287 53.5" role="img" aria-label={title}>
  <defs>
    <clipPath id={clipId}><rect x="-2" y="8.6" width="291" height="36.7"></rect></clipPath>
  </defs>
  <g
    fill="none"
    stroke="currentColor"
    stroke-width="3.9"
    stroke-linejoin="miter"
    stroke-miterlimit="10"
    clip-path={`url(#${clipId})`}
  >
    <path d="M1.55 8 V46 M0 10.5 H27.6 M0 33.2 H23.1"></path>
    <path d="M31.8 48 L49.9 12.5 L68.8 48 M31 43.45 H50.6"></path>
    <path d="M81.55 8 V46 M80 10.5 H92.5 A11.3 11.3 0 0 1 92.5 33.1 H86 M89.5 33.5 L104 48"></path>
    <path
      d="M181.55 8 V46 M180 10.45 H199.5 C207.2 10.45 211.75 15 211.75 22.5 V31.4 C211.75 38.9 207.2 43.45 199.5 43.45 H180"
    ></path>
    <path d="M221.4 48 L239.5 12.5 L258.4 48 M238.8 43.45 H259.2"></path>
    <path d="M260.2 5.5 L273.9 33.8 L287.9 5.5 M273.9 33 V48"></path>
  </g>
  <path
    d="M116.4 50.5 L141.3 3.55 L166.7 50.5"
    fill="none"
    stroke="var(--sun, #FFCC00)"
    stroke-width="6.2"
    stroke-linejoin="miter"
    stroke-miterlimit="10"></path>
  <path d="M141.6 33.4 L151.8 50.5 H131.4 Z" fill="var(--sun, #FFCC00)"></path>
</svg>

<style>
  .logo {
    height: auto;
    overflow: visible;
  }
</style>
