---
/* The owner's social profiles (company.socials in the content), each with its network's line icon. */
import { socials } from '../content/index.ts';
import type { SocialNetwork } from '../content/contract.ts';

interface Props {
  /** Shows each network's name beside its icon; without it the name is the link's accessible label. */
  named?: boolean;
}

const { named = false } = Astro.props;

/* 20 × 20 line icons in the style of the menu's call, WhatsApp and email icons. Brand marks keep their shape in RTL. */
const networks: Record<SocialNetwork, { name: string; icon: string }> = {
  facebook: { name: 'Facebook', icon: '<circle cx="10" cy="10" r="7.4"/><path d="M12.8 6.9h-1.1a2 2 0 0 0-2 2v8.5M7.7 10.9h4.6"/>' },
  instagram: {
    name: 'Instagram',
    icon: '<rect x="3.2" y="3.2" width="13.6" height="13.6" rx="4"/><circle cx="10" cy="10" r="3.2"/><circle cx="14" cy="6" r=".4"/>',
  },
  tiktok: { name: 'TikTok', icon: '<path d="M11.2 3.2v9.4a3 3 0 1 1-3-3M11.2 3.2a4.1 4.1 0 0 0 4.1 4.1"/>' },
  youtube: { name: 'YouTube', icon: '<rect x="2.6" y="4.9" width="14.8" height="10.2" rx="3"/><path d="M8.6 7.9v4.2l3.6-2.1Z"/>' },
  linkedin: {
    name: 'LinkedIn',
    icon: '<rect x="3.2" y="3.2" width="13.6" height="13.6" rx="2"/><path d="M6.9 9v4.6M6.9 6.6v.01M9.6 13.6V9M9.6 11a2 2 0 0 1 4 0v2.6"/>',
  },
  telegram: { name: 'Telegram', icon: '<path d="M17.4 3.4 2.6 9.3l5.1 1.8 1.7 5.3 2.7-3.1 3.6 2.6ZM7.7 11.1l7.1-5.3-5.4 6.3"/>' },
  x: { name: 'X', icon: '<path d="M3.8 3.8h3.4l9 12.4h-3.4ZM16 3.8l-5.1 5.6M9.1 10.6 4 16.2"/>' },
};
---

{
  socials.length > 0 && (
    <ul class:list={['social', { 'social--named': named }]} role="list">
      {socials.map(({ network, url }) => (
        <li>
          <a class="social__link" href={url} rel="noopener" target="_blank" aria-label={named ? undefined : networks[network].name}>
            <svg
              viewBox="0 0 20 20"
              width="20"
              height="20"
              fill="none"
              stroke="currentColor"
              stroke-width="1.4"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              focusable="false"
              set:html={networks[network].icon}
            />
            {named && <span>{networks[network].name}</span>}
          </a>
        </li>
      ))}
    </ul>
  )
}

<style>
  .social {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
  }
  .social__link {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1px solid var(--line-c);
    border-radius: var(--r-1);
    color: var(--muted-c);
    transition:
      color var(--dur-1) var(--ease),
      border-color var(--dur-1) var(--ease);
  }
  .social__link:hover {
    color: inherit;
    border-color: var(--line-c-strong);
  }
  .social__link svg {
    flex: none;
  }

  .social--named {
    gap: var(--s-1) var(--s-6);
  }
  .social--named .social__link {
    display: inline-flex;
    align-items: center;
    gap: var(--s-3);
    width: auto;
    height: auto;
    min-height: 44px;
    border: 0;
    color: inherit;
    font-size: 1.25rem;
    line-height: 1.3;
    text-decoration-line: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
    transition: text-decoration-color var(--dur-2) var(--ease);
  }
  .social--named .social__link:hover {
    text-decoration-color: currentColor;
  }
</style>
