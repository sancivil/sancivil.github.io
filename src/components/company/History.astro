---
import history from '../../data/history.json';
import { company, type MilestoneKey } from '../../i18n/company.ts';
import type { Locale } from '../../i18n/config.ts';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = company[locale].about.history;

const milestones = [...history]
  .sort((a, b) => a.year - b.year)
  .map(({ year, key }) => {
    const copy = t.milestones[key as MilestoneKey];
    if (!copy) throw new Error(`src/data/history.json: "${key}" needs about.history.milestones strings in src/i18n/company.ts`);
    return { year, ...copy };
  });
---

<section class="hist theme-paper section" aria-labelledby="hist-title" data-history style={`--n: ${milestones.length + 1}`}>
  <div class="container">
    <div class="hist__head">
      <p class="eyebrow eyebrow--dot">{t.eyebrow}</p>
      <h2 id="hist-title" class="h2">{t.title(milestones[0].year)}</h2>
    </div>
    <ol class="hist__list" role="list">
      {
        milestones.map((m, i) => (
          <li class="hist__item" style={`--i: ${i}`}>
            <p class="hist__year">
              <time class="num" datetime={String(m.year)}>{m.year}</time>
            </p>
            <span class="hist__rail" aria-hidden="true">
              <span class="hist__mark" />
            </span>
            <h3 class="hist__title">{m.title}</h3>
            <p class="hist__text">{m.text}</p>
          </li>
        ))
      }
      <li class="hist__item hist__item--now" style={`--i: ${milestones.length}`}>
        <p class="hist__year"><span class="hist__now">{t.today.label}</span></p>
        <span class="hist__rail" aria-hidden="true">
          <span class="hist__mark" />
        </span>
        <h3 class="hist__title">{t.today.title}</h3>
        <p class="hist__text">{t.today.text}</p>
      </li>
    </ol>
  </div>
</section>

<style>
  /* --p (0..1) is the draw progress of the whole track; each step reads its own share as --t. */
  .hist {
    --p: 1;
    --mark: 11px;
  }
  :global(html.motion:not(.motion-ready)) .hist {
    --p: 0;
  }
  .hist__head {
    display: grid;
    justify-items: start;
    gap: var(--s-4);
    margin-block-end: clamp(var(--s-8), 8vw, var(--s-10));
  }
  .hist__list {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(0, 1fr);
  }
  .hist__item {
    --t: clamp(0, var(--p) * var(--n) - var(--i), 1);
    container-type: inline-size;
    display: grid;
    align-content: start;
    justify-items: start;
  }

  /* A fixed-height slot keeps every column's rail on one line, whatever script the label is in. */
  .hist__year {
    display: flex;
    align-items: center;
    height: 1.15em;
    overflow: clip;
    font-family: var(--font-mono);
    font-size: clamp(2.75rem, 24cqi, 7rem);
    font-weight: 400;
    line-height: 1;
  }
  .hist__year > * {
    transform: translateY(calc((1 - min(1, var(--t) * 3)) * 115%));
  }
  .hist__year .num {
    letter-spacing: -0.045em;
  }
  .hist__now {
    color: var(--muted);
    letter-spacing: -0.03em;
  }
  :global([dir='rtl']) .hist__now {
    font-family: var(--font-display);
    font-size: 0.78em;
    font-weight: 500;
    letter-spacing: 0;
    line-height: 1.4;
  }

  .hist__rail {
    position: relative;
    justify-self: stretch;
    height: var(--mark);
    margin-block: var(--s-5) var(--s-6);
  }
  .hist__rail::before,
  .hist__rail::after {
    content: '';
    position: absolute;
    inset-inline: 0;
    top: calc(50% - 0.5px);
    height: 1px;
  }
  .hist__rail::before {
    background: var(--line);
  }
  .hist__rail::after {
    background: var(--ink);
    clip-path: inset(0 calc((1 - var(--t)) * 100%) 0 0);
  }
  :global([dir='rtl']) .hist__rail::after {
    clip-path: inset(0 0 0 calc((1 - var(--t)) * 100%));
  }
  .hist__mark {
    position: absolute;
    z-index: 1;
    top: 0;
    inset-inline-start: 0;
    width: var(--mark);
    height: var(--mark);
    border: 1px solid var(--ink);
    background: var(--sun);
    transform: scale(min(1, var(--t) * 5));
  }

  /* The present stays open: a dashed track that fades out, and a ring around the marker. */
  .hist__item--now .hist__rail::before {
    display: none;
  }
  .hist__item--now .hist__rail::after {
    background: repeating-linear-gradient(90deg, var(--ink) 0 4px, transparent 4px 9px);
    mask-image: linear-gradient(90deg, #000 25%, transparent 92%);
  }
  :global([dir='rtl']) .hist__item--now .hist__rail::after {
    background: repeating-linear-gradient(270deg, var(--ink) 0 4px, transparent 4px 9px);
    mask-image: linear-gradient(270deg, #000 25%, transparent 92%);
  }
  .hist__item--now .hist__mark::after {
    content: '';
    position: absolute;
    inset: -7px;
    border: 1px solid var(--ink);
  }

  .hist__title {
    padding-inline-end: var(--s-6);
    font-size: 1.1875rem;
    font-weight: 600;
    line-height: 1.35;
    text-wrap: balance;
  }
  .hist__text {
    max-width: 34ch;
    margin-block-start: var(--s-2);
    padding-inline-end: var(--s-6);
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--muted);
    text-wrap: pretty;
  }
  :global([dir='rtl']) .hist__title {
    line-height: 1.6;
  }
  :global([dir='rtl']) .hist__text {
    line-height: 1.85;
  }

  /* Tablets portrait and phones: the track runs down the inline-start edge. */
  @media (max-width: 900px) {
    .hist__list {
      grid-auto-flow: row;
    }
    .hist__item {
      --year: clamp(2.75rem, 1.9rem + 4vw, 4.25rem);
      --mark-top: calc(var(--year) * 0.53 - var(--mark) / 2);
      container-type: normal;
      position: relative;
      padding-inline-start: calc(var(--mark) + var(--s-5));
      padding-block-end: var(--s-8);
    }
    .hist__year {
      font-size: var(--year);
    }
    .hist__rail {
      position: absolute;
      inset-block: 0;
      inset-inline-start: 0;
      width: var(--mark);
      height: auto;
      margin: 0;
    }
    .hist__rail::before,
    .hist__rail::after {
      inset-inline: calc(50% - 0.5px) auto;
      top: calc(var(--mark-top) + var(--mark) / 2);
      bottom: calc(-1 * var(--mark-top) - var(--mark) / 2);
      width: 1px;
      height: auto;
    }
    .hist__rail::after,
    :global([dir='rtl']) .hist__rail::after {
      clip-path: inset(0 0 calc((1 - var(--t)) * 100%) 0);
    }
    .hist__mark {
      top: var(--mark-top);
    }
    .hist__item--now .hist__rail::after,
    :global([dir='rtl']) .hist__item--now .hist__rail::after {
      bottom: 0;
      background: repeating-linear-gradient(180deg, var(--ink) 0 4px, transparent 4px 9px);
      mask-image: linear-gradient(180deg, #000 25%, transparent 92%);
    }
    .hist__title,
    .hist__text {
      padding-inline-end: 0;
    }
    .hist__text {
      max-width: 44ch;
    }
  }

  @media (min-width: 521px) and (max-width: 900px) {
    .hist__item {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      column-gap: var(--gap);
    }
    .hist__year {
      grid-row: 1 / span 2;
    }
    .hist__title {
      grid-column: 2;
      padding-block-start: calc(var(--year) * 0.2);
    }
    .hist__text {
      grid-column: 2;
    }
  }

  @media (max-width: 520px) {
    .hist__year {
      margin-block-end: var(--s-3);
    }
  }
</style>

<script>
  import { gsap, reduceMotion } from '../../lib/motion/init.ts';

  if (!reduceMotion) {
    document.querySelectorAll<HTMLElement>('[data-history]').forEach((section) => {
      const list = section.querySelector('.hist__list');
      const steps = Number(section.style.getPropertyValue('--n')) || 1;
      gsap.matchMedia().add({ wide: '(min-width: 901px)', narrow: '(max-width: 900px)' }, (context) => {
        const { wide } = context.conditions as { wide: boolean };
        gsap.fromTo(
          section,
          { '--p': 0 },
          wide
            ? { '--p': 1, duration: 0.6 * steps, ease: 'power2.inOut', scrollTrigger: { trigger: list, start: 'top 78%', once: true } }
            : { '--p': 1, ease: 'none', scrollTrigger: { trigger: list, start: 'top 75%', end: 'bottom 60%', scrub: 0.6 } },
        );
      });
    });
  }
</script>
