---
import Logo from './Logo.astro';
import MegaMenu from './header/MegaMenu.astro';
import LangMenu from './header/LangMenu.astro';
import MobileMenu from './header/MobileMenu.astro';
import { nav } from '../data/site.ts';
import { common } from '../i18n/common.ts';
import { localeFromPath, localizePath, stripLocale } from '../i18n/config.ts';

interface Props {
  localized?: boolean;
}

const { localized = true } = Astro.props;
const path = Astro.url.pathname;
const locale = localeFromPath(path);
const t = common[locale];
const basePath = stripLocale(path);
const switchPath = localized ? basePath : '/';
const isCurrent = (href: string) => basePath.startsWith(href);
const href = (p: string) => localizePath(p, locale);
---

<header class="site-header theme-dark" data-header>
  <div class="container site-header__inner">
    <a href={href('/')} class="site-header__logo" aria-label={t.home} dir="ltr">
      <Logo title="Faraday" />
    </a>

    <nav class="site-nav" aria-label={t.primaryNav}>
      <ul role="list">
        {
          nav.map((item) =>
            item.key === 'products' ? (
              <li data-mega>
                <button
                  type="button"
                  class:list={['site-nav__link', { 'is-current': isCurrent(item.href) }]}
                  aria-expanded="false"
                  aria-controls="mega-products"
                  data-mega-trigger
                >
                  {t.nav[item.key]}
                  <svg class="site-nav__chevron" viewBox="0 0 10 6" width="10" height="6" aria-hidden="true">
                    <path d="M1 1l4 4 4-4" />
                  </svg>
                </button>
                <MegaMenu locale={locale} basePath={basePath} />
              </li>
            ) : (
              <li>
                <a
                  href={href(item.href)}
                  class:list={['site-nav__link', { 'is-accent': item.accent }]}
                  aria-current={isCurrent(item.href) ? 'page' : undefined}
                >
                  {t.nav[item.key]}
                </a>
              </li>
            ),
          )
        }
      </ul>
    </nav>

    <div class="site-header__actions">
      <LangMenu locale={locale} switchPath={switchPath} />
      <a class="btn btn--sun site-header__cta" href={href('/contact/')}>{t.getQuote}</a>
      <button
        class="site-header__toggle"
        type="button"
        aria-expanded="false"
        aria-controls="mobile-menu"
        data-menu-toggle
        data-label-open={t.menuOpen}
        data-label-close={t.menuClose}
      >
        <span class="sr-only">{t.menuOpen}</span>
        <span class="site-header__burger" aria-hidden="true"><i></i><i></i></span>
      </button>
    </div>
  </div>

  <div class="site-header__scrim" aria-hidden="true"></div>
  <MobileMenu locale={locale} basePath={basePath} switchPath={switchPath} />
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    height: var(--header-h);
    background: transparent;
    transition: transform var(--dur-3) var(--ease-out-expo);
  }
  .site-header::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background-color: var(--ink);
    border-bottom: 1px solid var(--line-inv);
    transition:
      opacity var(--dur-2) var(--ease),
      background-color var(--dur-2) var(--ease);
  }
  .site-header.is-scrolled::before {
    background-color: rgb(11 11 12 / 0.92);
    -webkit-backdrop-filter: saturate(1.4) blur(18px);
    backdrop-filter: saturate(1.4) blur(18px);
  }
  .site-header.is-open::before {
    background-color: var(--ink);
  }
  .site-header.is-hidden {
    transform: translateY(-100%);
  }
  .site-header__inner {
    height: 100%;
    display: flex;
    align-items: center;
    gap: var(--s-6);
  }
  .site-header__logo {
    display: flex;
    align-items: center;
    width: 132px;
    min-height: 44px;
    flex: none;
    color: var(--paper);
  }
  .site-header__logo > :global(img) {
    width: 100%;
  }
  .site-nav {
    margin-inline-start: auto;
  }
  .site-nav > ul {
    display: flex;
    gap: clamp(var(--s-4), 2.2vw, var(--s-6));
  }
  .site-nav__link {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    height: var(--header-h);
    font-size: 0.9375rem;
    font-weight: 500;
    white-space: nowrap;
    color: var(--muted-inv);
    transition: color var(--dur-1) var(--ease);
  }
  .site-nav__link:hover,
  .site-nav__link[aria-current='page'],
  .site-nav__link.is-current,
  .site-nav__link[aria-expanded='true'] {
    color: var(--paper);
  }
  .site-nav__link[aria-current='page']::after,
  .site-nav__link.is-current::after,
  .site-nav__link[aria-expanded='true']::after {
    content: '';
    position: absolute;
    inset-inline: 0;
    bottom: -1px;
    height: 1px;
    background: var(--paper);
  }
  .site-nav__link[aria-expanded='true']::after {
    background: var(--sun);
  }
  .site-nav__link:focus-visible {
    outline-offset: -2px;
  }
  .site-nav__link.is-accent::before {
    content: '';
    width: 6px;
    height: 6px;
    background: var(--sun);
  }
  .site-nav__chevron {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.4;
    transition: transform var(--dur-2) var(--ease);
  }
  [aria-expanded='true'] > .site-nav__chevron {
    transform: rotate(180deg);
  }
  .site-header__actions {
    display: flex;
    align-items: center;
    gap: var(--s-4);
  }
  .site-header__cta {
    min-height: 44px;
    padding: 0 var(--s-4);
    font-size: 0.875rem;
  }
  .site-header__toggle {
    display: none;
    width: 44px;
    height: 44px;
    margin-inline-end: -10px;
    color: var(--paper);
  }
  .site-header__burger {
    display: grid;
    gap: 7px;
    width: 24px;
    margin: auto;
  }
  .site-header__burger i {
    display: block;
    height: 1.5px;
    background: currentColor;
    transition: transform var(--dur-2) var(--ease);
  }
  [aria-expanded='true'] .site-header__burger i:first-child {
    transform: translateY(4.25px) rotate(45deg);
  }
  [aria-expanded='true'] .site-header__burger i:last-child {
    transform: translateY(-4.25px) rotate(-45deg);
  }

  .site-header__scrim {
    position: fixed;
    inset: var(--header-h) 0 0 0;
    z-index: -2;
    background: rgb(11 11 12 / 0.5);
    opacity: 0;
    visibility: hidden;
    transition:
      opacity var(--dur-2) var(--ease),
      visibility 0s linear var(--dur-2);
  }
  .site-header.is-mega .site-header__scrim {
    opacity: 1;
    visibility: visible;
    transition:
      opacity var(--dur-2) var(--ease),
      visibility 0s;
  }

  :global([dir='rtl']) .site-nav__link {
    font-size: 1rem;
  }

  @media (max-width: 1180px) {
    .site-header__inner {
      gap: var(--s-5);
    }
  }
  @media (max-width: 1080px) {
    .site-header__cta {
      display: none;
    }
  }
  @media (max-width: 900px) {
    .site-nav,
    .site-header__actions > :global(.lang) {
      display: none;
    }
    .site-header__actions {
      margin-inline-start: auto;
    }
    .site-header__toggle {
      display: grid;
      place-items: center;
    }
    .site-header__logo {
      width: 118px;
    }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const KEY = 'faraday-lang';
  const store = (value: string) => {
    try {
      localStorage.setItem(KEY, value);
    } catch {}
  };

  /** Language links anywhere on the page: remember the choice and keep the reader's place and choices (?model=). */
  document.addEventListener('click', (e) => {
    const link = (e.target as Element).closest<HTMLAnchorElement>('a[data-lang-link]');
    if (!link) return;
    store(link.dataset.langLink ?? '');
    link.search = location.search;
    link.hash = location.hash;
  });

  if (header) {
    const anyOpen = () => header.querySelector('[aria-expanded="true"]') !== null;
    const syncOpen = () => header.classList.toggle('is-open', anyOpen());
    const announceOpen = (source: string) => document.dispatchEvent(new CustomEvent('faraday:menu', { detail: source }));
    const focusables = (root: Element) =>
      [...root.querySelectorAll<HTMLElement>('a[href], button:not([disabled])')].filter((el) => el.getClientRects().length > 0);

    // ---------- scroll: fill after 24px, hide on the way down, show on the way up ----------
    let lastY = window.scrollY;
    const onScroll = () => {
      const y = window.scrollY;
      header.classList.toggle('is-scrolled', y > 24);
      const hide = y > lastY && y > 240 && !anyOpen() && !header.contains(document.activeElement);
      header.classList.toggle('is-hidden', hide);
      lastY = y;
    };
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });

    // ---------- products mega menu (desktop) ----------
    const megaItem = header.querySelector<HTMLElement>('[data-mega]');
    const megaTrigger = header.querySelector<HTMLButtonElement>('[data-mega-trigger]');
    const megaPanel = header.querySelector<HTMLElement>('[data-mega-panel]');
    if (megaItem && megaTrigger && megaPanel) {
      let openY = 0;
      let hoverOpenedAt = 0;
      let timer = 0;
      const prime = () => {
        if (!megaPanel.hidden) return;
        megaPanel.hidden = false;
        void megaPanel.offsetWidth;
      };
      const setMega = (open: boolean) => {
        clearTimeout(timer);
        if (open === (megaTrigger.getAttribute('aria-expanded') === 'true')) return;
        if (open) {
          prime();
          announceOpen('mega');
          openY = window.scrollY;
        }
        megaTrigger.setAttribute('aria-expanded', String(open));
        megaPanel.classList.toggle('is-open', open);
        header.classList.toggle('is-mega', open);
        syncOpen();
      };
      const isOpen = () => megaTrigger.getAttribute('aria-expanded') === 'true';

      megaTrigger.addEventListener('click', () => {
        if (isOpen() && performance.now() - hoverOpenedAt < 600) return;
        setMega(!isOpen());
      });
      megaTrigger.addEventListener('keydown', (e) => {
        if (e.key !== 'ArrowDown') return;
        e.preventDefault();
        setMega(true);
        focusables(megaPanel)[0]?.focus();
      });
      megaTrigger.addEventListener('focus', prime);

      const finePointer = matchMedia('(hover: hover) and (pointer: fine)');
      megaItem.addEventListener('pointerenter', (e) => {
        if (e.pointerType !== 'mouse' || !finePointer.matches) return;
        prime();
        clearTimeout(timer);
        if (isOpen()) return;
        timer = window.setTimeout(() => {
          setMega(true);
          hoverOpenedAt = performance.now();
        }, 140);
      });
      megaItem.addEventListener('pointerleave', (e) => {
        if (e.pointerType !== 'mouse' || !finePointer.matches) return;
        clearTimeout(timer);
        if (isOpen()) timer = window.setTimeout(() => setMega(false), 280);
      });
      megaItem.addEventListener('focusout', (e) => {
        const next = e.relatedTarget as Node | null;
        if (next && !megaItem.contains(next)) setMega(false);
      });
      document.addEventListener('pointerdown', (e) => {
        if (isOpen() && !megaItem.contains(e.target as Node)) setMega(false);
      });
      document.addEventListener('keydown', (e) => {
        if (e.key !== 'Escape' || !isOpen()) return;
        const inside = megaItem.contains(document.activeElement);
        setMega(false);
        if (inside) megaTrigger.focus();
      });
      document.addEventListener('faraday:menu', (e) => {
        if ((e as CustomEvent<string>).detail !== 'mega') setMega(false);
      });
      window.addEventListener('scroll', () => {
        if (isOpen() && window.scrollY > openY + 48) setMega(false);
      }, { passive: true });
    }

    // ---------- language menu (desktop) ----------
    const lang = header.querySelector<HTMLElement>('[data-lang]');
    const langTrigger = header.querySelector<HTMLButtonElement>('[data-lang-trigger]');
    const langPanel = header.querySelector<HTMLElement>('[data-lang-panel]');
    if (lang && langTrigger && langPanel) {
      const links = [...langPanel.querySelectorAll<HTMLAnchorElement>('a')];
      const isOpen = () => langTrigger.getAttribute('aria-expanded') === 'true';
      const setLang = (open: boolean) => {
        if (open === isOpen()) return;
        if (open) announceOpen('lang');
        langTrigger.setAttribute('aria-expanded', String(open));
        lang.classList.toggle('is-open', open);
        syncOpen();
      };
      langTrigger.addEventListener('click', () => setLang(!isOpen()));
      langTrigger.addEventListener('keydown', (e) => {
        if (e.key !== 'ArrowDown' && e.key !== 'ArrowUp') return;
        e.preventDefault();
        setLang(true);
        (e.key === 'ArrowDown' ? links[0] : links[links.length - 1])?.focus();
      });
      langPanel.addEventListener('keydown', (e) => {
        if (e.key !== 'ArrowDown' && e.key !== 'ArrowUp') return;
        e.preventDefault();
        const i = links.indexOf(document.activeElement as HTMLAnchorElement);
        const step = e.key === 'ArrowDown' ? 1 : -1;
        links[(i + step + links.length) % links.length]?.focus();
      });
      lang.addEventListener('focusout', (e) => {
        const next = e.relatedTarget as Node | null;
        if (next && !lang.contains(next)) setLang(false);
      });
      document.addEventListener('pointerdown', (e) => {
        if (isOpen() && !lang.contains(e.target as Node)) setLang(false);
      });
      document.addEventListener('keydown', (e) => {
        if (e.key !== 'Escape' || !isOpen()) return;
        setLang(false);
        langTrigger.focus();
      });
      document.addEventListener('faraday:menu', (e) => {
        if ((e as CustomEvent<string>).detail !== 'lang') setLang(false);
      });
    }

    // ---------- mobile menu ----------
    const toggle = header.querySelector<HTMLButtonElement>('[data-menu-toggle]');
    const menu = header.querySelector<HTMLElement>('[data-menu]');
    if (toggle && menu) {
      const label = toggle.querySelector('.sr-only')!;
      const behind = [document.querySelector('main'), document.querySelector('.site-footer'), document.querySelector('[data-lang-hint]')];
      const sub = menu.querySelector<HTMLButtonElement>('[data-sub-toggle]');
      const subPanel = sub && document.getElementById(sub.getAttribute('aria-controls') ?? '');
      const setSub = (open: boolean) => {
        if (!sub || !subPanel) return;
        sub.setAttribute('aria-expanded', String(open));
        subPanel.hidden = !open;
      };
      sub?.addEventListener('click', () => setSub(sub.getAttribute('aria-expanded') !== 'true'));

      const setMenu = (open: boolean) => {
        if (open) announceOpen('mobile');
        toggle.setAttribute('aria-expanded', String(open));
        label.textContent = (open ? toggle.dataset.labelClose : toggle.dataset.labelOpen) ?? '';
        menu.hidden = !open;
        behind.forEach((el) => el?.toggleAttribute('inert', open));
        document.documentElement.style.overflow = open ? 'hidden' : '';
        header.classList.remove('is-hidden');
        syncOpen();
        window.dispatchEvent(new CustomEvent(open ? 'faraday:lock-scroll' : 'faraday:unlock-scroll'));
        if (open) {
          menu.scrollTop = 0;
          void menu.offsetWidth;
          menu.classList.add('is-revealed');
          focusables(menu)[0]?.focus({ preventScroll: true });
        } else {
          menu.classList.remove('is-revealed');
          setSub(false);
        }
      };
      toggle.addEventListener('click', () => setMenu(menu.hidden));
      document.addEventListener('keydown', (e) => {
        if (menu.hidden) return;
        if (e.key === 'Escape') {
          setMenu(false);
          toggle.focus();
          return;
        }
        if (e.key !== 'Tab') return;
        const items = [toggle, ...focusables(menu)];
        const first = items[0];
        const last = items[items.length - 1];
        if (e.shiftKey && document.activeElement === first) {
          e.preventDefault();
          last.focus();
        } else if (!e.shiftKey && document.activeElement === last) {
          e.preventDefault();
          first.focus();
        }
      });
      matchMedia('(min-width: 901px)').addEventListener('change', (e) => {
        if (e.matches && !menu.hidden) setMenu(false);
      });
    }
  }
</script>
