---
/*
  CONTRACT (implemented by the 3D work package; pages may rely on it):
  Interactive orbit viewer of one module for product pages.
  Props: spec (ModuleSpec), class?, label? (accessible name), locale? (defaults to the URL's locale).
  Root element: <pv-module-viewer data-spec="{json ModuleSpec}">. Changing the data-spec
  attribute at runtime rebuilds the module (used by model pickers on product pages).
  Fills its parent width. The stage is 4/3 (1/1 under 720px, where the toolbar moves below it)
  on --paper-2 with a soft contact shadow, and draws its own controls (front / back / explode /
  dimensions / details / zoom / reset). Touch: vertical swipes scroll the page, horizontal drags turn the
  module, no pinch capture. Without JS or WebGL it shows a front elevation with model and size
  (height × width × depth, the datasheet order).
  Slot "poster" (optional): an element marked data-poster, laid over the stage (its containing block)
  while the 3D view loads; the viewer hides it when WebGL is missing, so the drawing and the note show.
  The 3D view starts once the page has loaded and settled, the stage is near the viewport and the main
  thread is idle, one scene at a time per page (src/lib/three/load.ts), and is built a slice at a time
  (src/lib/three/stage.ts: setUp, prepare). Without WebGL 2, three.js is never loaded.
  Details: five numbered hotspots ride on 3D points (front glass, cells, frame corner, junction box,
  rear label) and fade out when their face turns away. Click, tap or keyboard focus opens a card with
  the sourced anatomy caption and the model's data (power, protection class, label ratings); focusing
  a hotspot on the far side turns the module round. Esc closes. On by default, off on phones (≤720px).
*/
import type { Locale } from '../../i18n/config.ts';
import { localeFromPath } from '../../i18n/config.ts';
import { three } from '../../i18n/three.ts';
import { moduleSvg } from '../../lib/three/drawing.ts';
import { moduleFacts } from '../../lib/three/facts.ts';
import type { ModuleSpec } from '../../lib/three/types.ts';

interface Props {
  spec: ModuleSpec;
  class?: string;
  label?: string;
  locale?: Locale;
}
const { spec, class: className, locale = localeFromPath(Astro.url.pathname) } = Astro.props;
const t = three[locale].viewer;
const label = Astro.props.label ?? t.label(spec.model);
const layers = three[locale].anatomy.layers(moduleFacts(spec));
const spots = [
  ['glass', layers[0].name],
  ['cells', layers[2].name],
  ['frame', layers[5].name],
  ['junction', layers[6].name],
  ['label', t.plate.name],
] as const;
const uid = `mv-${spec.model.replace(/[^a-z0-9]/gi, '').toLowerCase()}`;
---

<pv-module-viewer class:list={['module-viewer', className]} data-spec={JSON.stringify(spec)} data-locale={locale} role="group" aria-label={label}>
  <div class="module-viewer__stage" data-stage>
    <div class="module-viewer__fallback" data-fallback set:html={moduleSvg(spec)} />
    <slot name="poster" />
    <div class="module-viewer__dims" data-dims hidden aria-hidden="true">
      <svg><path></path></svg>
      <span class="mono" data-dim="w"></span>
      <span class="mono" data-dim="h"></span>
      <span class="mono" data-dim="d"></span>
    </div>
    <p class="module-viewer__meta mono">
      <bdi data-model>{spec.model}</bdi>
      <span class="sr-only">{t.dimensions}</span>
      <span class="num" data-size>{spec.height} × {spec.width} × {spec.depth} mm</span>
    </p>
    <p class="module-viewer__hint small" data-hint hidden>{t.hint}</p>
    <div class="module-viewer__spots" data-spots role="group" aria-label={t.spots} hidden>
      {
        spots.map(([key, name], i) => (
          <button type="button" class="module-viewer__spot" data-spot={key} aria-expanded="false" aria-controls={`${uid}-card`} aria-label={t.spot(i + 1, name)}>
            <span aria-hidden="true">{i + 1}</span>
          </button>
        ))
      }
      <div class="module-viewer__card" id={`${uid}-card`} data-card hidden>
        <p class="module-viewer__card-title"><span class="mono" data-card-index></span><span data-card-title></span></p>
        <p class="module-viewer__card-body" data-card-body aria-live="polite"></p>
        <dl class="module-viewer__card-rows" data-card-rows></dl>
        <button type="button" class="module-viewer__card-close" data-card-close aria-label={t.close}><span aria-hidden="true">×</span></button>
      </div>
    </div>
  </div>
  <div class="module-viewer__bar" role="group" aria-label={t.controls} data-bar>
    <span class="module-viewer__seg">
      <button type="button" data-act="front">{t.front}</button>
      <button type="button" data-act="back">{t.back}</button>
    </span>
    <span class="module-viewer__seg">
      <button type="button" data-act="explode" aria-pressed="false">{t.explode}</button>
      <button type="button" data-act="dims" aria-pressed="false">{t.dimensions}</button>
      <button type="button" data-act="details" aria-pressed="false">{t.details}</button>
    </span>
    <span class="module-viewer__seg">
      <button type="button" data-act="out" aria-label={t.zoomOut}><span aria-hidden="true">−</span></button>
      <button type="button" data-act="in" aria-label={t.zoomIn}><span aria-hidden="true">+</span></button>
      <button type="button" data-act="reset">{t.reset}</button>
    </span>
  </div>
  <p class="module-viewer__note small" data-nowebgl hidden>{t.noWebgl}</p>
</pv-module-viewer>

<style>
  .module-viewer {
    position: relative;
    display: block;
    color: var(--ink);
    background: var(--paper-2);
    border-radius: var(--r-2);
    /* Clips without being a scroller: in RTL, a scroller's origin moves with its left overflow (hotspots near the
       start edge), which shifts everything inside it. */
    overflow: clip;
  }
  .module-viewer__stage {
    position: relative;
    aspect-ratio: 4 / 3;
    max-height: min(84svh, 860px);
    width: 100%;
  }
  .module-viewer__stage :global(canvas) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    cursor: grab;
    transition: opacity 600ms var(--ease);
  }
  .module-viewer__stage :global(canvas:active) {
    cursor: grabbing;
  }
  .module-viewer__stage :global(canvas:focus-visible) {
    outline-offset: -4px;
  }
  .module-viewer__fallback {
    position: absolute;
    inset: 14% 0 18%;
    display: grid;
    place-items: center;
    pointer-events: none;
    transition: opacity 400ms var(--ease);
  }
  .module-viewer__fallback :global(svg) {
    width: auto;
    height: 100%;
    max-width: 80%;
  }
  .module-viewer__stage:global(.is-ready) :global(canvas) {
    opacity: 1;
  }
  .module-viewer__stage:global(.is-ready) .module-viewer__fallback {
    opacity: 0;
  }

  .module-viewer__meta {
    position: absolute;
    inset-block-start: var(--s-4);
    inset-inline-start: var(--s-4);
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--s-3);
    font-size: 0.75rem;
    pointer-events: none;
  }
  .module-viewer__meta .num {
    color: var(--muted);
    letter-spacing: 0;
  }
  .module-viewer__hint {
    position: absolute;
    inset-block-start: var(--s-4);
    inset-inline-end: var(--s-4);
    font-size: 0.75rem;
    color: var(--muted);
    pointer-events: none;
  }

  .module-viewer__dims {
    position: absolute;
    inset: 0;
    direction: ltr;
    pointer-events: none;
  }
  .module-viewer__dims svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .module-viewer__dims path {
    fill: none;
    stroke: var(--ink);
    stroke-width: 1;
  }
  .module-viewer__dims span {
    position: absolute;
    inset-block-start: 0;
    inset-inline-start: 0;
    padding: 2px 6px;
    background: var(--paper-2);
    font-size: 0.75rem;
    white-space: nowrap;
  }

  .module-viewer__spots {
    position: absolute;
    inset: 0;
    direction: ltr;
    pointer-events: none;
  }
  /* The first 3D frame places the hotspots; until then they would sit stacked in the corner. */
  .module-viewer__stage:not(:global(.is-ready)) .module-viewer__spots {
    visibility: hidden;
  }
  .module-viewer__spot {
    position: absolute;
    inset-block-start: 0;
    inset-inline-start: 0;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    margin-block-start: -22px;
    margin-inline-start: -22px;
    padding: 0;
    border: 0;
    background: none;
    pointer-events: auto;
    transition: opacity var(--dur-2) var(--ease);
  }
  .module-viewer__spot > span {
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    border: 1px solid var(--ink);
    border-radius: 50%;
    background: var(--paper);
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    line-height: 1;
    transition:
      background-color var(--dur-1) var(--ease),
      color var(--dur-1) var(--ease),
      transform var(--dur-1) var(--ease);
  }
  .module-viewer__spot::after {
    content: '';
    position: absolute;
    inset: 9px;
    border: 1px solid var(--ink);
    border-radius: 50%;
    opacity: 0;
    pointer-events: none;
  }
  :global(html.motion) .module-viewer__spots:not(.is-touched) .module-viewer__spot::after {
    animation: spot-ping 2800ms var(--ease) infinite;
    animation-delay: calc(var(--i, 0) * 300ms);
  }
  @keyframes spot-ping {
    0% {
      opacity: 0.5;
      transform: scale(1);
    }
    70%,
    100% {
      opacity: 0;
      transform: scale(1.9);
    }
  }
  .module-viewer__spot:hover > span {
    background: var(--ink);
    color: var(--paper);
  }
  .module-viewer__spot[aria-expanded='true'] > span {
    background: var(--sun);
    border-color: var(--sun-ink);
    color: var(--sun-ink);
    transform: scale(1.08);
  }
  .module-viewer__spot.is-away {
    opacity: 0;
    pointer-events: none;
  }
  .module-viewer__spot.is-away:focus-visible {
    opacity: 1;
  }
  .module-viewer__card {
    position: absolute;
    inset-block-start: 0;
    inset-inline-start: 0;
    display: grid;
    gap: var(--s-2);
    width: min(18rem, calc(100% - 16px));
    padding: 14px 16px 16px;
    border-radius: var(--r-2);
    background: var(--ink);
    color: var(--paper);
    pointer-events: auto;
    transition: opacity var(--dur-2) var(--ease);
  }
  .module-viewer__card.is-away {
    opacity: 0;
    pointer-events: none;
  }
  .module-viewer__card-title {
    display: flex;
    gap: var(--s-2);
    align-items: baseline;
    padding-inline-end: 32px;
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1.3;
  }
  .module-viewer__card-title .mono {
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--sun);
  }
  .module-viewer__card-body {
    font-size: 0.8125rem;
    line-height: 1.5;
    color: rgb(255 255 255 / 0.8);
  }
  .module-viewer__card-rows {
    display: grid;
  }
  .module-viewer__card-rows:empty {
    display: none;
  }
  .module-viewer__card-rows :global(div) {
    display: flex;
    justify-content: space-between;
    gap: var(--s-3);
    padding-block: 6px;
    border-block-start: 1px solid var(--line-inv);
    font-size: 0.75rem;
  }
  .module-viewer__card-rows :global(dt) {
    color: var(--muted-inv);
  }
  .module-viewer__card-close {
    position: absolute;
    inset-block-start: 0;
    inset-inline-end: 0;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 0;
    background: none;
    color: var(--muted-inv);
    font-size: 1.25rem;
    line-height: 1;
  }
  .module-viewer__card-close:hover {
    color: var(--paper);
  }
  :global([dir='rtl']) .module-viewer__card-title {
    line-height: 1.5;
  }

  .module-viewer__bar {
    position: absolute;
    inset-block-end: var(--s-4);
    inset-inline: var(--s-4);
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--s-2);
  }
  /* Laid out from the start, so the framing counts it and, under the stage, its room is kept; shown with the first 3D frame. */
  .module-viewer__stage:not(:global(.is-ready)) + .module-viewer__bar {
    visibility: hidden;
  }
  :global(.no-js) .module-viewer__bar {
    display: none;
  }
  .module-viewer__seg {
    display: flex;
  }
  .module-viewer__seg button {
    min-width: 44px;
    min-height: 44px;
    padding: 0 var(--s-4);
    border: 1px solid var(--line-strong);
    background: var(--paper);
    font-size: 0.8125rem;
    font-weight: 500;
    line-height: 1;
    white-space: nowrap;
    transition:
      background-color var(--dur-1) var(--ease),
      color var(--dur-1) var(--ease),
      border-color var(--dur-1) var(--ease);
  }
  .module-viewer__seg button + button {
    margin-inline-start: -1px;
  }
  .module-viewer__seg button:first-child {
    border-start-start-radius: var(--r-1);
    border-end-start-radius: var(--r-1);
  }
  .module-viewer__seg button:last-child {
    border-start-end-radius: var(--r-1);
    border-end-end-radius: var(--r-1);
  }
  .module-viewer__seg button:hover {
    position: relative;
    border-color: var(--ink);
  }
  .module-viewer__seg button:focus-visible {
    position: relative;
    z-index: 1;
  }
  .module-viewer__seg button[aria-pressed='true'] {
    position: relative;
    background: var(--ink);
    border-color: var(--ink);
    color: var(--paper);
  }
  .module-viewer__seg [data-act='out'],
  .module-viewer__seg [data-act='in'] {
    padding: 0;
    font-size: 1.125rem;
    font-weight: 400;
  }
  .module-viewer__note {
    position: absolute;
    inset-block-end: var(--s-4);
    inset-inline: var(--s-4);
    color: var(--muted);
    text-align: center;
  }

  @media (max-width: 720px) {
    .module-viewer__stage {
      aspect-ratio: 1 / 1;
    }
    .module-viewer__bar {
      flex-wrap: nowrap;
      justify-content: flex-start;
      overflow-x: auto;
      scrollbar-width: none;
    }
    .module-viewer__seg {
      flex: none;
    }
    .module-viewer__bar {
      position: static;
      padding: 0 var(--s-3) var(--s-4);
    }
    .module-viewer__seg button {
      padding: 0 var(--s-3);
    }
    .module-viewer__hint {
      display: none;
    }
  }
</style>

<script>
  import type { Locale } from '../../i18n/config.ts';
  import type { ThreeStrings } from '../../i18n/three.ts';
  import { moduleSvg } from '../../lib/three/drawing.ts';
  import { moduleFacts } from '../../lib/three/facts.ts';
  import { loadScenes, sceneContext, startScene } from '../../lib/three/load.ts';
  import type { MarkKey } from '../../lib/three/module.ts';
  import type { ModuleSpec } from '../../lib/three/types.ts';
  import type { ModuleViewerScene } from '../../lib/three/viewer.ts';

  /** Card text for a hotspot: the sourced anatomy caption plus the model's own figures. */
  function spotContent(t: ThreeStrings, spec: ModuleSpec, key: MarkKey): { name: string; body: string; rows: [string, string][] } {
    const layers = t.anatomy.layers(moduleFacts(spec));
    const rows = t.viewer.rows;
    const r = spec.rating;
    switch (key) {
      case 'glass':
        return { ...layers[0], rows: [] };
      case 'cells':
        return { ...layers[2], rows: spec.power ? [[rows.power, `${spec.power} W`]] : [] };
      case 'frame':
        return { ...layers[5], rows: [] };
      case 'junction':
        return { ...layers[6], rows: spec.protection ? [[rows.protection, spec.protection]] : [] };
      case 'label': {
        const list: [string, string][] = r
          ? [
              [rows.vdcMax, `${r.vdcMax} V`],
              [rows.voc, `${r.voc} V`],
              [rows.isc, `${r.isc} A`],
            ]
          : [];
        if (r?.fuse) list.push([rows.fuse, `${r.fuse} A`]);
        return { ...t.viewer.plate, rows: list };
      }
    }
  }

  class PvModuleViewer extends HTMLElement {
    static observedAttributes = ['data-spec'];
    scene: ModuleViewerScene | null = null;
    strings: ThreeStrings | null = null;
    openedAt = 0;

    get spec() {
      return JSON.parse(this.dataset.spec ?? '{}') as ModuleSpec;
    }

    connectedCallback() {
      startScene(this, '400px', () => this.mount());
    }

    disconnectedCallback() {
      this.scene?.dispose();
      this.scene = null;
    }

    attributeChangedCallback(_name: string, previous: string | null, value: string | null) {
      if (!value || value === previous || !this.isConnected) return;
      const spec = this.spec;
      this.querySelector('[data-model]')!.textContent = spec.model;
      this.querySelector('[data-size]')!.textContent = `${spec.height} × ${spec.width} × ${spec.depth} mm`;
      this.querySelector('[data-fallback]')!.innerHTML = moduleSvg(spec);
      this.scene?.setSpec(spec);
      this.closeSpot(false);
      this.nameSpots();
    }

    spotButtons() {
      return [...this.querySelectorAll<HTMLButtonElement>('[data-spot]')];
    }

    nameSpots() {
      const t = this.strings;
      if (!t) return;
      this.spotButtons().forEach((b, i) => {
        b.style.setProperty('--i', String(i));
        b.setAttribute('aria-label', t.viewer.spot(i + 1, spotContent(t, this.spec, b.dataset.spot as MarkKey).name));
      });
    }

    openSpot(button: HTMLButtonElement) {
      const t = this.strings;
      const card = this.querySelector<HTMLElement>('[data-card]');
      if (!t || !card || !this.scene) return;
      const key = button.dataset.spot as MarkKey;
      const c = spotContent(t, this.spec, key);
      const index = this.spotButtons().indexOf(button) + 1;
      this.spotButtons().forEach((b) => b.setAttribute('aria-expanded', String(b === button)));
      card.dir = document.documentElement.dir || 'ltr';
      card.querySelector('[data-card-index]')!.textContent = String(index).padStart(2, '0');
      card.querySelector('[data-card-title]')!.textContent = c.name;
      card.querySelector('[data-card-body]')!.textContent = c.body;
      card.querySelector('[data-card-rows]')!.replaceChildren(
        ...c.rows.map(([label, value]) => {
          const row = document.createElement('div');
          const dt = document.createElement('dt');
          const dd = document.createElement('dd');
          dt.textContent = label;
          dd.className = 'num';
          dd.textContent = value;
          row.append(dt, dd);
          return row;
        }),
      );
      card.hidden = false;
      this.openedAt = performance.now();
      this.querySelector('[data-spots]')!.classList.add('is-touched');
      this.scene.reveal(key);
    }

    closeSpot(refocus: boolean) {
      const open = this.spotButtons().find((b) => b.getAttribute('aria-expanded') === 'true');
      const card = this.querySelector<HTMLElement>('[data-card]');
      this.spotButtons().forEach((b) => b.setAttribute('aria-expanded', 'false'));
      if (card) card.hidden = true;
      if (refocus) open?.focus();
      this.scene?.reveal();
    }

    async mount() {
      if (this.scene) return;
      const canvas = document.createElement('canvas');
      if (!sceneContext(canvas)) {
        this.querySelector<HTMLElement>('[data-nowebgl]')!.hidden = false;
        this.querySelectorAll<HTMLElement>('[data-poster]').forEach((el) => (el.hidden = true));
        return;
      }
      const [{ mountViewer }, { three }] = await Promise.all([loadScenes(), import('../../i18n/three.ts')]);
      this.strings = three[(this.dataset.locale as Locale) ?? 'en'];
      await document.fonts.ready;
      if (!this.isConnected) return;
      const stage = this.querySelector<HTMLElement>('[data-stage]')!;
      const bar = this.querySelector<HTMLElement>('[data-bar]')!;
      const meta = this.querySelector<HTMLElement>('.module-viewer__meta')!;
      canvas.setAttribute('role', 'img');
      canvas.setAttribute('aria-label', this.getAttribute('aria-label') ?? '');
      stage.prepend(canvas);
      const overlaid = () => getComputedStyle(bar).position === 'absolute';
      const requested = this.dataset.spec;
      const scene = await mountViewer(
        {
          stage,
          canvas,
          dims: this.querySelector<HTMLElement>('[data-dims]')!,
          insets: () => ({ top: meta.offsetHeight + 24, bottom: overlaid() ? bar.offsetHeight + 28 : 16 }),
          spots: this.querySelector<HTMLElement>('[data-spots]')!,
        },
        this.spec,
      );
      if (!this.isConnected) return scene.dispose();
      this.scene = scene;
      canvas.tabIndex = 0;
      if (this.dataset.spec !== requested) void scene.setSpec(this.spec);
      this.querySelector<HTMLElement>('[data-hint]')!.hidden = false;
      bar.addEventListener('click', (e) => {
        const button = (e.target as Element).closest<HTMLButtonElement>('button[data-act]');
        if (button) this.act(button);
      });

      const spots = this.querySelector<HTMLElement>('[data-spots]')!;
      const details = this.querySelector<HTMLButtonElement>('[data-act="details"]')!;
      const on = !matchMedia('(max-width: 720px)').matches;
      details.setAttribute('aria-pressed', String(on));
      this.scene.setSpots(on);
      this.nameSpots();
      spots.addEventListener('click', (e) => {
        const target = e.target as Element;
        if (target.closest('[data-card-close]')) return this.closeSpot(true);
        const button = target.closest<HTMLButtonElement>('[data-spot]');
        if (!button) return;
        const open = button.getAttribute('aria-expanded') === 'true';
        if (open && performance.now() - this.openedAt > 350) this.closeSpot(false);
        else if (!open) this.openSpot(button);
      });
      spots.addEventListener('focusin', (e) => {
        const button = (e.target as Element).closest<HTMLButtonElement>('[data-spot]');
        if (button && button.matches(':focus-visible') && button.getAttribute('aria-expanded') !== 'true') this.openSpot(button);
      });
      spots.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') this.closeSpot(true);
      });
      canvas.addEventListener('pointerdown', () => this.closeSpot(false));
    }

    act(button: HTMLButtonElement) {
      const scene = this.scene;
      if (!scene) return;
      const toggle = () => {
        const on = button.getAttribute('aria-pressed') !== 'true';
        button.setAttribute('aria-pressed', String(on));
        return on;
      };
      switch (button.dataset.act) {
        case 'front':
          scene.front();
          break;
        case 'back':
          scene.back();
          break;
        case 'explode':
          scene.setExplode(toggle());
          break;
        case 'dims':
          scene.setDims(toggle());
          break;
        case 'details': {
          const on = toggle();
          if (!on) this.closeSpot(false);
          scene.setSpots(on);
          break;
        }
        case 'in':
          scene.zoom(0.8);
          break;
        case 'out':
          scene.zoom(1.25);
          break;
        case 'reset':
          this.querySelectorAll('[aria-pressed]:not([data-act="details"])').forEach((b) => b.setAttribute('aria-pressed', 'false'));
          this.closeSpot(false);
          scene.setDims(false);
          scene.reset();
          break;
      }
    }
  }

  if (!customElements.get('pv-module-viewer')) customElements.define('pv-module-viewer', PvModuleViewer);
</script>
