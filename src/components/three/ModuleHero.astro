---
/*
  CONTRACT (implemented by the 3D work package; pages may rely on it):
  Decorative 3D module scene for the home hero. Absolutely fills its positioned parent
  (position: absolute; inset: 0) and sits behind hero text: pointer-events none, the ≤3° pointer
  parallax listens on the window (mouse only). Transparent canvas over --ink.
  Props: spec (ModuleSpec), class?, locale? (defaults to the URL's locale).
  The canvas is aria-hidden; never blocks LCP: three.js loads after the load event when the browser
  is idle, then the canvas fades in over 800 ms. Reduced motion: static pose.
  Light: the key light follows the real sun over Sulaymaniyah (src/lib/three/sun.ts, NOAA equations)
  for the current time; below the horizon it turns into a cool, dim moonlight and the glass sweep slows.
  Sun chip (from 721px, once the scene is up): sits in the stage's top end corner, aligned with the
  container's end edge, and shows the time and sun elevation over today's sun path; the module's
  top edge is framed below it. Its range input
  scrubs the day from just before sunrise to just after sunset; on release it eases back to live
  time after 4 s. It is the only part that takes pointer events.
  Framing (src/lib/three/hero.ts): the module's top edge always clears the header by about 8.5%
  of the box (28–88px) and its near top corner sits just inside the end edge; the lower part runs
  past the end edge and behind the spec strip (or the tablet/phone fade). Width is capped so it stays
  out of the start-side text block. RTL mirrors this, light and reflections included. Phones (≤720px): 90% opacity at the top, fading out where the text begins.
  Scroll: as the hero scrolls away (ScrollTrigger, smoothed in the scene) the module turns toward
  face-on, recedes and lifts slightly, at half strength on phones; reduced motion keeps the static pose.
*/
import type { Locale } from '../../i18n/config.ts';
import { localeFromPath } from '../../i18n/config.ts';
import { three } from '../../i18n/three.ts';
import type { ModuleSpec } from '../../lib/three/types.ts';

interface Props {
  spec: ModuleSpec;
  class?: string;
  locale?: Locale;
}
const { spec, class: className, locale = localeFromPath(Astro.url.pathname) } = Astro.props;
const t = three[locale].sun;
---

<div class:list={['module-hero', className]} data-module-hero data-spec={JSON.stringify(spec)}>
  <canvas class="module-hero__canvas" aria-hidden="true"></canvas>
  <div
    class="sun"
    data-sun
    role="group"
    aria-label={t.group}
    data-value={t.value('%t', 12345)}
    data-value-night={t.value('%t', null)}
    data-night={t.night}
    hidden
  >
    <p class="sun__head">
      <span class="sun__title">{t.title}</span>
      <span class="sun__live" data-sun-live>{t.live}</span>
    </p>
    <p class="sun__read" aria-hidden="true">
      <span class="num" data-sun-time>00:00</span>
      <span class="sun__sep">·</span>
      <span class="num" data-sun-elev>0°</span>
    </p>
    <div class="sun__dial">
      <svg viewBox="0 0 216 40" aria-hidden="true">
        <defs>
          <clipPath id="sun-above"><rect width="216" height="30"></rect></clipPath>
        </defs>
        <path class="sun__arc sun__arc--below" data-sun-arc></path>
        <path class="sun__arc" data-sun-arc clip-path="url(#sun-above)"></path>
        <path class="sun__horizon" d="M0 30.5H216"></path>
        <circle class="sun__dot" data-sun-dot r="4.5" cx="108" cy="30"></circle>
      </svg>
      <input class="sun__range" type="range" data-sun-range aria-label={t.scrub} min="0" max="1440" step="10" value="720" />
    </div>
    <p class="sun__hint">{t.hint}</p>
  </div>
</div>

<style>
  .module-hero {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
  }
  .module-hero__canvas {
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 800ms var(--ease);
  }
  .module-hero.is-ready .module-hero__canvas {
    opacity: 1;
  }

  .sun {
    position: absolute;
    inset-block-start: clamp(16px, 3svh, 28px);
    inset-inline-end: calc(max(0px, (100vw - var(--container)) / 2) + var(--gutter));
    z-index: 3;
    display: grid;
    gap: 4px;
    width: 244px;
    padding: 10px 14px 6px;
    border: 1px solid var(--line-inv);
    border-radius: var(--r-2);
    background: rgb(21 21 23 / 0.82);
    color: var(--paper);
    pointer-events: auto;
    opacity: 0;
    transform: translateY(-6px);
    transition:
      opacity 700ms var(--ease) 300ms,
      transform 700ms var(--ease-out-expo) 300ms;
  }
  .module-hero.is-ready .sun {
    opacity: 1;
    transform: none;
  }
  .sun__head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--s-3);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted-inv);
  }
  .sun__live {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--paper);
    transition: opacity var(--dur-2) var(--ease);
  }
  .sun__live::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--sun);
  }
  .sun.is-scrubbing .sun__live {
    opacity: 0;
  }
  .sun__read {
    display: flex;
    align-items: baseline;
    gap: var(--s-2);
    font-size: 1.125rem;
    line-height: 1.15;
    letter-spacing: -0.01em;
  }
  .sun__sep {
    color: var(--muted-inv);
  }
  .sun__dial {
    position: relative;
    width: 216px;
    height: 40px;
  }
  .sun__dial svg {
    display: block;
    width: 216px;
    height: 40px;
    overflow: visible;
  }
  .sun__arc {
    fill: none;
    stroke: rgb(255 255 255 / 0.55);
    stroke-width: 1.25;
  }
  .sun__arc--below {
    stroke: rgb(255 255 255 / 0.2);
    stroke-dasharray: 2 3;
  }
  .sun__horizon {
    stroke: var(--line-inv-strong);
    stroke-width: 1;
  }
  .sun__dot {
    fill: var(--sun);
    stroke: var(--ink);
    stroke-width: 2;
  }
  .sun.is-night .sun__dot {
    fill: var(--ink-2);
    stroke: #c9d3ff;
    stroke-width: 1.5;
  }
  .sun__hint {
    display: none;
    margin: 6px 0 0;
    font-size: 0.6875rem;
    color: var(--muted-inv);
  }
  .sun.is-night:not(.is-scrubbing) .sun__hint {
    display: block;
  }
  .sun__range {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    appearance: none;
    background: transparent;
    cursor: ew-resize;
  }
  .sun__range::-webkit-slider-runnable-track {
    height: 40px;
    background: transparent;
  }
  .sun__range::-webkit-slider-thumb {
    appearance: none;
    width: 16px;
    height: 40px;
    background: transparent;
  }
  .sun__range::-moz-range-track {
    height: 40px;
    background: transparent;
  }
  .sun__range::-moz-range-thumb {
    width: 16px;
    height: 40px;
    border: 0;
    background: transparent;
  }
  .sun__range:focus-visible {
    outline-offset: 2px;
  }
  :global([dir='rtl']) .sun__head {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    letter-spacing: 0;
    text-transform: none;
  }

  @media (max-width: 720px) {
    .module-hero__canvas {
      mask-image: linear-gradient(to bottom, #000 26%, rgb(0 0 0 / 0.35) 44%, transparent 62%);
    }
    .module-hero.is-ready .module-hero__canvas {
      opacity: 0.9;
    }
    .sun {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .sun {
      transform: none;
      transition: opacity 300ms var(--ease);
    }
  }
</style>

<script>
  import { ScrollTrigger, reduceMotion } from '../../lib/motion/init.ts';
  import { loadScenes, sceneContext, startScene } from '../../lib/three/load.ts';
  import { clock, localMidnight, localMinutes, sunPosition, sunTimes } from '../../lib/three/sun.ts';
  import type { SunPosition } from '../../lib/three/sun.ts';
  import type { ModuleSpec } from '../../lib/three/types.ts';

  const W = 216;
  const PAD = 8;
  const HORIZON = 30;
  /** Range reaches this far (minutes) past sunrise and sunset, into twilight. */
  const TWILIGHT = 50;

  /** The chip: readout, today's sun path and the scrubber. Calls `light` with every sun position it shows. */
  function sunChip(el: HTMLElement, light: (p: SunPosition) => void) {
    const rtl = getComputedStyle(el).direction === 'rtl';
    const range = el.querySelector<HTMLInputElement>('[data-sun-range]')!;
    const time = el.querySelector<HTMLElement>('[data-sun-time]')!;
    const elev = el.querySelector<HTMLElement>('[data-sun-elev]')!;
    const dot = el.querySelector<SVGCircleElement>('[data-sun-dot]')!;
    const arcs = [...el.querySelectorAll<SVGPathElement>('[data-sun-arc]')];
    const valueDay = el.dataset.value ?? '';
    const valueNight = el.dataset.valueNight ?? '';
    const nightWord = el.dataset.night ?? '';

    let day = 0;
    let min = 0;
    let max = 1440;
    let scale = 1;
    let shown = 0;
    let live = true;
    let back = 0;
    let glide = 0;

    const x = (minutes: number) => {
      const k = Math.min(1, Math.max(0, (minutes - min) / (max - min)));
      const v = PAD + (W - 2 * PAD) * k;
      return rtl ? W - v : v;
    };
    const y = (e: number) => Math.min(39, Math.max(3, HORIZON - e * scale));

    const plan = (now: number) => {
      day = localMidnight(now);
      const times = sunTimes(now);
      min = Math.floor((times.sunrise - TWILIGHT) / 10) * 10;
      max = Math.ceil((times.sunset + TWILIGHT) / 10) * 10;
      scale = (HORIZON - 5) / Math.max(20, sunPosition(day + times.noon * 60000).elevation);
      range.min = String(min);
      range.max = String(max);
      let d = '';
      for (let i = 0; i <= 60; i++) {
        const m = min + ((max - min) * i) / 60;
        d += `${i ? 'L' : 'M'}${x(m).toFixed(1)} ${y(sunPosition(day + m * 60000).elevation).toFixed(1)}`;
      }
      arcs.forEach((a) => a.setAttribute('d', d));
    };

    const show = (minutes: number, moveRange = true) => {
      shown = minutes;
      const p = sunPosition(day + minutes * 60000);
      const up = p.elevation >= 0;
      const deg = Math.round(p.elevation);
      const at = Math.min(max, Math.max(min, minutes));
      time.textContent = clock(minutes);
      elev.textContent = up ? `${deg}°` : nightWord;
      elev.classList.toggle('num', up);
      el.classList.toggle('is-night', !up);
      dot.setAttribute('cx', x(at).toFixed(1));
      dot.setAttribute('cy', y(sunPosition(day + at * 60000).elevation).toFixed(1));
      if (moveRange) range.value = String(at);
      range.setAttribute(
        'aria-valuetext',
        (up ? valueDay.replace('12345', String(deg)) : valueNight).replace('%t', clock(minutes)),
      );
      light(p);
    };

    const goLive = () => {
      const now = Date.now();
      if (localMidnight(now) !== day) plan(now);
      show(localMinutes(now));
    };

    const returnLater = () => {
      clearTimeout(back);
      back = window.setTimeout(() => {
        const from = shown;
        const to = localMinutes(Date.now());
        const start = performance.now();
        const dur = reduceMotion ? 0 : 1400;
        const stepTo = (now: number) => {
          const k = dur ? Math.min(1, (now - start) / dur) : 1;
          const e = k < 0.5 ? 4 * k * k * k : 1 - Math.pow(-2 * k + 2, 3) / 2;
          show(from + (to - from) * e);
          if (k < 1) glide = requestAnimationFrame(stepTo);
          else {
            live = true;
            el.classList.remove('is-scrubbing');
            goLive();
          }
        };
        glide = requestAnimationFrame(stepTo);
      }, 4000);
    };

    range.addEventListener('input', () => {
      live = false;
      cancelAnimationFrame(glide);
      clearTimeout(back);
      el.classList.add('is-scrubbing');
      show(Number(range.value), false);
    });
    for (const type of ['change', 'pointerup', 'blur']) range.addEventListener(type, () => !live && returnLater());

    plan(Date.now());
    goLive();
    setInterval(() => live && goLive(), 30000);
  }

  document.querySelectorAll<HTMLElement>('[data-module-hero]').forEach((host) => {
    const spec = JSON.parse(host.dataset.spec ?? '{}') as ModuleSpec;
    startScene(host, '0px', async () => {
      if (!sceneContext(host.querySelector('canvas')!)) return;
      const { mountHero } = await loadScenes();
      await document.fonts.ready;
      const scene = await mountHero(host, spec, sunPosition(Date.now()));
      // As the hero scrolls away the module turns toward face-on, recedes and lifts (smoothed in the scene).
      const away = reduceMotion
        ? null
        : ScrollTrigger.create({
            trigger: host,
            start: 0,
            end: 'bottom top',
            onUpdate: (self) => scene.setScroll(self.progress),
          });
      scene.setScroll(away?.progress ?? 0);
      const chip = host.querySelector<HTMLElement>('[data-sun]');
      if (chip) {
        chip.hidden = false;
        sunChip(chip, (p) => scene.setSun(p));
      }
    });
  });
</script>
