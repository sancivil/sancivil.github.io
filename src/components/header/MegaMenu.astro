---
import { common } from '../../i18n/common.ts';
import { localizePath, type Locale } from '../../i18n/config.ts';
import { menuCategories, designerLibrary } from './menu.ts';

interface Props {
  locale: Locale;
  basePath: string;
}

const { locale, basePath } = Astro.props;
const t = common[locale];
const href = (p: string) => localizePath(p, locale);
const STRING_CELLS = 24;
---

<div id="mega-products" class="mega theme-dark" data-mega-panel hidden>
  <div class="container mega__inner">
    <div class="mega__main">
      <p class="eyebrow eyebrow--dot">{t.footer.eyebrow}</p>
      <ul class="mega__grid" role="list">
        {
          menuCategories.map((c, i) => (
            <li style={`--i: ${i}`}>
              <a
                class="mega-tile"
                href={href(c.href)}
                aria-current={basePath.startsWith(c.href) ? 'page' : undefined}
              >
                <span class="mega-tile__well">
                  <img
                    src={c.image.src}
                    width={c.image.width}
                    height={c.image.height}
                    alt=""
                    loading="lazy"
                    decoding="async"
                  />
                </span>
                <span class="mega-tile__name">{t.productNav[c.key]}</span>
                <span class="mega-tile__line">{t.menu.lines[c.key]}</span>
                <span class="mega-tile__meta">
                  <span>{t.menu.count[c.count.key](c.count.n)}</span>
                  {c.range && <span class="num">{c.range}</span>}
                </span>
              </a>
            </li>
          ))
        }
      </ul>
      <div class="mega__foot">
        <a class="link-arrow" href={href('/products/')}>{t.menu.allProducts}</a>
        <ul role="list" class="mega__more">
          <li><a href={href('/solar/')}>{t.footer.solar}</a></li>
          <li><a href={href('/faq/')}>{t.footer.faq}</a></li>
        </ul>
      </div>
    </div>

    <a class="mega-designer" href={href('/designer/')}>
      <span class="eyebrow eyebrow--dot">{t.menu.designer.eyebrow}</span>
      <span class="mega-designer__grid" aria-hidden="true">
        {Array.from({ length: STRING_CELLS }, (_, i) => <i style={`--d: ${i % 8}`} />)}
      </span>
      <span class="mega-designer__title">{t.menu.designer.title}</span>
      <span class="mega-designer__meta">{t.menu.designer.library(designerLibrary.modules, designerLibrary.inverters)}</span>
      <span class="link-arrow">{t.footer.openDesigner}</span>
    </a>
  </div>
</div>

<style>
  .mega {
    position: absolute;
    inset-inline: 0;
    top: 100%;
    border-bottom: 1px solid var(--line-inv);
    visibility: hidden;
    opacity: 0;
    clip-path: inset(0 0 100% 0);
    transition:
      clip-path var(--dur-2) var(--ease-out-expo),
      opacity 180ms var(--ease),
      visibility 0s linear var(--dur-2);
  }
  .mega.is-open {
    visibility: visible;
    opacity: 1;
    clip-path: inset(0 0 0 0);
    transition:
      clip-path 260ms var(--ease-out-expo),
      opacity 180ms var(--ease),
      visibility 0s;
  }
  .mega__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(250px, 300px);
    gap: var(--s-6);
    padding-block: var(--s-6);
  }
  .mega__main {
    display: grid;
    gap: var(--s-5);
    min-width: 0;
  }
  .mega__grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    margin-inline: calc(-1 * var(--s-3));
  }
  .mega__grid li {
    padding-inline: var(--s-3);
  }
  .mega__grid li + li {
    border-inline-start: 1px solid var(--line-inv);
  }
  .mega-tile {
    display: grid;
    align-content: start;
    gap: var(--s-2);
    height: 100%;
  }
  .mega-tile__well {
    display: grid;
    place-items: center;
    aspect-ratio: 4 / 3;
    margin-bottom: var(--s-2);
    padding: var(--s-3);
    background: var(--paper-2);
    border-radius: var(--r-2);
    overflow: hidden;
    transition: background-color var(--dur-2) var(--ease);
  }
  .mega-tile__well img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: transform var(--dur-3) var(--ease-out-expo);
  }
  .mega-tile__name {
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }
  .mega-tile__line {
    font-size: 0.8125rem;
    line-height: 1.45;
    color: var(--muted-inv);
    text-wrap: pretty;
  }
  .mega-tile__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 2px var(--s-2);
    margin-top: var(--s-1);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--paper);
  }
  .mega-tile__meta > :first-child {
    color: var(--muted-inv);
  }
  .mega-tile:hover .mega-tile__well,
  .mega-tile:focus-visible .mega-tile__well {
    background: var(--paper);
  }
  .mega-tile:hover img,
  .mega-tile:focus-visible img {
    transform: translateY(-4px);
  }
  .mega-tile[aria-current='page'] .mega-tile__name {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
  }
  .mega-tile:focus-visible {
    outline-offset: 4px;
  }

  .mega__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-2) var(--s-6);
    padding-top: var(--s-3);
    border-top: 1px solid var(--line-inv);
  }
  .mega__foot .link-arrow {
    font-size: 0.9375rem;
  }
  .mega__more {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-5);
  }
  .mega__more a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: 0.875rem;
    color: var(--muted-inv);
    transition: color var(--dur-1) var(--ease);
  }
  .mega__more a:hover {
    color: var(--paper);
  }

  .mega-designer {
    display: grid;
    align-content: start;
    gap: var(--s-4);
    padding: var(--s-5);
    background: var(--ink-2);
    border: 1px solid var(--line-inv);
    border-radius: var(--r-2);
    transition: border-color var(--dur-2) var(--ease);
  }
  .mega-designer:hover {
    border-color: var(--line-inv-strong);
  }
  .mega-designer__grid {
    display: grid;
    grid-template-columns: repeat(8, minmax(0, 1fr));
    gap: 4px;
    padding-block: var(--s-2);
    direction: ltr;
  }
  .mega-designer__grid i {
    aspect-ratio: 5 / 8;
    border: 1px solid var(--line-inv-strong);
    border-radius: 1px;
    transition:
      background-color var(--dur-2) var(--ease),
      border-color var(--dur-2) var(--ease);
  }
  .mega.is-open .mega-designer__grid i:nth-child(n + 9):nth-child(-n + 16) {
    border-color: var(--sun);
    background: rgb(255 204 0 / 0.16);
    transition-delay: calc(120ms + var(--d) * 45ms);
  }
  .mega-designer__title {
    font-size: 1.25rem;
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: -0.015em;
    text-wrap: balance;
  }
  .mega-designer__meta {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--muted-inv);
  }
  .mega-designer .link-arrow {
    min-height: 0;
    font-size: 0.9375rem;
  }
  .mega-designer:hover .link-arrow::after {
    transform: translateX(6px);
  }
  :global([dir='rtl']) .mega-designer:hover .link-arrow::after {
    transform: translateX(-6px);
  }

  :global(html.motion) .mega__grid li {
    opacity: 0;
    transform: translateY(10px);
    transition:
      opacity var(--dur-2) var(--ease),
      transform var(--dur-3) var(--ease-out-expo);
  }
  :global(html.motion) .mega.is-open .mega__grid li {
    opacity: 1;
    transform: none;
    transition-delay: calc(40ms + var(--i) * 35ms);
  }

  :global([dir='rtl']) .mega-tile__name,
  :global([dir='rtl']) .mega-designer__title {
    letter-spacing: 0;
    line-height: 1.5;
  }
  :global([dir='rtl']) .mega-designer__title {
    font-weight: 500;
  }
  :global([dir='rtl']) .mega-tile__line {
    line-height: 1.7;
  }
  :global([dir='rtl']) .mega-tile__meta > :first-child,
  :global([dir='rtl']) .mega-designer__meta {
    font-family: var(--font-sans);
    font-size: 0.75rem;
  }

  @media (max-width: 1279px) {
    .mega__inner {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--s-5);
    }
    .mega-designer {
      grid-template-columns: minmax(0, 200px) minmax(0, 1fr) auto;
      grid-template-areas:
        'grid eyebrow cta'
        'grid title cta'
        'grid meta cta';
      align-items: center;
      gap: var(--s-1) var(--s-5);
      padding: var(--s-4) var(--s-5);
    }
    .mega-designer .eyebrow {
      grid-area: eyebrow;
    }
    .mega-designer__grid {
      grid-area: grid;
      padding: 0;
    }
    .mega-designer__title {
      grid-area: title;
      font-size: 1.0625rem;
    }
    .mega-designer__meta {
      grid-area: meta;
    }
    .mega-designer .link-arrow {
      grid-area: cta;
    }
  }
</style>
