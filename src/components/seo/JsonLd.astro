---
import { jsonLdText, type JsonLdNode } from '../../lib/seo/schema.ts';

interface Props {
  /** One node, or several: each becomes its own script block. */
  data: JsonLdNode | JsonLdNode[];
}
const { data } = Astro.props;
const nodes = Array.isArray(data) ? data : [data];
---

{nodes.map((node) => <script type="application/ld+json" set:html={jsonLdText(node)} />)}
