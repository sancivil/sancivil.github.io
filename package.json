{
  "name": "faraday-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Faraday Co. — exclusive Peimar agent in Iraq. Static website with 3D module viewer and PV string designer.",
  "scripts": {
    "predev": "npm run content:import",
    "dev": "astro dev --host 127.0.0.1",
    "prebuild": "npm run content:import",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1",
    "precheck": "npm run content:import",
    "check": "astro check",
    "pretest": "npm run content:import",
    "test": "node --test \"tests/*.test.ts\"",
    "content:import": "node scripts/content/import.ts",
    "content:pull": "node scripts/content/pull.ts",
    "check:dist": "node scripts/content/check-dist.ts dist",
    "diff:dist": "node scripts/content/diff-dist.ts"
  },
  "dependencies": {
    "@astrojs/preact": "6.1.2",
    "@astrojs/sitemap": "3.7.4",
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource-variable/noto-kufi-arabic": "5.3.0",
    "@fontsource-variable/noto-sans-arabic": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@preact/signals": "2.11.4",
    "astro": "7.4.7",
    "gsap": "3.15.1",
    "lenis": "1.3.27",
    "preact": "10.29.1",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@types/three": "0.187.0",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.23.4"
  }
}
